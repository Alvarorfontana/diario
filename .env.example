# Variables de entorno (en Vercel: Settings > Environment Variables > Production)

# Contraseña para entrar a /admin
ADMIN_PASSWORD=

# Token de GitHub (permiso "Contents: Read and write" sobre el repo del diario).
# Lo usa el panel para guardar notas y fotos en el repo.
GITHUB_PAT=

# Opcionales (por defecto: Alvarorfontana/diario y main)
# GITHUB_REPO=Alvarorfontana/diario
# GITHUB_BRANCH=main

# ── Newsletter (Brevo) ──────────────────────────────────────────────────────
# API key de Brevo (Settings > SMTP & API > API Keys).
BREVO_API_KEY=
# Id numérico de la lista de suscriptores (Contacts > Lists).
BREVO_LIST_ID=
# Id de la plantilla de doble confirmación (Contacts > Templates). Recomendada.
BREVO_DOI_TEMPLATE_ID=
# A dónde va el lector al confirmar (por defecto /newsletter/confirmado/).
# BREVO_REDIRECT_URL=https://www.diariofederal.com.ar/newsletter/confirmado/
# Remitente verificado en Brevo (opcional).
# BREVO_SENDER_EMAIL=boletin@diariofederal.com.ar
# BREVO_SENDER_NAME=Diario Federal
