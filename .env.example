# Variables de entorno (en Vercel: Settings > Environment Variables > Production)

# Contraseña para entrar a /admin
ADMIN_PASSWORD=

# Token de GitHub (permiso "Contents: Read and write" sobre el repo del diario).
# Lo usa el panel para guardar notas y fotos en el repo.
GITHUB_PAT=

# Opcionales (por defecto: Alvarorfontana/diario y main)
# GITHUB_REPO=Alvarorfontana/diario
# GITHUB_BRANCH=main

# ── Newsletter (Brevo) ──────────────────────────────────────────────────────
# API key de Brevo (Settings > SMTP & API > API Keys).
BREVO_API_KEY=
# Id numérico de la lista de suscriptores (Contacts > Lists).
BREVO_LIST_ID=
# Id de la plantilla de doble confirmación (Contacts > Templates). Recomendada.
BREVO_DOI_TEMPLATE_ID=
# A dónde va el lector al confirmar (por defecto /newsletter/confirmado/).
# BREVO_REDIRECT_URL=https://www.diariofederal.com.ar/newsletter/confirmado/
# Remitente verificado en Brevo (opcional).
# BREVO_SENDER_EMAIL=boletin@diariofederal.com.ar
# BREVO_SENDER_NAME=Diario Federal

# Boletines temáticos (opcionales). Una lista de Brevo por boletín; los que tengan id
# aparecen como opción en el formulario de suscripción.
# BREVO_LIST_MESA_POLITICA=
# BREVO_LIST_PULSO_FEDERAL=
# BREVO_LIST_AGENDA_ECONOMICA=

# ── Lo más leído (Upstash Redis, gratis desde Vercel > Storage) ──────────────
# Vercel las carga solas al conectar la base. Sin ellas, la portada muestra "Lo último".
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ── Comentarios: aviso por mail (Resend, gratis hasta 3.000 mails por mes) ──
# Creá la cuenta en resend.com con el mismo mail donde querés recibir los avisos,
# y pegá acá la API key. Sin esto, los comentarios se revisan desde /admin/comentarios.
# RESEND_API_KEY=
# A dónde llega el aviso (por defecto alvarorfontana@gmail.com).
# NOTIFY_EMAIL=
# Remitente: solo hace falta si verificás el dominio del diario en Resend.
# RESEND_FROM=Diario Federal <avisos@diariofederal.com.ar>
