---
// Barra de compartir compacta, con íconos redondos (estilo Axios).
// Mantiene WhatsApp, X, Facebook y copiar enlace; suma mail. El botón de imprimir
// y el de escuchar se pasan como "slot" para que queden en la misma fila.
interface Props {
	url: string;
	title: string;
}
const { url, title } = Astro.props;
const texto = encodeURIComponent(title);
const enlace = encodeURIComponent(url);
const boton = 'icono-compartir flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-ink transition-colors hover:bg-neutral-100 hover:text-brand';
---

<div class="flex flex-wrap items-center gap-2">
	<slot name="antes" />
	<div class="flex items-center gap-0.5 rounded-full bg-white px-1.5 py-1 shadow-[inset_0_0_0_1px_#e2e2dc]" role="group" aria-label="Compartir la nota">
		<a href={`https://wa.me/?text=${texto}%20${enlace}`} target="_blank" rel="noopener" class={boton} aria-label="Compartir por WhatsApp" title="WhatsApp">
			<svg viewBox="0 0 24 24" class="h-[18px] w-[18px] fill-current" aria-hidden="true"><path d="M17.5 14.4c-.3-.2-1.8-.9-2-1s-.5-.1-.7.1-.8 1-.9 1.2-.3.2-.6.1a8.2 8.2 0 0 1-4-3.5c-.3-.5.3-.5.9-1.6.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6a1.2 1.2 0 0 0-.8.4 3.5 3.5 0 0 0-1.1 2.6 6 6 0 0 0 1.3 3.2 13.8 13.8 0 0 0 5.3 4.7c2 .8 2.7.9 3.7.8a3.1 3.1 0 0 0 2-1.4 2.5 2.5 0 0 0 .2-1.4c-.1-.2-.3-.3-.6-.4ZM12 21.8a9.8 9.8 0 0 1-5-1.4l-.4-.2-3.7 1 1-3.6-.2-.4A9.8 9.8 0 1 1 12 21.8Zm8.4-18.2A11.8 11.8 0 0 0 1.8 17.9L.1 24l6.3-1.6A11.8 11.8 0 0 0 23.8 12a11.7 11.7 0 0 0-3.4-8.4Z"/></svg>
		</a>
		<a href={`https://twitter.com/intent/tweet?text=${texto}&url=${enlace}`} target="_blank" rel="noopener" class={boton} aria-label="Compartir en X" title="X">
			<svg viewBox="0 0 24 24" class="h-[16px] w-[16px] fill-current" aria-hidden="true"><path d="M18.9 2H22l-7.2 8.2L23.3 22h-6.6l-5.2-6.8L5.5 22H2.4l7.7-8.8L2 2h6.8l4.7 6.2Zm-1.1 18h1.7L7.3 3.9H5.5Z"/></svg>
		</a>
		<a href={`https://www.facebook.com/sharer/sharer.php?u=${enlace}`} target="_blank" rel="noopener" class={boton} aria-label="Compartir en Facebook" title="Facebook">
			<svg viewBox="0 0 24 24" class="h-[18px] w-[18px] fill-current" aria-hidden="true"><path d="M13.5 21.9v-7.7h2.6l.4-3h-3V9.3c0-.9.3-1.5 1.5-1.5h1.6V5.1a22 22 0 0 0-2.4-.1c-2.3 0-3.9 1.4-3.9 4v2.2H7.7v3h2.6v7.7Z"/></svg>
		</a>
		<a href={`mailto:?subject=${texto}&body=${enlace}`} class={boton} aria-label="Enviar por mail" title="Mail">
			<svg viewBox="0 0 24 24" class="h-[18px] w-[18px]" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
		</a>
		<button type="button" data-copiar={url} aria-label="Copiar enlace" title="Copiar enlace" class={`copiar-enlace ${boton}`}>
			<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"></path><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"></path></svg>
		</button>
		<slot />
	</div>
</div>

<script is:inline>
	document.querySelectorAll('.copiar-enlace').forEach(function (btn) {
		if (btn.dataset.listo) return;
		btn.dataset.listo = '1';
		btn.addEventListener('click', function () {
			var url = btn.dataset.copiar;
			var listo = function () { btn.setAttribute('aria-label', 'Enlace copiado'); btn.style.background = '#e8f5ee'; setTimeout(function () { btn.setAttribute('aria-label', 'Copiar enlace'); btn.style.background = ''; }, 1500); };
			if (navigator.clipboard) navigator.clipboard.writeText(url).then(listo, function () {});
		});
	});
</script>
