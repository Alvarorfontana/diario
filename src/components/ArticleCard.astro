---
import FormattedDate from './FormattedDate.astro';
import { nombreSeccion } from '../consts';

const { article } = Astro.props;
// Campos del formato nuevo (Supabase): vienen directos en el objeto
const { title, excerpt, section, date, image_url, slug, volanta } = article;
const img = image_url || null;
---

<article class="border-t border-neutral-300 pt-3">
	<a href={`/articulo/${slug}/`} class="group block">
		<p class="text-[11px] font-bold tracking-[0.2em] uppercase">
			<span class="text-brand">{nombreSeccion(section || '')}</span>
			{volanta && <span class="font-semibold tracking-normal text-neutral-500 normal-case"> · {volanta}</span>}
		</p>
		<h3 class="titular-link mt-2 font-serif text-xl leading-snug font-bold text-neutral-900 sm:text-2xl">
			{title}
		</h3>
		<p class="mt-2 line-clamp-3 text-sm leading-relaxed text-neutral-600">
			{excerpt}
		</p>
		{img && <img src={img} alt="" class="mt-3 w-full object-cover" loading="lazy" />}
		<p class="mt-2 text-xs text-neutral-400">
			<FormattedDate date={date} />
		</p>
	</a>
</article>
