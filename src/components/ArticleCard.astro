---
import FormattedDate from './FormattedDate.astro';
import { nombreSeccion } from '../consts';

const { article } = Astro.props;

// Soporta AMBOS formatos: datos anidados (article.data.*) y planos (article.*)
const data = article.data ?? article;
const title = data.title;
const excerpt = data.excerpt ?? data.description ?? '';
const section = data.section ?? '';
const articleDate = new Date(data.date ?? data.pubDate);
const img = data.image_url ?? (typeof data.heroImage === 'string' ? data.heroImage : data.heroImage?.src) ?? null;
const articleSlug = data.slug ?? article.id;
const volanta = data.volanta;
---

<article class="pt-1">
	<a href={`/articulo/${articleSlug}/`} class="group block">
		{img && <div class="mb-3 overflow-hidden"><img src={img} alt="" class="aspect-[3/2] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" loading="lazy" /></div>}
		<p class="text-[11px] font-bold tracking-[0.16em] uppercase">
			<span class="text-brand">{nombreSeccion(section)}</span>
			{volanta && <span class="font-semibold tracking-normal text-neutral-500 normal-case"> · {volanta}</span>}
		</p>
		<h3 class="titular-link mt-1.5 font-serif text-[1.35rem] leading-[1.18] font-bold text-neutral-900 sm:text-[1.5rem]">
			{title}
		</h3>
		<p class="mt-2 line-clamp-3 text-sm leading-relaxed text-neutral-600">
			{excerpt}
		</p>
		<p class="mt-2 text-xs text-neutral-400">
			<FormattedDate date={articleDate} />
		</p>
	</a>
</article>
