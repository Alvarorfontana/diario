---
import FormattedDate from './FormattedDate.astro';
import { nombreSeccion, SITE_TITLE, volantaFuerte } from '../consts';
import { imagenNotaPath } from '../lib/og';

const { article } = Astro.props;

// Soporta AMBOS formatos: datos anidados (article.data.*) y planos (article.*)
const data = article.data ?? article;
const title = data.title;
const excerpt = data.excerpt ?? data.description ?? '';
const section = data.section ?? '';
const articleDate = new Date(data.date ?? data.pubDate);
const img = data.image_url ?? (typeof data.heroImage === 'string' ? data.heroImage : data.heroImage?.src) ?? null;
const articleSlug = data.slug ?? article.id;
const fotoVisible = img && /^https?:\/\//i.test(img) ? imagenNotaPath(articleSlug, img, 640) : img;
const volanta = data.volanta;
---

<!-- Tarjeta estilo portal: siempre con imagen (o un recuadro con la marca si la nota no tiene foto) -->
<article class="tarjeta overflow-hidden">
	<a href={`/articulo/${articleSlug}/`} class="group block">
		<div class="overflow-hidden">
			{img ? (
				<img src={fotoVisible} data-fallback-src={img && /^https?:\/\//i.test(img) ? img : undefined} alt="" class="aspect-[3/2] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" loading="lazy" />
			) : (
				<div class="flex aspect-[3/2] w-full items-center justify-center gap-2 bg-[#ececE8] font-display text-2xl font-extrabold text-neutral-400">
					<span class="inline-block h-3 w-3 rounded-[3px] bg-brand" aria-hidden="true"></span>{SITE_TITLE}
				</div>
			)}
		</div>
		<div class="p-4">
			<p class="text-[11px] font-bold tracking-[0.1em] uppercase">
				<span class="text-brand">{nombreSeccion(section)}</span>
				{volanta && (volantaFuerte(volanta)
					? <span class="ml-1.5 inline-block rounded bg-brand px-1.5 py-0.5 text-[10px] font-extrabold tracking-[0.08em] text-white uppercase">{volanta}</span>
					: <span class="font-semibold tracking-normal text-neutral-500 normal-case"> · {volanta}</span>)}
			</p>
			<h3 class="mt-1.5 font-display text-[1.15rem] leading-[1.25] font-bold text-ink transition-colors group-hover:text-brand sm:text-[1.25rem]">
				{title}
			</h3>
			<p class="mt-2 line-clamp-2 text-sm leading-relaxed text-neutral-600">
				{excerpt}
			</p>
			<p class="mt-2 text-xs text-neutral-500">
				<FormattedDate date={articleDate} />
			</p>
		</div>
	</a>
</article>

<script is:inline>
	// Recuperación de fotos externas si falla la ruta optimizada del sitio.
	document.addEventListener('error', function (event) {
		var img = event.target;
		if (img instanceof HTMLImageElement && img.dataset.fallbackSrc && !img.dataset.fallbackTried) {
			img.dataset.fallbackTried = '1';
			img.src = img.dataset.fallbackSrc;
		}
	}, true);
</script>
