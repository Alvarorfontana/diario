---
// Botón "Aa" de la nota (estilo La Nación / NYT): agrandar o achicar la letra
// del texto y prender el modo noche. Se recuerda en el navegador del lector.
---

<details class="opciones-lectura relative" data-no-imprimir>
	<summary class="inline-flex cursor-pointer list-none items-center rounded-full bg-[#f0f0ec] px-3.5 py-1.5 font-sans text-[14px] font-bold text-ink select-none hover:bg-neutral-200 [&::-webkit-details-marker]:hidden" aria-label="Tamaño de letra y modo noche" title="Tamaño de letra y modo noche">
		<span class="text-[12px]">A</span><span class="text-[16px]">a</span>
	</summary>
	<div class="absolute left-0 z-30 mt-2 w-[230px] sm:right-0 sm:left-auto rounded-2xl bg-white p-3 shadow-[0_8px_28px_rgba(0,0,0,0.16),inset_0_0_0_1px_#e2e2dc]">
		<p class="font-sans text-[11px] font-bold tracking-[0.08em] text-neutral-500 uppercase">Tamaño de letra</p>
		<div class="mt-2 flex items-center gap-2">
			<button type="button" data-letra="-1" class="h-9 flex-1 rounded-lg bg-[#f0f0ec] font-sans text-[14px] font-bold text-ink hover:bg-neutral-200" aria-label="Letra más chica">A−</button>
			<button type="button" data-letra="1" class="h-9 flex-1 rounded-lg bg-[#f0f0ec] font-sans text-[18px] font-bold text-ink hover:bg-neutral-200" aria-label="Letra más grande">A+</button>
		</div>
		<button type="button" data-modo-noche class="mt-3 flex w-full items-center justify-between rounded-lg bg-[#f0f0ec] px-3 py-2 font-sans text-[14px] font-semibold text-ink hover:bg-neutral-200">
			<span>Modo noche</span>
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg>
		</button>
	</div>
</details>

<script is:inline>
	(function () {
		var raiz = document.documentElement;
		document.querySelectorAll('[data-letra]').forEach(function (b) {
			b.addEventListener('click', function () {
				var n = 0;
				try { n = parseInt(localStorage.getItem('df-letra') || '0', 10) || 0; } catch (e) {}
				n = Math.max(-1, Math.min(2, n + parseInt(b.getAttribute('data-letra'), 10)));
				raiz.setAttribute('data-letra', String(n));
				try { localStorage.setItem('df-letra', String(n)); } catch (e) {}
			});
		});
		document.querySelectorAll('[data-modo-noche]').forEach(function (b) {
			b.addEventListener('click', function () {
				var on = !raiz.classList.contains('modo-noche');
				raiz.classList.toggle('modo-noche', on);
				try { localStorage.setItem('df-noche', on ? '1' : '0'); } catch (e) {}
			});
		});
	})();
</script>
