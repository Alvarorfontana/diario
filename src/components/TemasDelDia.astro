---
// Temas del día: se construyen en cada render a partir de las etiquetas
// de las notas recientes. La frecuencia y la actualidad determinan el orden;
// no hay una lista fija ni se inventan temas que no estén en las notas.
import { slugify } from '../consts';
import type { Articulo } from '../lib/articles';

interface Props {
	articulos: Articulo[];
	max?: number;
}
const { articulos, max = 6 } = Astro.props;

// Etiquetas editoriales demasiado amplias para identificar un asunto concreto.
const GENERICAS = new Set([
	'politica', 'economia', 'argentina', 'internacional', 'opinion',
	'actualidad', 'sociedad', 'nacionales', 'noticias', 'deportes',
	'cultura', 'tecnologia',
]);

const ahora = Date.now();
const ventana = 72 * 60 * 60 * 1000;
let base = articulos.filter((a) => {
	const fecha = a.date?.valueOf();
	return Number.isFinite(fecha) && fecha <= ahora && ahora - fecha <= ventana;
});
// Si la producción fue baja en las últimas 72 horas, ampliamos la muestra
// para que la portada no quede sin temas, sin perder el orden cronológico.
if (base.length < 5) base = articulos.slice(0, 20);

const cuenta = new Map<string, { nombre: string; n: number; ultima: number; actualidad: number }>();
for (const a of base) {
	const fecha = a.date?.valueOf() ?? 0;
	for (const etiqueta of new Set((a.tags ?? []).map((x) => String(x).trim()).filter(Boolean))) {
		const slug = slugify(etiqueta);
		if (!slug || GENERICAS.has(slug) || slug.length < 3) continue;
		const horas = Math.max(0, (ahora - fecha) / (60 * 60 * 1000));
		const actualidad = horas <= 24 ? 3 : horas <= 48 ? 2 : 1;
		const previo = cuenta.get(slug);
		if (previo) {
			previo.n++;
			previo.ultima = Math.max(previo.ultima, fecha);
			previo.actualidad = Math.max(previo.actualidad, actualidad);
		} else {
			cuenta.set(slug, { nombre: etiqueta, n: 1, ultima: fecha, actualidad });
		}
	}
}

// Se priorizan los asuntos que aparecen en varias notas recientes.
// La actualidad desempata temas con igual frecuencia.
const temas = [...cuenta.entries()]
	.sort((a, b) =>
		(b[1].n * 3 + b[1].actualidad) - (a[1].n * 3 + a[1].actualidad) ||
		b[1].n - a[1].n ||
		b[1].ultima - a[1].ultima
	)
	.slice(0, max)
	.map(([slug, v]) => ({ slug, nombre: v.nombre }));
---

{temas.length >= 3 && (
	<nav aria-label="Temas del día" class="mt-4 flex items-center gap-2 overflow-x-auto pb-1 [scrollbar-width:none]">
		<span class="shrink-0 text-[11px] font-extrabold tracking-[0.1em] text-neutral-500 uppercase">Temas del día</span>
		{temas.map((t) => (
			<a href={`/tag/${t.slug}/`} class="shrink-0 rounded-full border border-[#e2e2dc] bg-white px-3 py-1.5 text-[13px] font-semibold whitespace-nowrap text-ink transition-colors hover:border-brand hover:text-brand">
				{t.nombre.charAt(0).toUpperCase() + t.nombre.slice(1)}
			</a>
		))}
	</nav>
)}
