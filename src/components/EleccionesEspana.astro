.party { border: 1px solid var(--line); border-top: 4px solid var(--ink); padding: 20px; }
.party h3 { margin: 12px 0 8px; }
.party p { font-weight: 700; margin-bottom: 5px; }
.party small { color: var(--muted); }
.party-tag { font-size: .72rem; color: var(--acento); font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }
.regional-pills { display: flex; flex-wrap: wrap; gap: 8px; }
.regional-pills span { padding: 7px 12px; background: var(--pale); color: var(--ink); font-weight: 700; font-size: .9rem; }
.poll-chart { max-width: 760px; margin: 28px 0; }
.poll-item { margin-bottom: 20px; }
.poll-heading { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 7px; font-size: .95rem; }
.poll-track { height: 14px; background: #ececec; }
.poll-bar { height: 100%; background: var(--ink); }
.poll-pp { background: #1f2937; }
.poll-psoe { background: var(--acento); }
.poll-vox { background: #4d7c0f; }
.poll-fa { background: #7e3a80; }
.poll-warning { padding: 18px 20px; background: var(--pale); border-left: 4px solid var(--acento); margin: 24px 0; }
.poll-warning p { margin: 6px 0 0; }
.majority { display: flex; align-items: center; gap: 22px; background: var(--pale); padding: 24px; margin: 24px 0; }
.majority-number { font-size: 3.4rem; font-weight: 800; color: var(--acento); }
.majority p { margin: 5px 0 0; }
.regional-table { max-width: 760px; }
.regional-row { display: grid; grid-template-columns: 1fr 1.5fr 42px; gap: 12px; padding: 12px 8px; border-bottom: 1px solid var(--line); }
.regional-row b { text-align: right; }
.regional-total { border-top: 2px solid var(--ink); font-weight: 700; }
.note, .source { color: var(--muted); font-size: .88rem; margin-top: 18px; }
.feature { padding: clamp(25px, 5vw, 48px); margin: 38px 0; background: var(--pale); border-left: 5px solid var(--acento); scroll-margin-top: 80px; }
.territory-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; margin: 24px 0; }
.territory-card { padding: 24px; border: 1px solid var(--line); }
