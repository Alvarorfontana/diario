---
// Especial "España decide" · Elecciones generales del 29 de noviembre de 2026
// Datos verificados el 27/11/2026: INE (electores), Polling Forecast (encuestas), resultados de 2023 (partidos territoriales).
const polls = [
  { name: "Partido Popular", short: "PP", value: 30.9, seats: 131 },
  { name: "Partido Socialista", short: "PSOE", value: 28.9, seats: 119 },
  { name: "Vox", short: "VOX", value: 18.1, seats: 63 },
  { name: "Frente Amplio (Sumar)", short: "FA", value: 6.3, seats: 8 },
];

const regionalParties = [
  { name: "Esquerra Republicana", short: "ERC", region: "Cataluña", seats: 7 },
  { name: "Junts per Catalunya", short: "Junts", region: "Cataluña", seats: 7 },
  { name: "EH Bildu", short: "EH Bildu", region: "País Vasco y Navarra", seats: 6 },
  { name: "Partido Nacionalista Vasco", short: "PNV", region: "País Vasco", seats: 5 },
  { name: "Bloque Nacionalista Galego", short: "BNG", region: "Galicia", seats: 1 },
  { name: "Coalición Canaria", short: "CC", region: "Canarias", seats: 1 },
  { name: "Unión del Pueblo Navarro", short: "UPN", region: "Navarra", seats: 1 },
];

const totalRegional = regionalParties.reduce((sum, p) => sum + p.seats, 0);

const territories = [
  {
    name: "Cataluña",
    seats: 48,
    provinces: "Barcelona, Girona, Lleida y Tarragona",
    parties: "PSC, ERC, Junts, Comuns-Front Ampli, PP, Vox y Podemos, entre otras candidaturas.",
  },
  {
    name: "País Vasco",
    seats: 18,
    provinces: "Álava, Bizkaia y Gipuzkoa",
    parties: "PNV, EH Bildu, PSE-EE, PP, Vox y otras candidaturas.",
  },
];

const RESULTADOS_OFICIALES = "https://29neleccionesgenerales.es";
const fmt = (n: number) => n.toFixed(1).replace(".", ",");

// ---- Hemiciclo: proyección de Polling Forecast (27/11/2026). "Otros" = 350 - partidos principales.
const hemiParties = [
  { short: "FA", name: "Frente Amplio", seats: 8, color: "#7e3a80" },
  { short: "PSOE", name: "PSOE", seats: 119, color: "#d0021b" },
  { short: "Otros", name: "Otros y territoriales", seats: 29, color: "#a3a3a3" },
  { short: "PP", name: "PP", seats: 131, color: "#1f2937" },
  { short: "VOX", name: "Vox", seats: 63, color: "#4d7c0f" },
];
const hemiDots = (() => {
  const total = 350, rows = 10, r0 = 90, r1 = 250, cx = 270, cy = 270;
  const radii = Array.from({ length: rows }, (_, i) => r0 + (i * (r1 - r0)) / (rows - 1));
  const sumR = radii.reduce((a, b) => a + b, 0);
  let counts = radii.map((r) => Math.round((r / sumR) * total));
  let diff = total - counts.reduce((a, b) => a + b, 0);
  counts[rows - 1] += diff;
  const pts: { x: number; y: number; a: number }[] = [];
  radii.forEach((r, i) => {
    const n = counts[i];
    for (let k = 0; k < n; k++) {
      const a = Math.PI - (Math.PI * k) / (n - 1);
      pts.push({ x: cx + r * Math.cos(a), y: cy - r * Math.sin(a), a });
    }
  });
  pts.sort((p, q) => q.a - p.a);
  const colors: string[] = [];
  hemiParties.forEach((pt) => { for (let i = 0; i < pt.seats; i++) colors.push(pt.color); });
  return pts.map((p, i) => ({ x: p.x.toFixed(1), y: p.y.toFixed(1), c: colors[i] }));
})();

// ---- Evolución del promedio de encuestas de Demócrata (media del último estudio de cada instituto).
const trendDates = ["21 oct", "27 oct", "2 nov", "7 nov", "10 nov"];
const trendSeries = [
  { name: "PP", color: "#1f2937", values: [31.6, 31.0, 30.6, 31.0, 31.5] },
  { name: "PSOE", color: "#d0021b", values: [26.9, 27.3, 27.3, 26.2, 26.8] },
  { name: "Vox", color: "#4d7c0f", values: [18.7, 18.9, 19.0, 19.5, 19.1] },
  { name: "Frente Amplio", color: "#7e3a80", values: [6.3, 6.3, 6.4, 6.6, 6.2] },
];
const TW = 640, TH = 300, TL = 44, TR = 110, TT = 20, TB = 40;
const tx = (i: number) => TL + (i * (TW - TL - TR)) / (trendDates.length - 1);
const ty = (v: number) => TT + (1 - v / 35) * (TH - TT - TB);
const urdaX = tx(1) + (tx(2) - tx(1)) * (1 / 6); // 28 de octubre, entre el 27 oct y el 2 nov

// ---- Escaños por comunidad (reparto vigente en las generales de 2023) y posición en el mapa en mosaico.
const comunidades = [
  { id: "gal", name: "Galicia", seats: 23, prov: "A Coruña 8, Pontevedra 7, Lugo 4, Ourense 4", c: 0, r: 0 },
  { id: "ast", name: "Asturias", seats: 7, prov: "Asturias 7", c: 1, r: 0 },
  { id: "can", name: "Cantabria", seats: 5, prov: "Cantabria 5", c: 2, r: 0 },
  { id: "pv", name: "País Vasco", seats: 18, prov: "Bizkaia 8, Gipuzkoa 6, Álava 4", c: 3, r: 0 },
  { id: "nav", name: "Navarra", seats: 5, prov: "Navarra 5", c: 4, r: 0 },
  { id: "cyl", name: "Castilla y León", seats: 31, prov: "Valladolid 5, Burgos 4, León 4, Salamanca 4, Ávila 3, Palencia 3, Segovia 3, Zamora 3, Soria 2", c: 1, r: 1 },
  { id: "rio", name: "La Rioja", seats: 4, prov: "La Rioja 4", c: 3, r: 1 },
  { id: "ara", name: "Aragón", seats: 13, prov: "Zaragoza 7, Huesca 3, Teruel 3", c: 4, r: 1 },
  { id: "cat", name: "Cataluña", seats: 48, prov: "Barcelona 32, Girona 6, Tarragona 6, Lleida 4", c: 5, r: 1 },
  { id: "ext", name: "Extremadura", seats: 9, prov: "Badajoz 5, Cáceres 4", c: 0, r: 2 },
  { id: "mad", name: "Madrid", seats: 37, prov: "Madrid 37", c: 2, r: 2 },
  { id: "clm", name: "Castilla-La Mancha", seats: 21, prov: "Toledo 6, Ciudad Real 5, Albacete 4, Cuenca 3, Guadalajara 3", c: 3, r: 2 },
  { id: "val", name: "C. Valenciana", seats: 33, prov: "Valencia 16, Alicante 12, Castellón 5", c: 4, r: 2 },
  { id: "bal", name: "Baleares", seats: 8, prov: "Illes Balears 8", c: 6, r: 2 },
  { id: "and", name: "Andalucía", seats: 61, prov: "Sevilla 12, Málaga 11, Cádiz 9, Granada 7, Almería 6, Córdoba 6, Huelva 5, Jaén 5", c: 1, r: 3, w: 2 },
  { id: "mur", name: "Murcia", seats: 10, prov: "Murcia 10", c: 3, r: 3 },
  { id: "cnr", name: "Canarias", seats: 15, prov: "Las Palmas 8, Santa Cruz de Tenerife 7", c: 0, r: 4 },
  { id: "ceu", name: "Ceuta", seats: 1, prov: "Ceuta 1", c: 2, r: 4 },
  { id: "mel", name: "Melilla", seats: 1, prov: "Melilla 1", c: 3, r: 4 },
];
const totalComunidades = comunidades.reduce((a, b) => a + b.seats, 0);
const tileFill = (n: number) => {
  const t = Math.min(1, Math.sqrt(n / 61));
  const mix = (a: number, b: number) => Math.round(a + (b - a) * t);
  return `rgb(${mix(254, 160)},${mix(226, 0)},${mix(226, 21)})`;
};

const medios = [
  { name: "Ministerio del Interior", desc: "Web oficial del 29N: escrutinio provisional, participación y mesas.", url: RESULTADOS_OFICIALES, kicker: "Fuente oficial" },
  { name: "RTVE", desc: "Radiotelevisión pública española: cobertura de la noche electoral.", url: "https://www.rtve.es/", kicker: "Televisión pública" },
  { name: "El País", desc: "Diario nacional de Madrid: resultados y análisis.", url: "https://elpais.com/", kicker: "Madrid" },
  { name: "El Mundo", desc: "Diario nacional de Madrid: seguimiento y encuestas.", url: "https://www.elmundo.es/", kicker: "Madrid" },
  { name: "La Vanguardia", desc: "Diario de Barcelona: la mirada desde Cataluña.", url: "https://www.lavanguardia.com/", kicker: "Cataluña" },
  { name: "EFE", desc: "Agencia pública de noticias: cables de la jornada.", url: "https://efe.com/", kicker: "Agencia" },
];
---

<main class="df-espana">
  <header class="hero">
    <div class="kicker">Diario Federal · Internacional</div>
    <div class="hero-label">Especial electoral</div>
    <h1>España decide</h1>
    <p class="subtitle">Elecciones generales · 29 de noviembre de 2026</p>
    <p class="intro bajada">
      Una guía para entender la elección española: partidos, candidatos,
      encuestas, alianzas parlamentarias y el peso político de Cataluña
      y el País Vasco. Seguimiento de la jornada y resultados.
    </p>

    <figure class="hero-foto">
      <img src="/uploads/2026-11-19-debate-sanchez-feijoo-academia.jpg" alt="Pedro Sánchez y Alberto Núñez Feijóo se dan la mano en el plató del debate" loading="eager" />
      <figcaption class="epigrafe">Pedro Sánchez y Alberto Núñez Feijóo se saludan antes del debate electoral celebrado en la Academia de la Televisión, en Tres Cantos, Madrid. Foto: AFP / Óscar del Pozo.</figcaption>
    </figure>

    <div class="hero-numbers">
      <div><strong>350</strong><span>Diputados</span></div>
      <div><strong>176</strong><span>Mayoría absoluta</span></div>
      <div><strong>38,7 M</strong><span>Electores habilitados</span></div>
    </div>
  </header>

  <nav class="nav-special">
    <a href="#que-se-vota">La elección</a>
    <a href="#partidos">Partidos</a>
    <a href="#encuestas">Encuestas</a>
    <a href="#mayorias">Mayorías</a>
    <a href="#colau">Ada Colau</a>
    <a href="#territorios">Territorios</a>
    <a href="#resultados">Resultados</a>
  </nav>

  <section class="score-strip" aria-label="Resumen de la elección">
    <article class="score-card">
      <span class="score-label">Estado de la cobertura</span>
      <strong class="live-state"><span class="live-dot"></span>Veda electoral</strong>
      <small>Votación el domingo 29, de 5 a 16 hora argentina</small>
    </article>
    <article class="score-card">
      <span class="score-label">PP + Vox (proyección)</span>
      <strong>194</strong>
      <small>18 por encima de la mayoría absoluta</small>
    </article>
    <article class="score-card">
      <span class="score-label">PSOE + Frente Amplio (proyección)</span>
      <strong>127</strong>
      <small>49 por debajo de la mayoría absoluta</small>
    </article>
  </section>

  <section id="que-se-vota" class="section">
    <div class="kicker">01 · El sistema electoral</div>
    <h2>¿Qué se vota en España?</h2>
    <p>
      El domingo 29 de noviembre se elige la composición de las Cortes
      Generales: el Congreso de los Diputados y el Senado. El Congreso
      tiene 350 bancas y es la cámara que decide la investidura del
      presidente del Gobierno. Sánchez convocó las elecciones el 5 de
      octubre, después de que el Congreso rechazara sus decretos de vivienda.
    </p>

    <div class="facts">
      <article><strong>350</strong><span>Diputados del Congreso</span></article>
      <article><strong>176</strong><span>Votos para mayoría absoluta</span></article>
      <article><strong>52</strong><span>Circunscripciones electorales</span></article>
      <article><strong>38.728.356</strong><span>Electores habilitados</span></article>
    </div>

    <h3>Cómo funciona el sistema</h3>
    <p>
      La elección del Congreso se hace por representación proporcional
      en circunscripciones provinciales. Cada una de las 50 provincias
      es una circunscripción, además de Ceuta y Melilla. La cantidad de
      diputados de cada territorio depende de su población.
    </p>
    <p>
      El Senado tiene otro sistema. Los ciudadanos eligen directamente
      a 209 senadores en sus circunscripciones, y los parlamentos
      autonómicos designan al resto.
    </p>
    <p>
      De los 38.728.356 electores, 35.958.711 viven en España y 2.769.645
      en el exterior. Los residentes en el extranjero pueden votar sin
      solicitud previa.
    </p>

    <p class="source">
      Fuentes:{" "}
      <a href="https://www.lamoncloa.gob.es/serviciosdeprensa/notasprensa/interior/paginas/guia-dudas-elecciones-generales-29n.aspx" target="_blank" rel="noopener">Ministerio del Interior · guía del 29N</a> ·
      <a href="https://www.ine.es/dyngs/Prensa/es/EG2026.htm" target="_blank" rel="noopener">Instituto Nacional de Estadística · censo electoral</a>.
    </p>
  </section>

  <section id="partidos" class="section">
    <div class="kicker">02 · Los protagonistas</div>
    <h2>Partidos y candidatos</h2>
    <p>
      El Boletín Oficial del Estado publicó 534 listas al Congreso y 361
      al Senado. No todas las fuerzas se presentan en todas las provincias.
    </p>

    <div class="party-grid">
      <article class="party party-psoe">
        <span class="party-tag">Centroizquierda</span>
        <h3>PSOE</h3>
        <p>Pedro Sánchez</p>
        <small>Partido Socialista Obrero Español</small>
      </article>

      <article class="party party-pp">
        <span class="party-tag">Centroderecha</span>
        <h3>Partido Popular</h3>
        <p>Alberto Núñez Feijóo</p>
        <small>Principal fuerza de la oposición</small>
      </article>

      <article class="party party-vox">
        <span class="party-tag">Derecha radical</span>
        <h3>Vox</h3>
        <p>Santiago Abascal</p>
        <small>Fuerza decisiva para una posible mayoría conservadora</small>
      </article>

      <article class="party party-fa">
        <span class="party-tag">Izquierda</span>
        <h3>Frente Amplio</h3>
        <p>Ada Colau</p>
        <small>Coalición de Sumar, IU, Comuns y Más Madrid. En Cataluña se presenta como Comuns-Front Ampli</small>
      </article>

      <article class="party party-pod">
        <span class="party-tag">Izquierda</span>
        <h3>Podemos</h3>
        <p>Irene Montero</p>
        <small>Va por separado en la mayoría de las provincias; en Canarias y la Comunidad Valenciana, junto al Frente Amplio</small>
      </article>
    </div>

    <h3>Las principales fuerzas territoriales</h3>
    <div class="regional-pills">
      <span>ERC</span><span>Junts</span><span>PNV</span>
      <span>EH Bildu</span><span>BNG</span>
      <span>Coalición Canaria</span><span>UPN</span>
    </div>

    <p class="source">
      Fuentes:{" "}
      <a href="https://www.articulo14.es/politica/que-partidos-se-presentan-a-las-elecciones-del-29-n-candidaturas-y-coaliciones-20261108.html" target="_blank" rel="noopener">Artículo14 · candidaturas del 29N</a> ·
      <a href="https://www.juntaelectoralcentral.es/" target="_blank" rel="noopener">Junta Electoral Central</a>.
    </p>
  </section>

  <section id="encuestas" class="section">
    <div class="kicker">03 · Intención de voto</div>
    <h2>Qué dicen las encuestas</h2>
    <p>
      El promedio final de Polling Forecast, con datos al 27 de noviembre,
      ubica al PP primero, dos puntos por encima del PSOE. Vox ronda el 18%.
    </p>

    <div class="poll-chart">
      {polls.map((poll) => (
        <div class="poll-item">
          <div class="poll-heading">
            <strong>{poll.name}</strong>
            <strong>{fmt(poll.value)}% · {poll.seats} escaños</strong>
          </div>
          <div class="poll-track">
            <div class={`poll-bar poll-${poll.short.toLowerCase()}`} style={`width:${(poll.value / 35) * 100}%`}></div>
          </div>
        </div>
      ))}
    </div>

    <h3>Antes y después de Urda</h3>
    <p>
      El choque de trenes de Urda, el 28 de octubre, frenó la remontada
      socialista. En el promedio de Demócrata, el PSOE bajó del 27,3% al
      26,2% en diez días, mientras Vox llegó a su máximo de la campaña.
    </p>
    <figure class="trend">
      <svg viewBox={`0 0 ${TW} ${TH}`} role="img" aria-label="Evolución del promedio de encuestas entre el 21 de octubre y el 10 de noviembre de 2026">
        {[0, 10, 20, 30].map((v) => (
          <g>
            <line x1={TL} x2={TW - TR} y1={ty(v)} y2={ty(v)} stroke="#e5e5e5" />
            <text x={TL - 8} y={ty(v) + 4} text-anchor="end" class="axis">{v}%</text>
          </g>
        ))}
        <line x1={urdaX} x2={urdaX} y1={TT} y2={TH - TB} stroke="#737373" stroke-dasharray="4 4" />
        <text x={urdaX + 6} y={TT + 12} class="axis">Urda · 28 oct</text>
        {trendDates.map((d, i) => <text x={tx(i)} y={TH - TB + 22} text-anchor="middle" class="axis">{d}</text>)}
        {trendSeries.map((s) => (
          <g>
            <polyline fill="none" stroke={s.color} stroke-width="3" points={s.values.map((v, i) => `${tx(i)},${ty(v)}`).join(" ")} />
            {s.values.map((v, i) => <circle cx={tx(i)} cy={ty(v)} r="3.5" fill={s.color} />)}
            <text x={tx(trendDates.length - 1) + 10} y={ty(s.values[s.values.length - 1]) + 4} class="serie" fill={s.color}>{s.name} {fmt(s.values[s.values.length - 1])}</text>
          </g>
        ))}
      </svg>
      <figcaption>Promedio de encuestas de Demócrata (último estudio de cada instituto), en %. Período: 21 de octubre al 10 de noviembre de 2026. Es otro agregador que el de Polling Forecast, por eso las cifras no coinciden.</figcaption>
    </figure>

    <div class="poll-warning">
      <strong>Importante: veda electoral</strong>
      <p>
        En España no pueden difundirse encuestas entre el 24 y el 28 de
        noviembre. Este promedio se publicó durante la veda y se difunde
        desde fuera del país. No son resultados ni datos oficiales.
      </p>
    </div>

    <p>
      El mismo modelo proyecta 131 diputados para el PP, 119 para el PSOE
      y 63 para Vox. PP y Vox sumarían 194 bancas, por encima de las 176
      de la mayoría absoluta, en el 96% de sus simulaciones. Es una
      estimación estadística, no un reparto definitivo.
    </p>

    <p class="source">
      Fuente:{" "}
      <a href="https://www.pollingforecast.com/es/news/869/pronostico-final-pp-y-vox-suman-194-escanos-y-el-pp-no-puede-gobernar?lang=es" target="_blank" rel="noopener">Polling Forecast · pronóstico final del 27 de noviembre</a>.
      Las barras están escaladas sobre un máximo de 35%.
    </p>
  </section>

  <section id="mayorias" class="section">
    <div class="kicker">04 · La gobernabilidad</div>
    <h2>La aritmética de las alianzas</h2>
    <p>
      La elección no termina con el partido más votado. El Congreso debe
      investir al presidente del Gobierno. En la primera votación se
      necesitan 176 votos. En la segunda alcanza con más votos a favor
      que en contra.
    </p>

    <div class="majority">
      <div class="majority-number">176</div>
      <div>
        <strong>La cifra clave</strong>
        <p>Diputados necesarios para la mayoría absoluta.</p>
      </div>
    </div>

    <figure class="hemiciclo">
      <svg viewBox="0 0 540 290" role="img" aria-label="Hemiciclo con la proyección de escaños: PP 131, PSOE 119, Vox 63, Frente Amplio 8 y otros 29">
        {hemiDots.map((d) => <circle cx={d.x} cy={d.y} r="5.2" fill={d.c} />)}
        <text x="270" y="250" text-anchor="middle" class="hemi-num">350</text>
        <text x="270" y="272" text-anchor="middle" class="axis">diputados · mayoría: 176</text>
      </svg>
      <div class="hemi-legend">
        {hemiParties.map((p) => <span><i style={`background:${p.color}`}></i>{p.name} <b>{p.seats}</b></span>)}
      </div>
      <figcaption>Proyección de escaños al 27 de noviembre de 2026. Fuente: Polling Forecast. "Otros" agrupa a las fuerzas territoriales y al resto de las candidaturas. No son resultados.</figcaption>
    </figure>

    <h3>La representación territorial como factor de negociación</h3>
    <p>
      Los partidos regionales pueden resultar decisivos cuando los grandes
      bloques no alcanzan solos la mayoría. No votan en bloque: cada
      fuerza tiene sus propias prioridades y demandas.
    </p>

    <div class="regional-table">
      {regionalParties.map((party) => (
        <div class="regional-row">
          <strong>{party.short}</strong>
          <span>{party.region}</span>
          <b>{party.seats}</b>
        </div>
      ))}
      <div class="regional-row regional-total">
        <strong>Total</strong>
        <span>Siete fuerzas territoriales</span>
        <b>{totalRegional}</b>
      </div>
    </div>

    <p class="note">
      Referencia histórica: escaños obtenidos por estas siete fuerzas en
      las elecciones generales del 23 de julio de 2023. La suma de {totalRegional} no es un pronóstico para 2026 ni un bloque político
      común. El resultado del 29N actualizará esta tabla.
    </p>
  </section>

  <section id="colau" class="feature">
    <div class="kicker">05 · El papel de Ada Colau</div>
    <h2>Ada Colau y la disputa por el espacio progresista</h2>
    <p>
      La exalcaldesa de Barcelona es la candidata del Frente Amplio a la
      presidencia del Gobierno y encabeza la lista por Barcelona, donde la
      coalición se presenta como Comuns-Front Ampli. Su llegada es uno de
      los movimientos más visibles en la reorganización de la izquierda.
    </p>
    <p>
      Colau viene de los movimientos por el derecho a la vivienda: fue
      portavoz de la Plataforma de Afectados por la Hipoteca (PAH). En la
      campaña puso en primer plano los alquileres, la vivienda pública y
      los impuestos a los grandes propietarios.
    </p>
    <p>
      Su peso se medirá por los escaños del Frente Amplio y por su
      capacidad de influir en una eventual negociación de investidura.
      No reúne a toda la izquierda: Podemos compite por separado en la
      mayoría de las provincias.
    </p>
    <p class="source">
      Fuente:{" "}
      <a href="https://www.articulo14.es/politica/quien-encabeza-frente-amplio-en-el-29n-trayectoria-politica-y-personal-de-ada-colau-20261105.html" target="_blank" rel="noopener">Artículo14 · trayectoria de Ada Colau</a>.
    </p>
  </section>

  <section id="territorios" class="section">
    <div class="kicker">06 · El mapa territorial</div>
    <h2>Cataluña y País Vasco: dos escenarios decisivos</h2>
    <p>
      La distribución territorial del voto es central para entender la
      elección. Cataluña y el País Vasco tienen fuerzas propias que pueden
      inclinar la formación de mayorías en el Congreso.
    </p>

    <h3>Los 350 escaños, comunidad por comunidad</h3>
    <p>Tocá una comunidad para ver cuántos diputados elige y cómo se reparten por provincia.</p>
    <div class="mapa-wrap">
      <div class="mapa" role="list" aria-label="Mapa en mosaico de España por comunidad autónoma">
        {comunidades.map((t) => (
          <button type="button" class="tile" role="listitem" data-name={t.name} data-seats={t.seats} data-prov={t.prov}
            style={`grid-column:${t.c + 1} / span ${t.w ?? 1};grid-row:${t.r + 1};background:${tileFill(t.seats)};color:${t.seats >= 20 ? "#fff" : "#121212"}`}>
            <span>{t.name}</span><b>{t.seats}</b>
          </button>
        ))}
      </div>
      <aside class="mapa-detalle" id="mapa-detalle" aria-live="polite">
        <span class="score-label">Comunidad</span>
        <strong id="md-name">Andalucía</strong>
        <p id="md-seats">61 diputados</p>
        <p id="md-prov" class="note">Sevilla 12, Málaga 11, Cádiz 9, Granada 7, Almería 6, Córdoba 6, Huelva 5, Jaén 5</p>
      </aside>
    </div>
    <p class="note">Mapa esquemático (no a escala). Reparto de escaños vigente en las generales de 2023: {totalComunidades} diputados. El decreto de convocatoria de 2026 puede mover alguna banca entre provincias según el padrón.</p>

    <div class="territory-grid">
      {territories.map((territory) => (
        <article class="territory-card">
          <div class="territory-top">
            <h3>{territory.name}</h3>
            <strong>{territory.seats}</strong>
          </div>
          <p class="territory-subtitle">Diputados en juego</p>
          <p><b>Provincias:</b> {territory.provinces}</p>
          <p><b>Fuerzas políticas:</b> {territory.parties}</p>
          <a href={RESULTADOS_OFICIALES} target="_blank" rel="noopener">
            Consultar resultados oficiales →
          </a>
        </article>
      ))}
    </div>

    <h3>Qué mirar en Cataluña</h3>
    <ul>
      <li>La competencia entre PSC, ERC y Junts.</li>
      <li>El resultado de Comuns-Front Ampli con Ada Colau.</li>
      <li>La evolución del voto del PP y Vox.</li>
      <li>El reparto de escaños entre Barcelona, Girona, Lleida y Tarragona.</li>
      <li>La capacidad de las fuerzas catalanas para influir en la investidura.</li>
    </ul>

    <h3>Qué mirar en el País Vasco</h3>
    <ul>
      <li>La disputa entre PNV y EH Bildu.</li>
      <li>El comportamiento electoral del PSE-EE.</li>
      <li>La representación de Álava, Bizkaia y Gipuzkoa.</li>
      <li>La capacidad de negociación de las fuerzas vascas en el Congreso.</li>
    </ul>
  </section>

