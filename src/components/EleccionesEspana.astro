<script>
  const detalle = document.getElementById("mapa-detalle");
  if (detalle) {
    const nameEl = document.getElementById("md-name");
    const seatsEl = document.getElementById("md-seats");
    const provEl = document.getElementById("md-prov");
    document.querySelectorAll<HTMLButtonElement>(".df-espana .tile").forEach((tile) => {
      tile.addEventListener("click", () => {
        document.querySelectorAll(".df-espana .tile.activa").forEach((t) => t.classList.remove("activa"));
        tile.classList.add("activa");
        const n = Number(tile.dataset.seats);
        if (nameEl) nameEl.textContent = tile.dataset.name ?? "";
        if (seatsEl) seatsEl.textContent = `${n} ${n === 1 ? "diputado" : "diputados"}`;
        if (provEl) provEl.textContent = tile.dataset.prov ?? "";
      });
    });
  }
</script>