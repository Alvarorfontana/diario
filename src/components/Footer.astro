---
import { SITE_TITLE, SECCIONES, SOCIAL_LINKS } from '../consts';
import { REGIONES } from '../lib/regiones';
import SocialIcons from './SocialIcons.astro';

const hayRedes = SOCIAL_LINKS.some((r) => (r.url as string) !== '#');

const year = new Date().getFullYear();
---

<footer class="mt-12 border-t border-[#e6e6e2] bg-white">
	<!-- Accesos al Canal y a la edición de fin de semana, para que no se pierdan -->
	<div class="bg-ink text-white">
		<div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-4">
			<a href="/canal/" class="group flex items-center gap-3">
				<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white text-ink" aria-hidden="true">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M7 4l13 8-13 8z"></path></svg>
				</span>
				<span>
					<span class="block font-display text-lg font-extrabold group-hover:underline">{SITE_TITLE} Canal</span>
					<span class="block text-sm text-white/70">Señales de noticias en vivo: DW, C5N, Página/12 y más</span>
				</span>
			</a>
			<div class="flex flex-wrap gap-2">
				<a href="/fin-de-semana/" class="inline-flex min-h-11 items-center rounded-full border border-white/40 px-4 text-sm font-semibold hover:bg-white hover:text-ink">Edición de fin de semana →</a>
				<button type="button" data-instalar-app class="inline-flex min-h-11 items-center gap-2 rounded-full bg-white px-4 text-sm font-semibold text-ink">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path></svg>Instalá la app
				</button>
			</div>
		</div>
	</div>
	<div class="mx-auto grid max-w-6xl gap-8 px-4 py-10 sm:grid-cols-2 lg:grid-cols-4">
		<div>
			<p class="flex items-center gap-2 font-display text-2xl font-extrabold tracking-[-0.02em]">
				<span class="inline-block h-3 w-3 rounded-[3px] bg-brand" aria-hidden="true"></span>{SITE_TITLE}
			</p>
			<p class="mt-2 text-sm text-neutral-500">
				&copy; {year}. Todos los derechos reservados.
			</p>
			{hayRedes && <div class="mt-4"><SocialIcons /></div>}
		</div>
		<nav>
			<h2 class="text-xs font-bold tracking-widest text-neutral-500 uppercase">Secciones</h2>
			<ul class="mt-3 space-y-1.5 text-sm">
				{
					SECCIONES.map((seccion) => (
						<li>
							<a href={`/seccion/${seccion.id}/`} class="text-neutral-700 hover:text-brand">
								{seccion.nombre}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<nav>
			<h2 class="text-xs font-bold tracking-widest text-neutral-500 uppercase">Regiones</h2>
			<ul class="mt-3 space-y-1.5 text-sm">
				{REGIONES.map((r) => (
					<li><a href={`/region/${r.id}/`} class="text-neutral-700 hover:text-brand">{r.nombre}</a></li>
				))}
				<li><a href="/seccion/internacional/" class="text-neutral-700 hover:text-brand">Internacional</a></li>
			</ul>
		</nav>
		<nav>
			<h2 class="text-xs font-bold tracking-widest text-neutral-500 uppercase">El diario</h2>
			<ul class="mt-3 space-y-1.5 text-sm">
				<li><a href="/about/" class="text-neutral-700 hover:text-brand">Acerca de</a></li>
				<li><a href="/canal/" class="text-neutral-700 hover:text-brand">Canal</a></li>
				<li><a href="/fin-de-semana/" class="text-neutral-700 hover:text-brand">Edición de fin de semana</a></li>
				<li><button type="button" data-instalar-app class="text-left text-neutral-700 hover:text-brand">Bajá la app</button></li>
				<li><a href="/#newsletter" class="text-neutral-700 hover:text-brand">Boletín</a></li>
				<li><a href="/rss.xml" class="text-neutral-700 hover:text-brand">RSS</a></li>
				<li><a href="/legal/aviso-legal/" class="text-neutral-700 hover:text-brand">Aviso legal</a></li>
				<li><a href="/legal/politica-privacidad/" class="text-neutral-700 hover:text-brand">Política de privacidad</a></li>
				<li><a href="/admin/" class="text-neutral-400 hover:text-brand">Admin</a></li>
			</ul>
		</nav>
	</div>
</footer>
