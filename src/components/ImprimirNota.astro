---
// Botón para imprimir la nota o guardarla en PDF (solo esa nota, no el diario entero).
// Usa la ventana de impresión del navegador: ahí se elige "Imprimir" o "Guardar como PDF".
// Los estilos de abajo (@media print) dejan una versión limpia: logo, título, bajada,
// firma, foto con epígrafe, texto y el link de la nota al pie. Sin header, publicidad ni botones.
---

<button
	type="button"
	class="imprimir-nota mt-2 inline-flex h-10 w-auto max-w-full items-center justify-center gap-2 self-start rounded-xl bg-white px-3 text-[13px] font-bold text-ink shadow-[inset_0_0_0_1px_#dcdcd6] transition-colors hover:bg-neutral-50"
	aria-label="Imprimir la nota o guardarla en PDF"
>
	<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9V3h12v6"></path><rect x="3" y="9" width="18" height="8" rx="2"></rect><path d="M6 14h12v7H6z"></path></svg>
	Imprimir / Guardar en PDF
</button>

<script is:inline>
	(function () {
		document.querySelectorAll('.imprimir-nota').forEach(function (btn) {
			if (btn.dataset.listo) return;
			btn.dataset.listo = '1';
			btn.addEventListener('click', function () { window.print(); });
		});
		// Nombre del PDF: solo el título de la nota, sin " | EL DIARIO"
		var tituloOriginal = document.title;
		window.addEventListener('beforeprint', function () {
			document.title = tituloOriginal.split(' | ')[0];
		});
		window.addEventListener('afterprint', function () {
			document.title = tituloOriginal;
		});
	})();
</script>

<style is:global>
	.solo-impresion { display: none; }

	@media print {
		@page { size: A4; margin: 18mm 16mm; }

		html, body { background: #fff !important; }
		body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }

		/* Solo queda la nota: fuera header, publicidad, footer, barra fija, etc. */
		body > *:not(main) { display: none !important; }
		main { padding: 0 !important; max-width: none !important; }
		main > *:not(article) { display: none !important; }
		article { max-width: none !important; }
		[data-no-imprimir], .imprimir-nota { display: none !important; }

		/* Encabezado con la marca del diario */
		.solo-impresion { display: block !important; }
		.encabezado-impresion {
			display: flex !important;
			justify-content: space-between;
			align-items: baseline;
			border-bottom: 2px solid #111;
			padding-bottom: 6px;
			margin-bottom: 18px;
		}
		.marca-impresion { font-size: 20pt; font-weight: 800; letter-spacing: -0.02em; }
		.marca-impresion::before { content: ''; display: inline-block; width: 10px; height: 10px; margin-right: 8px; border-radius: 2px; background: #d0021b; vertical-align: 4px; }
		.sitio-impresion { font-size: 9pt; color: #555; }
		.pie-impresion {
			margin-top: 24px;
			padding-top: 8px;
			border-top: 1px solid #ccc;
			font-size: 8.5pt;
			color: #555;
			word-break: break-all;
		}

		/* Texto cómodo para leer en papel */
		article h1 { font-size: 24pt !important; line-height: 1.15 !important; }
		article .prose-articulo { font-size: 11.5pt; line-height: 1.55; }
		article a { color: inherit !important; text-decoration: none !important; }

		/* Foto entera en una página, sin cortes */
		article figure { break-inside: avoid; page-break-inside: avoid; margin-top: 16px !important; }
		article figure img { max-height: 110mm; width: auto !important; max-width: 100%; border-radius: 6px !important; margin: 0 auto; }
		article h1, article h2, article h3 { break-after: avoid; page-break-after: avoid; }
		article p, article li, article blockquote { orphans: 3; widows: 3; }
		.tarjeta { box-shadow: none !important; border: 1px solid #ddd; break-inside: avoid; }
	}
</style>
