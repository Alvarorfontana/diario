---
interface Props {
	href: string;
	titulo: string;
	texto?: string;
}

const { href, titulo, texto } = Astro.props;
---

<aside class="my-8 rounded-2xl bg-white px-5 py-4 font-sans shadow-[inset_0_0_0_1px_#e6e6e2]">
	<p class="text-[11px] font-bold tracking-[0.08em] text-brand uppercase">Leé también</p>
	<a href={href} class="group mt-1 block no-underline">
		<h4 class="font-display text-lg leading-snug font-bold text-ink transition-colors group-hover:text-brand">
			{titulo}
		</h4>
		{
			texto && (
				<p class="mt-1 text-sm leading-relaxed text-neutral-600">
					{texto}
				</p>
			)
		}
	</a>
</aside>
