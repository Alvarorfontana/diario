---
// Recuadro "Te puede interesar" dentro del texto de la nota (estilo Infobae).
// Se imprime al final del cuerpo y un script lo ubica a mitad de la nota.
// Sin JavaScript queda al final, que también sirve.
interface Props {
	slug: string;
	title: string;
}
const { slug, title } = Astro.props;
---

<div role="complementary" id="te-puede-interesar" style="hyphens: none; padding: 18px 18px 18px 22px; margin: 2rem 0;" class="te-puede-interesar font-sans rounded-xl border border-[#e2e2dc] bg-white" aria-label="Te puede interesar" data-no-imprimir>
	<a href={`/articulo/${slug}/`} style="color: inherit; text-decoration: none;" class="group flex items-center gap-4">
		<span class="min-w-0 flex-1">
			<span class="block font-sans text-[14px] text-neutral-700">Te puede interesar:</span>
			<span class="mt-1.5 block font-display text-[18px] leading-snug font-extrabold text-ink group-hover:text-brand">{title}</span>
		</span>
		<span class="flex self-stretch items-center border-l-[3px] border-brand pl-3 text-brand" aria-hidden="true">
			<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"></path></svg>
		</span>
	</a>
</div>

<script is:inline>
	(function () {
		var caja = document.getElementById('te-puede-interesar');
		var cuerpo = document.querySelector('.prose-articulo');
		if (!caja || !cuerpo) return;
		var parrafos = Array.prototype.filter.call(cuerpo.children, function (el) { return el.tagName === 'P'; });
		if (parrafos.length < 4) return; // nota corta: queda al final
		var medio = parrafos[Math.floor(parrafos.length / 2) - 1];
		medio.insertAdjacentElement('afterend', caja);
	})();
</script>
