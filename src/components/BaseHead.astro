---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	publishedTime?: Date;
	author?: string;
	section?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const baseURL = Astro.site ?? Astro.url.origin;

const { title, description, image = FallbackImage, publishedTime, author, section } = Astro.props;

// Handle both ImageMetadata and string URLs
const isExternalImage = typeof image === 'string';
const imageURL = isExternalImage
	? new URL(image, baseURL)
	: new URL(image.src, baseURL);
const imageFormat = isExternalImage
	? (imageURL.pathname.endsWith('.png') ? 'png' : 'jpeg')
	: (image.format === 'jpg' ? 'jpeg' : image.format);
const imageWidth = isExternalImage ? '1200' : String(image.width);
const imageHeight = isExternalImage ? '630' : String(image.height);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#e93323" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />


<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook / WhatsApp / Telegram -->
<meta property="og:type" content={publishedTime ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={description} />
<meta
	property="og:image:type"
	content={`image/${imageFormat}`}
/>
<meta property="og:image:width" content={imageWidth} />
<meta property="og:image:height" content={imageHeight} />
{
	publishedTime && (
		<meta property="article:published_time" content={publishedTime.toISOString()} />
	)
}
{publishedTime && author && <meta property="article:author" content={author} />}
{publishedTime && section && <meta property="article:section" content={section} />}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
