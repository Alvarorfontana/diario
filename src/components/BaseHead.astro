---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/blog-placeholder-1.jpg';
import { SITE_TITLE } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	publishedTime?: Date;
	author?: string;
	section?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const baseURL = Astro.site ?? Astro.url.origin;

const { title, description, image = FallbackImage, publishedTime, author, section } = Astro.props;

// Handle both ImageMetadata and string URLs
const isExternalImage = typeof image === 'string';
const imageURL = isExternalImage
	? new URL(image, baseURL)
	: new URL(image.src, baseURL);
const imageFormat = isExternalImage
	? (imageURL.pathname.endsWith('.png') ? 'png' : 'jpeg')
	: (image.format === 'jpg' ? 'jpeg' : image.format);
// Para fotos subidas desde el panel no se conocen las medidas reales: mejor no declararlas
// que declarar unas falsas (WhatsApp puede deformar o descartar la imagen).
// Datos estructurados (JSON-LD) para Google, Bing y asistentes de IA
const siteOrigin = new URL(baseURL.toString()).origin;
const sufijo = ` | ${SITE_TITLE}`;
const tituloLimpio = title.endsWith(sufijo) ? title.slice(0, -sufijo.length) : title;
const jsonLd = publishedTime
	? {
			'@context': 'https://schema.org',
			'@type': 'NewsArticle',
			headline: tituloLimpio.slice(0, 110),
			description,
			image: [imageURL.href],
			datePublished: publishedTime.toISOString(),
			dateModified: publishedTime.toISOString(),
			inLanguage: 'es-AR',
			...(section ? { articleSection: section } : {}),
			author: [{ '@type': 'Person', name: author || 'Redacción' }],
			publisher: { '@type': 'NewsMediaOrganization', name: SITE_TITLE, url: siteOrigin },
			mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL.href },
		}
	: {
			'@context': 'https://schema.org',
			'@graph': [
				{ '@type': 'NewsMediaOrganization', '@id': `${siteOrigin}/#organization`, name: SITE_TITLE, url: siteOrigin },
				{
					'@type': 'WebSite',
					'@id': `${siteOrigin}/#website`,
					url: siteOrigin,
					name: SITE_TITLE,
					inLanguage: 'es-AR',
					publisher: { '@id': `${siteOrigin}/#organization` },
				},
			],
		};
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
const imageWidth = isExternalImage ? undefined : String(image.width);
const imageHeight = isExternalImage ? undefined : String(image.height);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content="#e93323" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />


<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Open Graph / Facebook / WhatsApp / Telegram -->
<meta property="og:type" content={publishedTime ? 'article' : 'website'} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:alt" content={description} />
<meta
	property="og:image:type"
	content={`image/${imageFormat}`}
/>
<meta property="og:image:secure_url" content={imageURL} />
{imageWidth && <meta property="og:image:width" content={imageWidth} />}
{imageHeight && <meta property="og:image:height" content={imageHeight} />}
{
	publishedTime && (
		<meta property="article:published_time" content={publishedTime.toISOString()} />
	)
}
{publishedTime && author && <meta property="article:author" content={author} />}
{publishedTime && section && <meta property="article:section" content={section} />}

<meta property="og:locale" content="es_AR" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<link rel="alternate" type="application/xml" title="Mapa de notas" href="/sitemap-articulos.xml" />
<script type="application/ld+json" set:html={jsonLdText} is:inline></script>

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
