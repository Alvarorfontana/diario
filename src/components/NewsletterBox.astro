---
---

<section class="mt-14 rounded-sm bg-neutral-950 px-6 py-10 text-center sm:px-10">
	<h2 class="font-serif text-2xl font-bold text-white sm:text-3xl">Las noticias en tu correo</h2>
	<p class="mt-2 text-sm text-neutral-400">
		Recibe un resumen con lo más importante. Sin spam, date de baja cuando quieras.
	</p>
	<form
		id="newsletter-form"
		class="mx-auto mt-6 flex max-w-md flex-col gap-3 sm:flex-row"
	>
		<input
			type="email"
			name="email"
			required
			placeholder="tu@correo.com"
			class="w-full rounded-sm border border-neutral-700 bg-neutral-900 px-4 py-3 text-base text-white placeholder-neutral-500 focus:border-brand focus:outline-none"
		/>
		<button
			type="submit"
			id="newsletter-btn"
			class="shrink-0 rounded-sm bg-brand px-6 py-3 font-medium text-white transition-colors hover:bg-brand-dark"
		>
			Suscribirme
		</button>
	</form>
	<p id="newsletter-status" class="mt-3 text-sm hidden"></p>
	<p class="mt-3 text-xs text-neutral-500">
		Al suscribirte aceptas nuestra
		<a href="/legal/politica-privacidad/" class="underline transition-colors hover:text-brand"
			>política de privacidad</a
		>.
	</p>
</section>

<script is:inline>
	document.getElementById('newsletter-form')?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const btn = document.getElementById('newsletter-btn');
		const status = document.getElementById('newsletter-status');
		const email = e.target.querySelector('input[name="email"]').value;

		btn.disabled = true;
		btn.textContent = 'Enviando...';
		status.className = 'mt-3 text-sm hidden';

		try {
			const res = await fetch('/api/newsletter/subscribe', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email }),
			});
			const data = await res.json();

			status.className = 'mt-3 text-sm';
			if (data.ok) {
				status.textContent = data.message || '¡Gracias por suscribirte!';
				status.style.color = '#22c55e';
				e.target.querySelector('input[name="email"]').value = '';
			} else {
				status.textContent = data.error || 'Error al suscribirte.';
				status.style.color = '#ef4444';
			}
		} catch {
			status.className = 'mt-3 text-sm';
			status.textContent = 'Error de conexión.';
			status.style.color = '#ef4444';
		}

		btn.disabled = false;
		btn.textContent = 'Suscribirme';
	});
</script>
