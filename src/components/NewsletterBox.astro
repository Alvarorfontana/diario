---
---

<section class="mt-14 rounded-sm bg-neutral-950 px-6 py-10 text-center sm:px-10">
	<h2 class="font-serif text-2xl font-bold text-white sm:text-3xl">Las noticias en tu correo</h2>
	<p class="mt-2 text-sm text-neutral-400">
		Recibe un resumen con lo más importante. Sin spam, date de baja cuando quieras.
	</p>
	<form
		id="newsletter-form"
		class="mx-auto mt-6 flex max-w-md flex-col gap-3"
		novalidate
	>
		<!-- Trampa anti-robots: oculta para personas, tentadora para bots. -->
		<div class="hidden" aria-hidden="true">
			<input type="text" name="website" tabindex="-1" autocomplete="off" />
		</div>
		<div class="flex flex-col gap-3 sm:flex-row">
			<input
				type="email"
				name="email"
				required
				autocomplete="email"
				placeholder="tu@correo.com"
				class="w-full rounded-sm border border-neutral-700 bg-neutral-900 px-4 py-3 text-base text-white placeholder-neutral-500 focus:border-brand focus:outline-none"
			/>
			<button
				type="submit"
				id="newsletter-btn"
				class="shrink-0 rounded-sm bg-brand px-6 py-3 font-medium text-white transition-colors hover:bg-brand-dark"
			>
				Suscribirme
			</button>
		</div>
		<label class="flex items-start gap-2 text-left text-xs leading-relaxed text-neutral-400">
			<input type="checkbox" name="consent" required class="mt-0.5 h-4 w-4 shrink-0 accent-brand" />
			<span>
				Acepto recibir el boletín y haber leído la
				<a href="/legal/politica-privacidad/" class="underline transition-colors hover:text-brand"
					>política de privacidad</a
				>.
			</span>
		</label>
	</form>
	<p id="newsletter-status" class="mt-3 hidden text-sm" role="status" aria-live="polite"></p>
</section>

<script is:inline>
	document.getElementById('newsletter-form')?.addEventListener('submit', async (e) => {
		e.preventDefault();
		const form = e.target;
		const btn = document.getElementById('newsletter-btn');
		const status = document.getElementById('newsletter-status');
		const data = new FormData(form);
		const email = String(data.get('email') || '').trim();
		const consent = data.get('consent') === 'on';
		const website = String(data.get('website') || '');

		status.className = 'mt-3 text-sm';
		status.style.color = '#ef4444';
		if (!email || !email.includes('@')) {
			status.textContent = 'Revisá el correo.';
			return;
		}
		if (!consent) {
			status.textContent = 'Marcá la casilla para aceptar recibir el boletín.';
			return;
		}

		btn.disabled = true;
		btn.textContent = 'Enviando...';
		status.className = 'mt-3 hidden text-sm';

		try {
			const res = await fetch('/api/newsletter/subscribe', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ email, consent, website }),
			});
			const out = await res.json();

			status.className = 'mt-3 text-sm';
			if (out.ok) {
				status.textContent = out.message || '¡Gracias por suscribirte!';
				status.style.color = '#22c55e';
				form.querySelector('input[name="email"]').value = '';
			} else {
				status.textContent = out.error || 'Error al suscribirte.';
				status.style.color = '#ef4444';
			}
		} catch {
			status.className = 'mt-3 text-sm';
			status.textContent = 'Error de conexión.';
			status.style.color = '#ef4444';
		}

		btn.disabled = false;
		btn.textContent = 'Suscribirme';
	});
</script>
