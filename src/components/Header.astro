---
import { SITE_TITLE, SECCIONES_MENU } from '../consts';

const { pathname } = Astro.url;

// Fecha del día, chiquita y en gris al lado del logo (formato 14/11/26, hora argentina).
const fechaCorta = (d: Date) =>
	d.toLocaleDateString('es-AR', { day: 'numeric', month: 'numeric', year: '2-digit', timeZone: 'America/Argentina/Buenos_Aires' });
const hoy = fechaCorta(new Date());

// Menú desplegable: pocas secciones y los especiales del diario.
const especiales = [
	{ href: '/brasil-2026/', nombre: 'Brasil 2026' },
	{ href: '/flash/', nombre: 'Flash' },
	{ href: '/boletines/', nombre: 'Boletín' },
	{ href: '/canal/', nombre: 'Canal' },
	{ href: '/contexto-politico/', nombre: 'Contexto Político' },
];
---

<!-- Cabecera: menú desplegable a la izquierda, logo con la fecha chiquita, fija al bajar -->
<header class="sticky top-0 z-40 bg-white shadow-[0_1px_0_#e6e6e2]">
	<div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-2.5">
		<div class="flex min-w-0 items-center gap-3">
			<details class="menu-secciones relative">
				<summary aria-label="Secciones" class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full bg-[#f0f0ec] text-ink transition-colors hover:bg-neutral-200">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
				</summary>
				<nav aria-label="Secciones" class="absolute left-0 top-[calc(100%+8px)] w-60 rounded-2xl border border-[#e6e6e2] bg-white p-2 shadow-[0_12px_32px_rgba(0,0,0,0.12)]">
					<ul class="text-[15px] font-semibold text-ink">
						{SECCIONES_MENU.map((s) => (
							<li><a href={`/seccion/${s.id}/`} class="block rounded-lg px-3 py-2.5 hover:bg-[#f0f0ec]" aria-current={pathname.startsWith(`/seccion/${s.id}`) ? 'page' : undefined}>{s.nombre}</a></li>
						))}
					</ul>
					<ul class="mt-1 border-t border-[#eeeeea] pt-1 text-sm text-neutral-600">
						{especiales.map((e) => (
							<li><a href={e.href} class="block rounded-lg px-3 py-2 hover:bg-[#f0f0ec] hover:text-ink" aria-current={pathname.startsWith(e.href) ? 'page' : undefined}>{e.nombre}</a></li>
						))}
					</ul>
				</nav>
			</details>
			<a href="/" class="flex items-center gap-2 font-display text-[1.6rem] leading-none font-extrabold tracking-[-0.02em] text-ink sm:text-[2rem]">
				<span class="inline-block h-3 w-3 rounded-[3px] bg-brand sm:h-3.5 sm:w-3.5" aria-hidden="true"></span>{SITE_TITLE}
			</a>
			<span id="fecha-hoy" class="self-end pb-0.5 text-[10px] font-normal tracking-wide text-neutral-400 sm:text-[11px]">{hoy}</span>
		</div>
		<div class="flex items-center gap-2">
			<a href="/buscar/" aria-label="Buscar" class="flex h-11 w-11 items-center justify-center rounded-full bg-[#f0f0ec] text-ink transition-colors hover:bg-neutral-200">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
			</a>
			<a href="/#newsletter" class="hidden rounded-full bg-ink px-4 py-2.5 text-sm font-bold text-white transition-colors hover:bg-brand sm:inline-block">Suscribite</a>
		</div>
	</div>
</header>

<script is:inline>
	// La fecha se actualiza sola en el navegador (también en páginas armadas de antemano).
	(function () {
		var el = document.getElementById('fecha-hoy');
		if (el) el.textContent = new Date().toLocaleDateString('es-AR', { day: 'numeric', month: 'numeric', year: '2-digit', timeZone: 'America/Argentina/Buenos_Aires' });
		// Cerrar el menú al tocar afuera.
		document.addEventListener('click', function (ev) {
			document.querySelectorAll('details.menu-secciones[open]').forEach(function (d) {
				if (!d.contains(ev.target)) d.removeAttribute('open');
			});
		});
	})();
</script>

<style>
	.menu-secciones summary::-webkit-details-marker { display: none; }
</style>
