---
// "Sobre la firma" al final de la nota (estilo El País): foto en blanco y negro,
// nombre y biografía desplegable. Si el autor no tiene bio cargada en AUTORES
// (src/consts.ts), solo se muestra el enlace a todas sus notas.
import { AUTORES, fotoAutor, slugify } from '../consts';

interface Props {
	author?: string;
}
const nombre = Astro.props.author || 'Redacción';
const bio = AUTORES[nombre]?.bio;
const foto = fotoAutor(nombre) ?? '/autores/foto-provisoria.svg';
const enlace = `/autor/${slugify(nombre)}/`;
---

<section class="sobre-firma mt-10" aria-label="Sobre la firma" data-no-imprimir>
	<h2 class="border-b border-neutral-300 pb-2 font-sans text-[13px] font-extrabold tracking-[0.08em] text-ink uppercase">
		<span class="-mb-[10px] inline-block border-b-[3px] border-ink pb-2">Sobre la firma</span>
	</h2>
	<div class="mt-5 flex items-start gap-4">
		<a href={enlace} class="shrink-0">
			<img src={foto} alt={`Foto de ${nombre}`} width="80" height="80" class={`h-20 w-20 object-cover ${foto.includes("/autores/redaccion") ? "rounded-md" : "rounded-full bg-neutral-200 grayscale"}`} loading="lazy" />
		</a>
		<div class="min-w-0 flex-1">
			<a href={enlace} class="font-display text-[22px] leading-tight font-bold text-ink hover:text-brand">{nombre}</a>
			{bio ? (
				<details class="group mt-3">
					<summary class="inline-flex cursor-pointer list-none items-center gap-2 rounded-sm bg-ink px-3.5 py-2 font-sans text-[12px] font-bold tracking-[0.06em] text-white uppercase select-none [&::-webkit-details-marker]:hidden">
						Ver biografía
						<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" class="transition-transform group-open:rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
					</summary>
					<p class="mt-3 text-[15px] leading-relaxed text-neutral-700">{bio}</p>
					<a href={enlace} class="mt-2 inline-block font-sans text-[13px] font-semibold text-brand">Ver todas sus notas →</a>
				</details>
			) : (
				<a href={enlace} class="mt-2 inline-block font-sans text-[13px] font-semibold text-brand">Ver todas sus notas →</a>
			)}
		</div>
	</div>
</section>
