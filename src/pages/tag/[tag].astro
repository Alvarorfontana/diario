---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE, slugify } from '../../consts';
import { getArticulos } from '../../lib/articles';

export const prerender = false;

const { tag } = Astro.params;
if (!tag) {
	return Astro.redirect('/404');
}

const todos = await getArticulos();

// Normalizar tags: pueden venir como array o como texto separado por comas
function obtenerTags(articulo: any): string[] {
	const t = articulo.tags;
	if (Array.isArray(t)) return t;
	if (typeof t === 'string' && t.trim()) return t.split(',').map((s: string) => s.trim());
	return [];
}

// Filtrar artículos que tengan esta etiqueta
const arts = todos.filter((a: any) =>
	obtenerTags(a).some((t: string) => slugify(t) === tag)
);

// Recuperar el nombre original (con acentos) desde el primer artículo
const nombre = arts[0]
	? obtenerTags(arts[0]).find((t: string) => slugify(t) === tag)
	: null;
---

<BaseLayout title={`#${nombre ?? tag} | ${SITE_TITLE}`} description={`Noticias etiquetadas como ${nombre ?? tag}.`} image={arts[0]?.image_url}>
	<h1 class="border-b-2 border-neutral-900 pb-3 font-serif text-3xl font-bold sm:text-4xl">
		<span class="text-brand">#</span>{nombre ?? tag}
	</h1>

	{
		arts.length === 0 ? (
			<p class="py-12 text-center text-neutral-500">No hay noticias con esta etiqueta.</p>
		) : (
			<div class="divide-y divide-neutral-200 border-t border-neutral-200">
				{arts.map((articulo: any) => (
					<article class="py-8">
						<a href={`/articulo/${articulo.slug}/`} class="group block">
							<h2 class="font-serif text-2xl leading-snug font-bold text-neutral-900 transition-colors group-hover:text-brand">
								{articulo.title}
							</h2>
							<p class="mt-2 text-sm leading-relaxed text-neutral-600">
								{articulo.excerpt}
							</p>
							<p class="mt-2 text-xs text-neutral-400">
								<FormattedDate date={articulo.date} /> · {articulo.author}
							</p>
						</a>
					</article>
				))}
			</div>
		)
	}
</BaseLayout>
