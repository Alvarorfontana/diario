---
import BaseLayout from "../layouts/BaseLayout.astro";
import latest from "../../data/boletines/latest.json";

const disponible = Boolean(latest?.archivo);
const duracion = (s) => {
  const m = Math.floor((s || 0) / 60);
  const ss = String((s || 0) % 60).padStart(2, "0");
  return `${m}:${ss}`;
};
---

<BaseLayout title="Boletines | Diario Federal" description="Boletines informativos de Diario Federal para escuchar." image={latest?.tapa || undefined}>
  <main class="mx-auto max-w-3xl pb-12">
    <header class="flex items-center gap-4 border-b border-neutral-200 pb-6">
      <img src="/boletines/logo.svg" alt="Diario Federal" width="220" height="56" class="w-48 max-w-[55%]" />
      <div class="ml-auto text-right">
        <p class="text-xs font-bold uppercase tracking-widest text-red-700">Audio</p>
        <p class="text-sm text-neutral-500">Información diaria</p>
      </div>
    </header>
    <p class="mt-8 text-xs font-bold uppercase tracking-[.14em] text-red-700">Boletín informativo</p>
    <h1 class="mt-2 font-display text-3xl font-extrabold leading-tight text-neutral-950 sm:text-4xl">La actualidad en pocos minutos</h1>
    <p class="mt-3 max-w-2xl text-base leading-relaxed text-neutral-600">Las noticias nacionales e internacionales seleccionadas por la redacción de Diario Federal.</p>
    {disponible ? (
      <section class="mt-8 rounded-2xl border border-neutral-200 bg-white p-5 shadow-sm">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <p class="text-sm font-bold text-red-700">EDICIÓN PRINCIPAL</p>
          <p class="text-sm text-neutral-500">{latest.dateLabel} · {duracion(latest.duracion)}</p>
        </div>
        <h2 class="mt-3 text-xl font-bold text-neutral-950">{latest.title}</h2>
        <audio class="mt-5 w-full" controls preload="none">
          <source src={latest.archivo} type="audio/mpeg" />
          Tu navegador no puede reproducir este audio.
        </audio>
        <div class="mt-4 flex flex-wrap items-center gap-3">
          <a class="inline-flex text-sm font-semibold text-red-700 underline underline-offset-4" href={latest.archivo} download>Descargar boletín MP3</a>
          <button id="compartir-boletin" type="button" class="inline-flex items-center gap-2 rounded-full bg-neutral-950 px-4 py-2.5 text-sm font-bold text-white hover:bg-red-700">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><path d="m8.6 10.7 6.8-4.4M8.6 13.3l6.8 4.4"></path></svg>
            Compartir boletín
          </button>
          {latest.video && (
            <button id="whatsapp-boletin" type="button" data-video={latest.video} data-nombre={`flash-informativo-${latest.date}.mp4`} class="inline-flex items-center gap-2 rounded-full bg-[#25D366] px-4 py-2.5 text-sm font-bold text-neutral-950 hover:bg-[#1ebe5b]">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.4-.2Z"/></svg>
              Pasar por WhatsApp
            </button>
          )}
          {latest.video && <a class="inline-flex text-sm font-semibold text-red-700 underline underline-offset-4" href={latest.video} download>Descargar video con tapa</a>}
          <span id="estado-compartir" class="text-xs text-neutral-500" aria-live="polite"></span>
        </div>
        <div class="mt-6 border-t border-neutral-200 pt-5">
          <h3 class="text-sm font-bold text-neutral-900">Las seis noticias de esta edición</h3>
          <ol class="mt-3 space-y-3">
            {latest.items.map((item, i) => (
              <li class="flex gap-3">
                <span class="text-sm font-bold text-red-700">{String(i + 1).padStart(2, "0")}</span>
                <div>
                  <p class="font-semibold text-neutral-900">{item.title}</p>
                  <a href={item.url} class="text-xs text-neutral-500 underline underline-offset-2">Leer la noticia</a>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>
    ) : (
      <section class="mt-8 rounded-2xl border border-neutral-200 bg-neutral-50 p-6">
        <h2 class="font-bold text-neutral-900">Próximo boletín en preparación</h2>
        <p class="mt-2 text-sm leading-relaxed text-neutral-600">La edición aparecerá aquí cuando finalice la primera generación automática.</p>
      </section>
    )}
    <p class="mt-8 text-xs text-neutral-500">Diario Federal · Periodismo con mirada nacional y federal.</p>
  </main>
    <script>
      const shareButton = document.getElementById("compartir-boletin");
      const shareStatus = document.getElementById("estado-compartir");
      shareButton?.addEventListener("click", async () => {
        const shareData = {
          title: "Boletín informativo · Diario Federal",
          text: "Escuchá el boletín de Diario Federal.",
          url: new URL("/boletines/", window.location.origin).href
        };
        try {
          if (navigator.share) {
            await navigator.share(shareData);
          } else if (navigator.clipboard) {
            await navigator.clipboard.writeText(shareData.url);
            shareStatus.textContent = "Enlace copiado para compartir.";
          } else {
            shareStatus.textContent = "Usá el enlace de esta página para compartir.";
          }
        } catch (error) {
          if (error?.name !== "AbortError") shareStatus.textContent = "No se pudo abrir la opción de compartir.";
        }
      });

      // Comparte el video (tapa + audio) directo a WhatsApp desde el celular.
      const waButton = document.getElementById("whatsapp-boletin");
      waButton?.addEventListener("click", async () => {
        const url = new URL("/boletines/", window.location.origin).href;
        const texto = "Flash informativo de Diario Federal. Escuchalo acá: " + url;
        try {
          shareStatus.textContent = "Preparando el video…";
          const r = await fetch(waButton.dataset.video);
          const blob = await r.blob();
          const file = new File([blob], waButton.dataset.nombre || "flash-informativo.mp4", { type: "video/mp4" });
          if (navigator.canShare && navigator.canShare({ files: [file] })) {
            await navigator.share({ files: [file], text: texto });
            shareStatus.textContent = "";
            return;
          }
        } catch (error) {
          if (error?.name === "AbortError") { shareStatus.textContent = ""; return; }
        }
        // En computadora: abre WhatsApp con el enlace (la vista previa muestra la tapa).
        shareStatus.textContent = "";
        window.open("https://wa.me/?text=" + encodeURIComponent(texto), "_blank", "noopener");
      });
    </script>
</BaseLayout>
