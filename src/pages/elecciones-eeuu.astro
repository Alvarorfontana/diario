<script is:inline type="module">
  import { geoAlbersUsa, geoPath } from 'https://cdn.jsdelivr.net/npm/d3-geo@3/+esm';
  import { feature } from 'https://cdn.jsdelivr.net/npm/topojson-client@3/+esm';

  const GEO_URL = 'https://cdn.jsdelivr.net/npm/us-atlas@3/states-10m.json';
  const FIPS = {
    '01':'AL','02':'AK','04':'AZ','05':'AR','06':'CA','08':'CO','09':'CT','10':'DE','12':'FL','13':'GA',
    '15':'HI','16':'ID','17':'IL','18':'IN','19':'IA','20':'KS','21':'KY','22':'LA','23':'ME','24':'MD',
    '25':'MA','26':'MI','27':'MN','28':'MS','29':'MO','30':'MT','31':'NE','32':'NV','33':'NH','34':'NJ',
    '35':'NM','36':'NY','37':'NC','38':'ND','39':'OH','40':'OK','41':'OR','42':'PA','44':'RI','45':'SC',
    '46':'SD','47':'TN','48':'TX','49':'UT','50':'VT','51':'VA','53':'WA','54':'WV','55':'WI','56':'WY'
  };
  const NAMES = {
    AL:'Alabama',AK:'Alaska',AZ:'Arizona',AR:'Arkansas',CA:'California',CO:'Colorado',CT:'Connecticut',DE:'Delaware',FL:'Florida',GA:'Georgia',
    HI:'Hawái',ID:'Idaho',IL:'Illinois',IN:'Indiana',IA:'Iowa',KS:'Kansas',KY:'Kentucky',LA:'Luisiana',ME:'Maine',MD:'Maryland',
    MA:'Massachusetts',MI:'Michigan',MN:'Minnesota',MS:'Misisipi',MO:'Misuri',MT:'Montana',NE:'Nebraska',NV:'Nevada',NH:'Nuevo Hampshire',NJ:'Nueva Jersey',
    NM:'Nuevo México',NY:'Nueva York',NC:'Carolina del Norte',ND:'Dakota del Norte',OH:'Ohio',OK:'Oklahoma',OR:'Oregon',PA:'Pensilvania',RI:'Rhode Island',SC:'Carolina del Sur',
    SD:'Dakota del Sur',TN:'Tennessee',TX:'Texas',UT:'Utah',VT:'Vermont',VA:'Virginia',WA:'Washington',WV:'Virginia Occidental',WI:'Wisconsin',WY:'Wyoming'
  };
  const statePaths = new Map();
  let selectedState = null;
  let allRaceData = [];
  let activeRaceTab = 'all';
  let raceSearchTerm = '';

  const $ = (id) => document.getElementById(id);
  const stateCode = (f) => FIPS[String(f.id).padStart(2,'0')];
  const liveByState = new Map();
  const stateNameToCode = Object.fromEntries(Object.entries(NAMES).flatMap(([code,name]) => [[name.toLowerCase(),code],[code.toLowerCase(),code]]));
  const PARTY_COLORS = { REP:'#c64b50', REPUBLICAN:'#c64b50', R:'#c64b50', DEM:'#3978c5', DEMOCRAT:'#3978c5', D:'#3978c5', IND:'#9272a8', INDEPENDENT:'#9272a8' };
  const clean = value => String(value ?? '').trim();
  function partyCode(candidate) {
    const raw = candidate?.party ?? candidate?.party_code ?? candidate?.party_name ?? candidate?.affiliation;
    const party = clean(typeof raw === 'object' ? (raw.name || raw.abbreviation || raw.code || '') : raw).toUpperCase();
    if (party.includes('REP') || party === 'R' || party.includes('GOP')) return 'REP';
    if (party.includes('DEM') || party === 'D') return 'DEM';
    if (party.includes('IND')) return 'IND';
    return party || 'OTHER';
  }
  function candidateVotes(candidate) {
    const raw = candidate?.votes ?? candidate?.vote_count ?? candidate?.total_votes ?? candidate?.vote_total ?? candidate?.votes_received ?? candidate?.voteCount ?? candidate?.totalVotes ?? candidate?.count;
    const n = Number(String(raw ?? '').replace(/,/g,''));
    return Number.isFinite(n) ? n : 0;
  }
  function inferState(race) {
    const directValue = race?.province || race?.state || race?.state_code || race?.statePostal || race?.state_postal || race?.state_abbr || race?.jurisdiction_code;
    const direct = clean(typeof directValue === 'object' ? (directValue.abbreviation || directValue.code || directValue.name || '') : directValue).toUpperCase();
    if (NAMES[direct]) return direct;
    const district = race?.district_details || race?.district || {};
    const locationValue = race?.location || race?.jurisdiction || race?.region || race?.province_name || race?.state_name || race?.name || district?.district_name || district?.name;
    const location = clean(typeof locationValue === 'object' ? (locationValue.name || locationValue.label || '') : locationValue);
    const normalized = location.toLowerCase();
    for (const [name,code] of Object.entries(stateNameToCode)) {
      if (normalized.includes(name)) return code;
    }
    const match = normalized.match(/\b([a-z]{2})\b/);
    return match && NAMES[match[1].toUpperCase()] ? match[1].toUpperCase() : null;
  }
  function raceCandidates(race) {
    const value = race?.candidates || race?.contenders || race?.results || race?.candidate_results || race?.race_results;
    return Array.isArray(value) ? value : [];
  }
  function racePriority(race) {
    const name = clean(race?.race_name || race?.name || race?.title || race?.office || race?.office_title || race?.contest || race?.description || race?.election_type || race?.race_type || race?.type).toLowerCase();
    if (name.includes('governor')) return 1;
    if (name.includes('u.s. senate') || name.includes('us senate') || name.includes('senate')) return 2;
    if (name.includes('u.s. house') || name.includes('us house') || name.includes('house') || name.includes('congressional district')) return 3;
    return 4;
  }
  function extractRaces(payload) {
    const found = [];
    const seen = new Set();
    function walk(node) {
      if (!node || typeof node !== 'object' || seen.has(node)) return;
      seen.add(node);
      if (Array.isArray(node)) {
        node.forEach(walk);
        return;
      }
      if (raceCandidates(node).length) found.push(node);
      Object.values(node).forEach(walk);
    }
    walk(payload);
    return found;
  }

  function renderRaceExplorer(races) {
    allRaceData = Array.isArray(races) ? races : [];
    const body = $('race-table-body');
    if (!body) return;
    const filtered = allRaceData.filter(race => {
      const priority = racePriority(race);
      const tabMatch = activeRaceTab === 'all' ||
        (activeRaceTab === 'governor' && priority === 1) ||
        (activeRaceTab === 'senate' && priority === 2) ||
        (activeRaceTab === 'house' && priority === 3);
      const candidates = raceCandidates(race);
      const haystack = [race.race_name,race.name,race.title,race.office,race.contest,race.state,race.province,race.district,
        ...candidates.map(x => x.name || x.candidate_name || x.full_name)].join(' ').toLowerCase();
      return tabMatch && haystack.includes(raceSearchTerm);
    });
    $('race-count').textContent = filtered.length + ' CONTIENDAS';
    body.replaceChildren();
    if (!filtered.length) {
      const tr = document.createElement('tr'); const td = document.createElement('td');
      td.colSpan = 3; td.className = 'race-empty';
      td.textContent = allRaceData.length ? 'No hay contiendas que coincidan con la búsqueda.' : 'La conexión está preparada. Las contiendas aparecerán cuando civicAPI publique sus registros.';
      tr.appendChild(td); body.appendChild(tr); return;
    }
    filtered.sort((a,b) => racePriority(a)-racePriority(b) || String(a.race_name||a.name||'').localeCompare(String(b.race_name||b.name||'')));
    filtered.forEach(race => {
      const tr = document.createElement('tr');
      const name = document.createElement('td');
      name.textContent = clean(race.race_name || race.name || race.title || race.office || race.contest || 'Contienda');
      const candidateCell = document.createElement('td');
      const candidates = raceCandidates(race).map(candidate => ({
        name: clean(candidate.name || candidate.candidate_name || candidate.full_name || candidate.display_name) || 'Candidato',
        party: partyCode(candidate), votes: candidateVotes(candidate)
      })).sort((a,b) => b.votes-a.votes);
      if (!candidates.length) candidateCell.textContent = 'Candidaturas aún no publicadas';
      candidates.slice(0,5).forEach((candidate,index) => {
        const line = document.createElement('div'); line.className = 'race-candidate' + (index===0 && candidate.votes>0 ? ' leader':'');
        const label = document.createElement('span'); const dot = document.createElement('i');
        dot.className = 'race-party'; dot.style.background = PARTY_COLORS[candidate.party] || '#9272a8';
        label.append(dot, document.createTextNode(candidate.name + ' · ' + candidate.party));
        const votes = document.createElement('strong'); votes.textContent = candidate.votes ? candidate.votes.toLocaleString('en-US') : '—';
        line.append(label,votes); candidateCell.appendChild(line);
      });
      const status = document.createElement('td');
      status.textContent = clean(race.status || race.race_status || race.call_status || 'Sin declarar');
      tr.append(name,candidateCell,status); body.appendChild(tr);
    });
  }

  function updateMapFromRaces(races) {
    renderRaceExplorer(races);
    const grouped = new Map();
    for (const race of races) {
      const code = inferState(race);
      const candidates = raceCandidates(race).map(candidate => ({
        name: clean(candidate.name || candidate.candidate_name || candidate.full_name || candidate.display_name) || 'Candidato',
        party: partyCode(candidate),
        votes: candidateVotes(candidate),
        percent: candidate.vote_percentage ?? candidate.percentage ?? candidate.pct
      })).filter(candidate => candidate.name !== 'Candidato' || candidate.votes > 0);
      if (!code || candidates.length < 2 || candidates.every(candidate => candidate.votes === 0)) continue;
      candidates.sort((a,b) => b.votes - a.votes);
      const item = {
        code,
        name: clean(race.race_name || race.name || race.title || race.office || race.contest) || 'Contienda estatal',
        status: clean(race.status || race.race_status || race.call_status || 'Conteo parcial'),
        reporting: race.percent_reporting ?? race.reporting_pct ?? race.precincts_reporting ?? race.pct_reporting ?? null,
        totalVotes: candidates.reduce((sum,candidate) => sum + candidate.votes,0),
        candidates,
        party: candidates[0].party,
        priority: racePriority(race),
        updated: race.updated_at || race.last_updated || race.timestamp || null
      };
      if (!grouped.has(code)) grouped.set(code, []);
      grouped.get(code).push(item);
    }
    liveByState.clear();
    for (const [code, items] of grouped) {
      items.sort((a,b) => a.priority - b.priority || b.totalVotes - a.totalVotes);
      liveByState.set(code, items[0]);
    }
    renderMap();
    const total = liveByState.size;
    $('civicapi-status').textContent = total ? 'DATOS RECIBIDOS' : 'ESPERANDO RECUENTOS';
    $('live-label').textContent = total ? 'RESULTADOS PARCIALES · civicAPI' : 'CONECTADO · AÚN SIN RECUENTOS';
    $('live-label').parentElement.classList.toggle('is-live', total > 0);
    $('civicapi-refresh-time').textContent = 'Última consulta: ' + new Date().toLocaleTimeString('es-AR',{hour:'2-digit',minute:'2-digit'});
    $('updated-at').textContent = total + ' estados con datos de contiendas publicadas por civicAPI.';
  }
  function electionColor(code) {
    const result = liveByState.get(code);
    return result ? (PARTY_COLORS[result.party] || '#9272a8') : '#d9dee5';
  }
  function renderMap() {
    for (const [code, path] of statePaths) {
      path.setAttribute('fill', electionColor(code));
      path.classList.toggle('selected', selectedState === code);
    }
    $('states-live').textContent = String(liveByState.size);
    $('house-r').textContent = '435';
    $('house-d').textContent = '35';
    if (selectedState) renderDetail(selectedState);
  }
  function renderDetail(code) {
    $('detail-title').textContent = NAMES[code] || code;
    const result = liveByState.get(code);
    if (!result) {
      $('detail-status').textContent = 'civicAPI todavía no publica recuentos suficientes para este estado. Se actualizará automáticamente.';
      $('detail-races').innerHTML = '<p class="detail-status">Fuente: <a href="https://civicapi.org/results" target="_blank" rel="noopener noreferrer">civicAPI ↗</a></p>';
      return;
    }
    $('detail-status').textContent = result.name + ' · ' + result.status + (result.reporting != null ? ' · ' + result.reporting + '% informado' : '');
    const card = document.createElement('div');
    card.className = 'race-card';
    const heading = document.createElement('h4');
    heading.textContent = 'Liderazgo parcial · ' + result.name;
    card.appendChild(heading);
    result.candidates.slice(0,4).forEach(candidate => {
      const row = document.createElement('div');
      row.className = 'candidate-row';
      const label = document.createElement('span');
      const dot = document.createElement('i');
      dot.className = 'party-dot';
      dot.style.background = PARTY_COLORS[candidate.party] || '#9272a8';
      label.append(dot, document.createTextNode(candidate.name + ' (' + candidate.party + ')'));
      const votes = document.createElement('strong');
      votes.textContent = candidate.votes.toLocaleString('en-US');
      row.append(label, votes);
      card.appendChild(row);
    });
    const source = document.createElement('p');
    source.className = 'detail-status';
    source.append('Fuente: civicAPI · recuento no certificado. ');
    const link = document.createElement('a');
    link.href = 'https://civicapi.org/results';
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    link.textContent = 'Ver fuente ↗';
    source.appendChild(link);
    card.appendChild(source);
    $('detail-races').replaceChildren(card);
  }
  async function refreshElectionData() {
    const status = $('civicapi-status');
    try {
      status.textContent = 'ACTUALIZANDO';
      const response = await fetch('/api/election-results.json', {cache:'no-store'});
      if (!response.ok) throw new Error('civicAPI respondió HTTP ' + response.status);
      const payload = await response.json();
      let races = extractRaces(payload);
      // Si el buscador entrega solo referencias, consultar los detalles de las contiendas.
      if (!races.length) {
        const refs = [];
        function collectRefs(node) {
          if (!node || typeof node !== 'object') return;
          if (Array.isArray(node)) return node.forEach(collectRefs);
          const id = node.race_id ?? node.raceId ?? node.id;
          const name = clean(node.race_name || node.name || node.title || node.office || '');
          if (id && name && /governor|senate|house/i.test(name)) refs.push({id,name});
          Object.values(node).forEach(collectRefs);
        }
        collectRefs(payload);
        const unique = [...new Map(refs.map(ref => [String(ref.id),ref])).values()].slice(0,180);
        for (let i=0;i<unique.length;i+=8) {
          const batch = await Promise.all(unique.slice(i,i+8).map(async ref => {
            try {
              const detail = await fetch('/api/election-results.json?id=' + encodeURIComponent(ref.id), {cache:'no-store'});
              return detail.ok ? await detail.json() : null;
            } catch { return null; }
          }));
          races.push(...batch.filter(Boolean).flatMap(extractRaces));
        }
      }
      updateMapFromRaces(races);
      if (!races.length) $('civicapi-refresh-time').textContent = 'Conexión activa; esperando datos de las contiendas.';
    } catch (error) {
      status.textContent = 'FUENTE NO DISPONIBLE';
      $('civicapi-refresh-time').textContent = 'No se pudo actualizar: ' + error.message;
      $('live-label').textContent = 'SIN CONEXIÓN CON civicAPI';
      $('live-label').parentElement.classList.remove('is-live');
      console.error('[Diario Federal civicAPI]', error);
    }
  }
  function drawStates(topology) {
    const collection = feature(topology, topology.objects.states);
    const svg = $('us-map');
    const projection = geoAlbersUsa().fitSize([940,570], collection);
    const pathGenerator = geoPath(projection);
    const ns = 'http://www.w3.org/2000/svg';
    collection.features.forEach(f => {
      const code = stateCode(f);
      if (!code) return;
      const path = document.createElementNS(ns,'path');
      path.setAttribute('d',pathGenerator(f));
      path.setAttribute('class','state-shape');
      path.setAttribute('fill',electionColor(code));
      path.setAttribute('tabindex','0');
      path.setAttribute('role','button');
      path.setAttribute('aria-label',NAMES[code] || code);
      const title = document.createElementNS(ns,'title');
      title.textContent = NAMES[code] + ' · resultados 3 de noviembre de 2026';
      path.appendChild(title);
      svg.appendChild(path);
      const centroid = pathGenerator.centroid(f);
      if (Number.isFinite(centroid[0]) && Number.isFinite(centroid[1])) {
        const label = document.createElementNS(ns,'text');
        label.setAttribute('x',centroid[0]);
        label.setAttribute('y',centroid[1] + 3);
        label.setAttribute('class','state-label');
        label.textContent = code;
        svg.appendChild(label);
      }
      path.addEventListener('click', () => { selectedState = code; renderMap(); });
      path.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectedState = code; renderMap(); } });
      statePaths.set(code,path);
    });
    $('map-loading').classList.add('hidden');
    renderMap();
    refreshElectionData();
    window.setInterval(refreshElectionData, 15000);
  }
  function drawCartogramFallback() {
    const svg = $('us-map');
    svg.style.display = 'none';
    const canvas = $('map-canvas');
    const grid = document.createElement('div');
    grid.className = 'cartogram-fallback';
    Object.keys(NAMES).sort().forEach(code => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'cartogram-state';
      button.textContent = code;
      button.title = NAMES[code];
      button.setAttribute('aria-label',NAMES[code]);
      button.addEventListener('click', () => {
        selectedState = code;
        grid.querySelectorAll('.cartogram-state').forEach(item => item.classList.toggle('selected', item === button));
        renderDetail(code);
      });
      grid.appendChild(button);
    });
    const caption = document.createElement('p');
    caption.className = 'cartogram-caption';
    caption.textContent = 'Seleccioná cualquiera de los 50 estados. Los colores se actualizan cuando civicAPI publica recuentos verificables de 2026.';
    canvas.appendChild(grid);
    canvas.appendChild(caption);
    $('map-loading').classList.add('hidden');
    $('live-label').textContent = 'MAPA DE RESPALDO · civicAPI';
    refreshElectionData();
    window.setInterval(refreshElectionData, 15000);
  }

  document.querySelectorAll('[data-race-tab]').forEach(button => button.addEventListener('click', () => {
    activeRaceTab = button.dataset.raceTab;
    document.querySelectorAll('[data-race-tab]').forEach(item => item.classList.toggle('active', item === button));
    renderRaceExplorer(allRaceData);
  }));
  $('race-search')?.addEventListener('input', event => {
    raceSearchTerm = event.target.value.trim().toLowerCase();
    renderRaceExplorer(allRaceData);
  });

  try {
    const response = await fetch(GEO_URL, {cache:'no-store'});
    if (!response.ok) throw new Error('No se pudo cargar la geometría');
    const topology = await response.json();
    if (!topology?.objects?.states) throw new Error('La geometría no contiene estados');
    drawStates(topology);
  } catch (error) {
    $('map-loading').textContent = 'No se pudo cargar la geometría; mostrando los 50 estados en vista alternativa…';
    console.error('[Diario Federal elecciones]',error);
    drawCartogramFallback();
  }
</script>
