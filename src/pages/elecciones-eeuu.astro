---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = false;
---

<BaseLayout
  title="Elecciones Estados Unidos 2026 | Mapa en vivo — Diario Federal"
  description="Seguimiento interactivo de las elecciones legislativas de Estados Unidos 2026. Resultados por estado y distrito, con actualización automática."
  section="Internacional"
>
  <section class="election-page">
    <header class="election-header">
      <div>
        <p class="eyebrow">AGENCIA FEDERAL · COBERTURA ESPECIAL</p>
        <h1>Estados Unidos <span>2026</span></h1>
        <p class="dek">El mapa electoral, estado por estado. Resultados preliminares y evolución del escrutinio.</p>
      </div>
      <div class="live-state" aria-live="polite">
        <span class="live-dot"></span>
        <span id="live-label">CONECTANDO CON LAS FUENTES</span>
      </div>
    </header>

    <section class="score-strip" aria-label="Resumen de resultados">
      <article class="score-card">
        <span class="score-label">ESCAÑOS DE LA CÁMARA EN JUEGO</span>
        <strong id="house-r">435</strong>
        <small>Renovación completa de la Cámara de Representantes</small>
      </article>
      <article class="score-card">
        <span class="score-label">ESCAÑOS DEL SENADO EN JUEGO</span>
        <strong id="house-d">35</strong>
        <small>33 regulares y 2 elecciones especiales</small>
      </article>
      <article class="score-card score-meta">
        <span class="score-label">ELECCIONES A GOBERNADOR</span>
        <strong id="states-live">36</strong>
        <small id="updated-at">En 36 estados, según el calendario electoral</small>
      </article>
    </section>

    <section class="map-panel">
      <div class="panel-heading">
        <div>
          <p class="eyebrow">MAPA NACIONAL</p>
          <h2>Seguimiento del escrutinio</h2>
        </div>
        <span class="map-period">RESULTADOS DE LA JORNADA · 3 NOVIEMBRE 2026</span>
      </div>

      <div class="map-legend" aria-label="Referencias del mapa">
        <span><i class="swatch republican"></i>Republicano · proyección AP</span>
        <span><i class="swatch democrat"></i>Demócrata · proyección AP</span>
        <span><i class="swatch pending"></i>Sin resultado confirmado</span>
      </div>

      <div class="map-layout">
        <div class="map-canvas" id="map-canvas">
          <div class="map-loading" id="map-loading">Cargando mapa de los 50 estados…</div>
          <svg id="us-map" viewBox="0 0 960 610" role="img" aria-label="Mapa interactivo de los Estados Unidos. Seleccione un estado para ver sus resultados."></svg>
        </div>
        <aside class="state-detail" id="state-detail" aria-live="polite">
          <p class="eyebrow">DETALLE POR ESTADO</p>
          <h3 id="detail-title">Seleccioná un estado</h3>
          <p id="detail-status" class="detail-status">El mapa mostrará los resultados cuando los organismos electorales publiquen sus recuentos.</p>
          <div id="detail-races" class="detail-races"></div>
        </aside>
      </div>
      <p class="map-note"><strong>Estado del escrutinio:</strong> el mapa no utiliza antecedentes de 2024. Los estados permanecen en gris mientras no haya un liderazgo o ganador publicado para la contienda de 2026. El tablero de AP/Guardian y el mapa de Poliwave actualizan sus propios colores y recuentos a medida que ingresan los votos. Los resultados son preliminares hasta la certificación oficial.</p>
      <div class="map-live-links">
        <a href="https://www.theguardian.com/us-news/ng-interactive/2026/nov/03/midterm-elections-full-results-senate-house-governor-races" target="_blank" rel="noopener noreferrer">Abrir mapa nacional y resultados en vivo · AP / The Guardian ↗</a>
        <a href="https://www.poliwave.com/us/live/midterms-2026?lang=es" target="_blank" rel="noopener noreferrer">Abrir mapa electoral en español · Poliwave / civicAPI ↗</a>
        <a href="https://civicapi.org/results" target="_blank" rel="noopener noreferrer">Consultar base de resultados y fuentes · civicAPI ↗</a>
        <a href="https://www.washingtonpost.com/politics/interactive/2026/11/03/see-where-votes-are-being-counted-senate-house-midterm-races/" target="_blank" rel="noopener noreferrer">Ver mapa de escrutinio por estado y distrito · The Washington Post ↗</a>
      </div>
    </section>

    <section class="live-results-embed" aria-label="Acceso a resultados en vivo de las elecciones 2026">
      <div class="embed-heading">
        <div><p class="eyebrow">RESULTADOS EN VIVO · FUENTES EXTERNAS</p><h2>Tableros de escrutinio conectados</h2></div>
        <span class="source-status">FUENTE EXTERNA</span>
      </div>
      <p class="embed-intro">Panel externo de The Guardian con resultados de Associated Press. La cobertura se actualiza durante la jornada. El contenido y sus proyecciones pertenecen a sus fuentes originales; Diario Federal identifica y acredita la procedencia.</p>
      <div class="guardian-toolbar">
        <span><i class="guardian-live-dot"></i> COBERTURA EN DIRECTO · THE GUARDIAN / AP</span>
        <span id="guardian-refresh-time">Conectando con la fuente…</span>
        <a href="https://www.theguardian.com/us-news/ng-interactive/2026/nov/03/midterm-elections-full-results-senate-house-governor-races" target="_blank" rel="noopener noreferrer">Abrir fuente original ↗</a>
      </div>
      <div class="guardian-frame-wrap">
        <iframe
          id="guardian-results-frame"
          src="https://www.theguardian.com/us-news/ng-interactive/2026/nov/03/midterm-elections-full-results-senate-house-governor-races"
          title="Resultados en vivo de las elecciones de medio término 2026 — The Guardian, datos de Associated Press"
          loading="eager"
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>
      <p class="guardian-fallback">Si el navegador o The Guardian impiden mostrar el tablero incrustado, <a href="https://www.theguardian.com/us-news/ng-interactive/2026/nov/03/midterm-elections-full-results-senate-house-governor-races" target="_blank" rel="noopener noreferrer">abrí aquí los resultados directamente en The Guardian</a>. Fuente de los resultados: Associated Press (AP).</p>
      <div class="live-source-actions">
        <a class="live-source-card" href="https://www.poliwave.com/us/live/midterms-2026?lang=es" target="_blank" rel="noopener noreferrer">
          <span>MAPA EN ESPAÑOL</span><strong>Poliwave · contiendas por estado y distrito</strong><em>Abrir mapa interactivo ↗</em>
        </a>
        <a class="live-source-card" href="https://civicapi.org/results" target="_blank" rel="noopener noreferrer">
          <span>DATOS ABIERTOS</span><strong>civicAPI · resultados y metodología</strong><em>Consultar base de datos ↗</em>
        </a>
      </div>
    </section>
    <section class="results-bottom">
      <div>
        <p class="eyebrow">COBERTURA</p>
        <h2>50 estados en el mapa</h2>
        <p>El mapa cubre los 50 estados. La cobertura de hoy, martes 3 de noviembre de 2026, sigue las elecciones legislativas, senatoriales y de gobernadores. Los resultados se actualizan en los tableros de AP enlazados; no se mezclan con datos de elecciones anteriores.</p>
      </div>
      <div class="source-card">
        <strong>Fuentes para resultados 2026</strong>
        <p>Associated Press aporta los resultados que publican The Guardian, WHYY y otros medios. civicAPI agrega datos de organismos electorales estatales y permite reutilización con atribución. Poliwave ofrece un mapa en español con resultados no oficiales y actualizaciones automáticas.</p>
        <a href="https://civicapi.org/results" target="_blank" rel="noopener noreferrer">Resultados por fecha y jurisdicción · civicAPI ↗</a>
      </div>
    </section>

    <section class="news-desk" aria-labelledby="news-desk-title">
      <div class="news-desk-heading">
        <div>
          <p class="eyebrow">MESA DE MEDIOS · ACTUALIZACIÓN EDITORIAL</p>
          <h2 id="news-desk-title">Seguí la cobertura en otros medios</h2>
          <p>Enlaces directos a coberturas periodísticas en desarrollo. Los resultados y las proyecciones pertenecen a cada medio; Diario Federal no replica sus bases de datos.</p>
        </div>
      </div>
      <div class="news-grid">
        <a class="news-source featured" href="https://www.theguardian.com/us-news/ng-interactive/2026/nov/03/midterm-elections-full-results-senate-house-governor-races" target="_blank" rel="noopener noreferrer">
          <span class="news-kicker">RESULTADOS NACIONALES · AP</span>
          <strong>The Guardian · mapa y resultados de los 50 estados</strong>
          <span>Tablero interactivo de Cámara, Senado y gobernaciones con resultados de Associated Press.</span>
          <em>Abrir cobertura ↗</em>
        </a>
        <a class="news-source" href="https://www.poliwave.com/us/live/midterms-2026?lang=es" target="_blank" rel="noopener noreferrer">
          <span class="news-kicker">MAPA EN ESPAÑOL · DATOS EN VIVO</span>
          <strong>Poliwave · resultados y mapa interactivo</strong>
          <span>Contiendas de Cámara, Senado, gobernadores y otros cargos. Distingue resultados publicados de proyecciones.</span>
          <em>Abrir mapa en español ↗</em>
        </a>
        <a class="news-source" href="https://civicapi.org/results" target="_blank" rel="noopener noreferrer">
          <span class="news-kicker">API ABIERTA · FUENTES OFICIALES</span>
          <strong>civicAPI · datos electorales reutilizables</strong>
          <span>Agrega información de secretarías de Estado y autoridades electorales; actualiza cada 5–10 segundos durante el escrutinio.</span>
          <em>Consultar resultados y metodología ↗</em>
        </a>
        <a class="news-source" href="https://www.washingtonpost.com/politics/interactive/2026/11/03/see-where-votes-are-being-counted-senate-house-midterm-races/" target="_blank" rel="noopener noreferrer">
          <span class="news-kicker">MAPA DE ESCRUTINIO · EN VIVO</span>
          <strong>The Washington Post · votos contabilizados</strong>
          <span>Seguimiento del porcentaje de votos contabilizados por estado y distrito en las contiendas de Senado y Cámara.</span>
          <em>Ver mapa de escrutinio ↗</em>
        </a>
        <a class="news-source" href="https://apps.texastribune.org/features/2026/texas-general-election-live-results-2026/" target="_blank" rel="noopener noreferrer">
          <span class="news-kicker">COBERTURA ESTATAL · AP</span>
          <strong>Texas Tribune · resultados de Texas</strong>
          <span>Resultados en vivo por distrito y cargo, con datos de Associated Press y cobertura local.</span>
          <em>Consultar Texas ↗</em>
        </a>
        <a class="news-source" href="https://www.cbsnews.com/live-updates/election-day-2026-midterms/" target="_blank" rel="noopener noreferrer">
          <span class="news-kicker">COBERTURA EN VIVO</span>
          <strong>CBS News</strong>
          <span>Actualizaciones, incidencias electorales y seguimiento de las contiendas clave.</span>
          <em>Leer en CBS ↗</em>
        </a>
        <a class="news-source" href="https://abcnews.com/Politics/live-updates/midterm-elections-live-updates/" target="_blank" rel="noopener noreferrer">
          <span class="news-kicker">COBERTURA EN VIVO</span>
          <strong>ABC News</strong>
          <span>Crónicas desde los estados, declaraciones de candidatos y novedades de la jornada.</span>
          <em>Leer en ABC ↗</em>
        </a>
        <a class="news-source" href="https://apnews.com/hub/elections" target="_blank" rel="noopener noreferrer">
          <span class="news-kicker">AGENCIA · RESULTADOS Y ANÁLISIS</span>
          <strong>Associated Press</strong>
          <span>Conteo, decisiones de carrera y cobertura nacional de la agencia.</span>
          <em>Seguir en AP ↗</em>
        </a>
        <a class="news-source" href="https://www.reuters.com/live/us-midterm-elections-2026-live-american-voters-cast-verdict-trump-congress-2026-11-03/" target="_blank" rel="noopener noreferrer">
          <span class="news-kicker">COBERTURA EN VIVO</span>
          <strong>Reuters · jornada electoral</strong>
          <span>Actualizaciones políticas y seguimiento de la votación en todo el país.</span>
          <em>Leer en Reuters ↗</em>
        </a>
        <a class="news-source" href="https://www.nbcuniversal.com/article/nbcuniversal-brings-together-nbc-news-telemundo-and-peacock-comprehensive-2026-midterm-election" target="_blank" rel="noopener noreferrer">
          <span class="news-kicker">COBERTURA · DECISION DESK</span>
          <strong>NBC News</strong>
          <span>Seguimiento de resultados, mapas y análisis electoral de NBC.</span>
          <em>Consultar NBC ↗</em>
        </a>
        <a class="news-source" href="https://www.telemundo.com/noticias/noticias-telemundo/elecciones-estados-unidos-2026/live-blog/elecciones-eeuu-medio-termino-2026-resultados-en-vivo-ultimas-noticias-rcna607062" target="_blank" rel="noopener noreferrer">
          <span class="news-kicker">COBERTURA EN ESPAÑOL</span>
          <strong>Noticias Telemundo</strong>
          <span>Información en español y foco en el voto latino y las contiendas competitivas.</span>
          <em>Consultar Telemundo ↗</em>
        </a>
      </div>
      <p class="news-disclaimer">Los enlaces abren los sitios originales. civicAPI declara que sus datos pueden reutilizarse en publicaciones comerciales y no comerciales con atribución. Los resultados son no oficiales hasta su certificación por las autoridades electorales. Poliwave / civicAPI se mantiene fuera de la lista principal porque su panel consultado todavía indicaba una actualización del 30 de octubre.</p>
    </section>
    <footer class="data-footer">
      <span id="source-time">Jornada electoral · martes 3 de noviembre de 2026 · resultados AP / Poliwave / civicAPI.</span>
      <span>AGENCIA FEDERAL · DIARIO FEDERAL</span>
    </footer>
  </section>
</BaseLayout>

<style>
  .election-page { color: #17202c; padding-bottom: 3rem; }
  .election-header { display:flex; align-items:flex-end; justify-content:space-between; gap:1.5rem; border-bottom:1px solid #d9dee5; padding:0 0 1.35rem; }
  .eyebrow { margin:0 0 .45rem; color:#687586; font-size:.68rem; font-weight:800; letter-spacing:.13em; }
  h1 { margin:0; font-family:Newsreader, Georgia, serif; font-size:clamp(2.4rem,6vw,4.6rem); line-height:.98; letter-spacing:-.035em; }
  h1 span { color:#8b1e27; }
  .dek { max-width:44rem; margin:.8rem 0 0; color:#536071; font-size:1rem; }
  .live-state { display:flex; align-items:center; gap:.55rem; flex-shrink:0; padding:.6rem .8rem; border:1px solid #d9dee5; border-radius:999px; color:#344152; font-size:.67rem; font-weight:800; letter-spacing:.08em; }
  .live-dot { width:.55rem; height:.55rem; border-radius:50%; background:#9babbc; }
  .live-state.is-live .live-dot { background:#c52832; box-shadow:0 0 0 4px #c528321c; animation:pulse 1.8s infinite; }
  .score-strip { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.75rem; margin:1.15rem 0; }
  .score-card { min-height:112px; padding:1rem 1.1rem; border:1px solid #dce1e8; border-radius:12px; background:#fff; }
  .score-label { display:block; color:#657184; font-size:.62rem; font-weight:800; letter-spacing:.08em; line-height:1.35; }
  .score-card strong { display:block; margin:.35rem 0 .1rem; font-family:Newsreader,Georgia,serif; font-size:2.5rem; line-height:1; }
  .score-card small { color:#6c7786; font-size:.7rem; }
  .map-panel { border:1px solid #dce1e8; border-radius:16px; background:#fff; overflow:hidden; }
  .panel-heading { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:1.1rem 1.25rem .8rem; }
  .panel-heading h2,.results-bottom h2 { margin:0; font-family:Newsreader,Georgia,serif; font-size:1.65rem; }
  .map-period { padding:.55rem .75rem; border:1px solid #dce1e8; border-radius:999px; color:#687586; font-size:.62rem; font-weight:800; letter-spacing:.08em; }
  .view-button { border:0; border-radius:7px; background:transparent; padding:.55rem .8rem; color:#536071; font:700 .76rem Inter, sans-serif; cursor:pointer; }
  .view-button.active { background:#17202c; color:#fff; }
  .map-legend { display:flex; flex-wrap:wrap; gap:.65rem 1.2rem; padding:.65rem 1.25rem; border-top:1px solid #edf0f3; border-bottom:1px solid #edf0f3; color:#536071; font-size:.7rem; }
  .map-legend span { display:flex; align-items:center; gap:.4rem; }
  .swatch { width:.7rem; height:.7rem; border-radius:3px; display:inline-block; }
  .republican { background:#c64b50; } .democrat { background:#3978c5; } .mixed { background:#9272a8; } .pending { background:#d9dee5; }
  .live-results-embed { margin:1rem 0; padding:1rem; border:1px solid #dce1e8; border-radius:14px; background:#fff; }
  .embed-heading { display:flex; align-items:center; justify-content:space-between; gap:1rem; margin-bottom:.8rem; }
  .embed-heading h2 { margin:0; font-family:Newsreader,Georgia,serif; font-size:1.65rem; }
  .embed-heading a { color:#1c5a9c; font-size:.75rem; font-weight:800; }
  .source-status { padding:.45rem .65rem; border:1px solid #dce1e8; border-radius:999px; color:#687586; font-size:.6rem; font-weight:800; letter-spacing:.08em; }
  .embed-intro { max-width:58rem; margin:.35rem 0 1rem; color:#657184; font-size:.78rem; line-height:1.5; }
  .live-source-actions { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.7rem; }
  .guardian-toolbar { display:flex; align-items:center; flex-wrap:wrap; gap:.7rem 1.1rem; padding:.7rem .85rem; border:1px solid #dce1e8; border-bottom:0; border-radius:10px 10px 0 0; background:#f7f9fb; color:#536071; font-size:.64rem; font-weight:800; letter-spacing:.04em; }
  .guardian-toolbar a { margin-left:auto; color:#1c5a9c; text-decoration:none; }
  .guardian-live-dot { display:inline-block; width:.5rem; height:.5rem; margin-right:.35rem; border-radius:50%; background:#c52832; box-shadow:0 0 0 3px #c528321c; }
  .guardian-frame-wrap { height:760px; min-height:540px; overflow:hidden; border:1px solid #dce1e8; border-radius:0 0 10px 10px; background:#fff; }
  .guardian-frame-wrap iframe { display:block; width:100%; height:100%; border:0; background:#fff; }
  .guardian-fallback { margin:.55rem 0 1rem; color:#778291; font-size:.67rem; line-height:1.45; }
  .guardian-fallback a { color:#1c5a9c; font-weight:800; }
  .live-source-card { display:flex; flex-direction:column; gap:.45rem; min-height:125px; padding:1rem; border:1px solid #dce1e8; border-radius:10px; color:#17202c; text-decoration:none; background:#fbfcfd; }
  .live-source-card:hover { border-color:#9ba8b8; background:#f4f7fb; }
  .live-source-card span { color:#687586; font-size:.59rem; font-weight:800; letter-spacing:.09em; }
  .live-source-card strong { font-family:Newsreader,Georgia,serif; font-size:1.12rem; line-height:1.2; }
  .live-source-card em { margin-top:auto; color:#1c5a9c; font-size:.7rem; font-style:normal; font-weight:800; }
  .map-live-links { display:flex; flex-wrap:wrap; gap:.65rem 1rem; padding:.1rem 1.25rem 1rem; }
  .map-live-links a { color:#1c5a9c; font-size:.74rem; font-weight:800; text-decoration:none; }
  .map-live-links a:hover { text-decoration:underline; }
  .map-layout { display:grid; grid-template-columns:minmax(0,1fr) 290px; gap:0; min-height:460px; }
  .map-canvas { position:relative; min-width:0; padding:.5rem; background:#f7f8fa; }
  #us-map { display:block; width:100%; height:auto; min-height:350px; }
  .state-shape { stroke:#fff; stroke-width:1.3; vector-effect:non-scaling-stroke; cursor:pointer; transition:fill .2s ease, opacity .2s ease; }
  .state-shape:hover,.state-shape:focus { stroke:#17202c; stroke-width:2.4; outline:none; }
  .state-shape.selected { stroke:#17202c; stroke-width:2.8; }
  .state-label { fill:#263241; font-size:10px; font-weight:800; text-anchor:middle; pointer-events:none; }
  .map-loading { position:absolute; z-index:2; top:1rem; left:1rem; padding:.55rem .75rem; border-radius:8px; background:#fff; color:#5b6674; font-size:.75rem; box-shadow:0 2px 12px #17202c12; }
  .map-loading.hidden { display:none; }
  .state-detail { padding:1.2rem; border-left:1px solid #e3e7ec; background:#fff; }
  .state-detail h3 { margin:.25rem 0 .45rem; font-family:Newsreader,Georgia,serif; font-size:1.65rem; }
  .detail-status { color:#667283; font-size:.78rem; line-height:1.5; }
  .detail-races { display:grid; gap:.65rem; margin-top:1rem; }
  .race-card { padding:.75rem; border:1px solid #e1e5eb; border-radius:9px; }
  .race-card h4 { margin:0 0 .5rem; font-size:.75rem; }
  .candidate-row { display:flex; justify-content:space-between; gap:.5rem; padding:.25rem 0; color:#4a5665; font-size:.72rem; }
  .candidate-row strong { color:#17202c; font-variant-numeric:tabular-nums; }
  .party-dot { display:inline-block; width:.48rem; height:.48rem; margin-right:.3rem; border-radius:50%; }
  .map-note { margin:0; padding:.8rem 1.2rem 1rem; color:#6a7584; font-size:.68rem; line-height:1.5; }
  .cartogram-fallback { display:grid; grid-template-columns:repeat(10,minmax(0,1fr)); gap:5px; padding:1rem; }
  .cartogram-state { min-height:43px; border:1px solid #cbd3dd; border-radius:5px; background:#d9dee5; color:#263241; font-size:.72rem; font-weight:800; cursor:pointer; }
  .cartogram-state:hover,.cartogram-state:focus { outline:2px solid #17202c; outline-offset:1px; }
  .cartogram-state.selected { border:2px solid #17202c; background:#c5cfdb; box-shadow:inset 0 0 0 1px #fff; }
  .cartogram-caption { padding:0 1rem 1rem; color:#687586; font-size:.68rem; }
  .results-bottom { display:grid; grid-template-columns:1fr 1fr; gap:1rem; margin:1rem 0; }
  .results-bottom > div { padding:1.15rem; border:1px solid #dce1e8; border-radius:12px; }
  .results-bottom p { color:#657184; font-size:.8rem; line-height:1.55; }
  .source-card { background:#f6f7f9; }
  .source-card strong { font-size:.8rem; }
  .source-card a { color:#1c5a9c; font-size:.75rem; font-weight:700; text-decoration:underline; text-underline-offset:3px; }
  .data-footer { display:flex; justify-content:space-between; gap:1rem; padding-top:.8rem; border-top:1px solid #dce1e8; color:#778291; font-size:.65rem; }
  .news-desk { margin:1.25rem 0; padding:1.2rem; border:1px solid #dce1e8; border-radius:14px; background:#fff; }
  .news-desk-heading { display:flex; justify-content:space-between; gap:1rem; margin-bottom:1rem; }
  .news-desk h2 { margin:0; font-family:Newsreader,Georgia,serif; font-size:1.7rem; }
  .news-desk-heading p:not(.eyebrow) { max-width:54rem; margin:.45rem 0 0; color:#657184; font-size:.78rem; line-height:1.5; }
  .news-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.65rem; }
  .news-source { display:flex; flex-direction:column; align-items:flex-start; gap:.35rem; min-height:130px; padding:.9rem; border:1px solid #e1e5eb; border-radius:10px; color:#17202c; text-decoration:none; transition:border-color .15s ease,background .15s ease; }
  .news-source:hover { border-color:#9ba8b8; background:#f8f9fb; }
  .news-source.featured { border-color:#b9c9dc; background:#f4f7fb; }
  .news-kicker { color:#687586; font-size:.59rem; font-weight:800; letter-spacing:.1em; }
  .news-source strong { font-family:Newsreader,Georgia,serif; font-size:1.15rem; line-height:1.15; }
  .news-source span:not(.news-kicker) { color:#657184; font-size:.72rem; line-height:1.4; }
  .news-source em { margin-top:auto; color:#1c5a9c; font-size:.68rem; font-style:normal; font-weight:800; }
  .news-disclaimer { margin:.8rem 0 0; color:#778291; font-size:.65rem; line-height:1.45; }
  @keyframes pulse { 50% { opacity:.55; } }
  @media(max-width:760px) {
    .election-header { align-items:flex-start; flex-direction:column; }
    .live-state { align-self:flex-start; }
    .score-strip { grid-template-columns:1fr 1fr; }
    .score-meta { grid-column:1 / -1; }
    .panel-heading { align-items:flex-start; flex-direction:column; }
    .map-layout { grid-template-columns:1fr; }
    .state-detail { border-left:0; border-top:1px solid #e3e7ec; }
    #us-map { min-height:220px; }
    .results-bottom { grid-template-columns:1fr; }
    .news-grid { grid-template-columns:1fr; }
    .live-source-actions { grid-template-columns:1fr; }
    .guardian-frame-wrap { height:72vh; min-height:500px; }
    .guardian-toolbar { align-items:flex-start; flex-direction:column; }
    .guardian-toolbar a { margin-left:0; }
    .cartogram-fallback { grid-template-columns:repeat(5,minmax(0,1fr)); }
    .data-footer { flex-direction:column; }
  }
</style>

<script is:inline type="module">
  import { geoAlbersUsa, geoPath } from 'https://cdn.jsdelivr.net/npm/d3-geo@3/+esm';
  import { feature } from 'https://cdn.jsdelivr.net/npm/topojson-client@3/+esm';

  const GEO_URL = 'https://cdn.jsdelivr.net/npm/us-atlas@3/states-10m.json';
  const FIPS = {
    '01':'AL','02':'AK','04':'AZ','05':'AR','06':'CA','08':'CO','09':'CT','10':'DE','12':'FL','13':'GA',
    '15':'HI','16':'ID','17':'IL','18':'IN','19':'IA','20':'KS','21':'KY','22':'LA','23':'ME','24':'MD',
    '25':'MA','26':'MI','27':'MN','28':'MS','29':'MO','30':'MT','31':'NE','32':'NV','33':'NH','34':'NJ',
    '35':'NM','36':'NY','37':'NC','38':'ND','39':'OH','40':'OK','41':'OR','42':'PA','44':'RI','45':'SC',
    '46':'SD','47':'TN','48':'TX','49':'UT','50':'VT','51':'VA','53':'WA','54':'WV','55':'WI','56':'WY'
  };
  const NAMES = {
    AL:'Alabama',AK:'Alaska',AZ:'Arizona',AR:'Arkansas',CA:'California',CO:'Colorado',CT:'Connecticut',DE:'Delaware',FL:'Florida',GA:'Georgia',
    HI:'Hawái',ID:'Idaho',IL:'Illinois',IN:'Indiana',IA:'Iowa',KS:'Kansas',KY:'Kentucky',LA:'Luisiana',ME:'Maine',MD:'Maryland',
    MA:'Massachusetts',MI:'Michigan',MN:'Minnesota',MS:'Misisipi',MO:'Misuri',MT:'Montana',NE:'Nebraska',NV:'Nevada',NH:'Nuevo Hampshire',NJ:'Nueva Jersey',
    NM:'Nuevo México',NY:'Nueva York',NC:'Carolina del Norte',ND:'Dakota del Norte',OH:'Ohio',OK:'Oklahoma',OR:'Oregon',PA:'Pensilvania',RI:'Rhode Island',SC:'Carolina del Sur',
    SD:'Dakota del Sur',TN:'Tennessee',TX:'Texas',UT:'Utah',VT:'Vermont',VA:'Virginia',WA:'Washington',WV:'Virginia Occidental',WI:'Wisconsin',WY:'Wyoming'
  };
  const statePaths = new Map();
  let selectedState = null;

  // El tablero de Guardian es una fuente externa viva (resultados AP).
  // Se recarga periódicamente para solicitar la versión más reciente.
  const guardianFrame = document.getElementById('guardian-results-frame');
  const guardianRefreshLabel = document.getElementById('guardian-refresh-time');
  function refreshGuardianPanel() {
    if (!guardianFrame || document.visibilityState === 'hidden') return;
    guardianFrame.src = 'https://www.theguardian.com/us-news/ng-interactive/2026/nov/03/midterm-elections-full-results-senate-house-governor-races?df_refresh=' + Date.now();
    if (guardianRefreshLabel) guardianRefreshLabel.textContent = 'Panel solicitado: ' + new Date().toLocaleTimeString('es-AR', {hour:'2-digit',minute:'2-digit'});
  }
  if (guardianFrame) {
    if (guardianRefreshLabel) guardianRefreshLabel.textContent = 'Actualización automática cada 60 segundos';
    window.setInterval(refreshGuardianPanel, 60000);
  }

  const $ = (id) => document.getElementById(id);
  const stateCode = (f) => FIPS[String(f.id).padStart(2,'0')];
  function electionColor(code) { return '#d9dee5'; }
  function renderMap() {
    for (const [code, path] of statePaths) {
      path.setAttribute('fill', electionColor(code));
      path.classList.toggle('selected', selectedState === code);
    }
    $('states-live').textContent = '36';
    $('house-r').textContent = '435';
    $('house-d').textContent = '35';
    $('updated-at').textContent = 'Resultados 2026 en tableros AP / Poliwave / civicAPI enlazados.';
    if (selectedState) renderDetail(selectedState);
  }
  function renderDetail(code) {
    $('detail-title').textContent = NAMES[code] || code;
    $('detail-status').textContent = 'Sin resultado de 2026 incorporado a este mapa. Consultá los resultados de esta jornada en AP / The Guardian o Poliwave / civicAPI.';
    $('detail-races').innerHTML = '<p class="detail-status"><a href="https://www.theguardian.com/us-news/ng-interactive/2026/nov/03/midterm-elections-full-results-senate-house-governor-races" target="_blank" rel="noopener noreferrer">Ver resultados 2026 de AP ↗</a></p><p class="detail-status"><a href="https://www.poliwave.com/us/live/midterms-2026?lang=es" target="_blank" rel="noopener noreferrer">Ver resultados por estado en Poliwave / civicAPI ↗</a></p>';
  }
  function drawStates(topology) {
    const collection = feature(topology, topology.objects.states);
    const svg = $('us-map');
    const projection = geoAlbersUsa().fitSize([940,570], collection);
    const pathGenerator = geoPath(projection);
    const ns = 'http://www.w3.org/2000/svg';
    collection.features.forEach(f => {
      const code = stateCode(f);
      if (!code) return;
      const path = document.createElementNS(ns,'path');
      path.setAttribute('d',pathGenerator(f));
      path.setAttribute('class','state-shape');
      path.setAttribute('fill',electionColor(code));
      path.setAttribute('tabindex','0');
      path.setAttribute('role','button');
      path.setAttribute('aria-label',NAMES[code] || code);
      const title = document.createElementNS(ns,'title');
      title.textContent = NAMES[code] + ' · resultados 3 de noviembre de 2026';
      path.appendChild(title);
      svg.appendChild(path);
      const centroid = pathGenerator.centroid(f);
      if (Number.isFinite(centroid[0]) && Number.isFinite(centroid[1])) {
        const label = document.createElementNS(ns,'text');
        label.setAttribute('x',centroid[0]);
        label.setAttribute('y',centroid[1] + 3);
        label.setAttribute('class','state-label');
        label.textContent = code;
        svg.appendChild(label);
      }
      path.addEventListener('click', () => { selectedState = code; renderMap(); });
      path.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectedState = code; renderMap(); } });
      statePaths.set(code,path);
    });
    $('map-loading').classList.add('hidden');
    $('live-label').textContent = 'JORNADA ELECTORAL · FUENTES AP / Poliwave / civicAPI';
    $('live-label').parentElement.classList.remove('is-live');
    renderMap();
  }
  function drawCartogramFallback() {
    const svg = $('us-map');
    svg.style.display = 'none';
    const canvas = $('map-canvas');
    const grid = document.createElement('div');
    grid.className = 'cartogram-fallback';
    Object.keys(NAMES).sort().forEach(code => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'cartogram-state';
      button.textContent = code;
      button.title = NAMES[code];
      button.setAttribute('aria-label',NAMES[code]);
      button.addEventListener('click', () => {
        selectedState = code;
        grid.querySelectorAll('.cartogram-state').forEach(item => item.classList.toggle('selected', item === button));
        renderDetail(code);
      });
      grid.appendChild(button);
    });
    const caption = document.createElement('p');
    caption.className = 'cartogram-caption';
    caption.textContent = 'Seleccioná cualquiera de los 50 estados para abrir su ficha. Los colores solo cambiarán cuando haya datos verificables de 2026.';
    canvas.appendChild(grid);
    canvas.appendChild(caption);
    $('map-loading').classList.add('hidden');
    $('live-label').textContent = 'MAPA DE RESPALDO · FUENTES EXTERNAS';
  }
  try {
    const response = await fetch(GEO_URL, {cache:'no-store'});
    if (!response.ok) throw new Error('No se pudo cargar la geometría');
    const topology = await response.json();
    if (!topology?.objects?.states) throw new Error('La geometría no contiene estados');
    drawStates(topology);
  } catch (error) {
    $('map-loading').textContent = 'No se pudo cargar la geometría; mostrando los 50 estados en vista alternativa…';
    console.error('[Diario Federal elecciones]',error);
    drawCartogramFallback();
  }
</script>
