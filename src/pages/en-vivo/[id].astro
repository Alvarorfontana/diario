---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE, nombreSeccion } from '../../consts';
import { getRuntimeEnv } from '../../lib/runtimeEnv';
import { ghConfig } from '../../lib/github';
import { leer } from '../../lib/envivo';

const env = getRuntimeEnv(Astro.locals);
const cfg = ghConfig(env);
const id = String(Astro.params.id || '');
let cobertura = null as Awaited<ReturnType<typeof leer>>['coberturas'][number] | null;
let errorCarga = false;
try {
	if (cfg) cobertura = (await leer(cfg.token, env)).coberturas.find((c) => c.id === id) ?? null;
	else errorCarga = true;
} catch {
	errorCarga = true;
}
if (!cobertura && !errorCarga) return Astro.redirect('/minuto-a-minuto/', 302);

const entradas = cobertura ? [...cobertura.entradas].sort((a, b) => b.createdAt.localeCompare(a.createdAt)) : [];
const activa = cobertura?.estado === 'activa';
const titulo = cobertura?.titulo ?? 'Cobertura en vivo';
const descripcion = cobertura?.bajada || `Cobertura minuto a minuto de ${SITE_TITLE}.`;
// La página cambia con cada entrada: la CDN la guarda solo unos segundos.
Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate');
Astro.response.headers.set('CDN-Cache-Control', 'public, s-maxage=20, stale-while-revalidate=60');
---

<BaseLayout title={`${activa ? 'En vivo: ' : ''}${titulo} | ${SITE_TITLE}`} description={descripcion}>
	<article class="mx-auto max-w-3xl">
		{activa
			? <p class="um-banner mt-4"><span class="um-luz"></span>En vivo · {cobertura && nombreSeccion(cobertura.seccion as any)}</p>
			: <p class="mt-4 text-xs font-bold tracking-[0.12em] text-neutral-500 uppercase">Cobertura finalizada · {cobertura && nombreSeccion(cobertura.seccion as any)}</p>}
		<h1 class="mt-4 font-serif text-4xl leading-[1.08] font-black tracking-tight sm:text-5xl">{titulo}</h1>
		{cobertura?.bajada && <p class="mt-4 text-lg leading-relaxed text-neutral-600 sm:text-xl">{cobertura.bajada}</p>}

		{activa && (
			<div class="mt-5 flex flex-wrap items-center justify-between gap-3">
				<button type="button" id="actualizar" class="inline-flex items-center gap-2 rounded-full bg-brand px-4 py-2 text-xs font-bold text-white">
					<span class="titila inline-block h-2 w-2 rounded-full bg-white"></span>
					Actualizar ahora
				</button>
				<span class="text-xs text-neutral-500">Se actualiza solo cada 60 segundos</span>
			</div>
		)}

		<div id="timeline" data-id={id} data-activa={activa ? '1' : ''} class="mt-4 ml-1.5 border-l-[3px] border-neutral-900">
			{errorCarga && <p class="py-6 pl-5 text-neutral-500">No se pudo cargar la cobertura. Probá de nuevo en un rato.</p>}
			{!errorCarga && entradas.length === 0 && <p class="py-6 pl-5 text-neutral-500">Todavía no hay actualizaciones. Apenas empiece la cobertura, las vas a ver acá.</p>}
			{entradas.map((p) => (
				<div class="relative grid grid-cols-[56px_1fr] gap-x-4 border-b border-neutral-200 py-5 pl-5">
					<span class:list={['absolute top-6 -left-[7px] h-[11px] w-[11px] rounded-full border-[3px]', p.clave ? 'border-brand bg-brand' : 'border-neutral-900 bg-white']}></span>
					<span class="font-display text-lg font-extrabold">{p.hora}</span>
					<div>
						{p.clave && <span class="mb-2 inline-block rounded-full border border-brand px-3 py-0.5 text-[10px] font-extrabold tracking-wider text-brand uppercase">Momento clave</span>}
						<p class="font-display text-[17px] leading-snug font-extrabold text-ink">{p.titulo}</p>
						<p class="mt-1 text-[15px] leading-relaxed whitespace-pre-line text-neutral-800">{p.texto}</p>
						<p class="mt-2 text-xs font-semibold text-neutral-500">{p.fuente} <span class="font-normal text-neutral-400">· {p.fecha}</span></p>
					</div>
				</div>
			))}
		</div>

		<p class="mt-8 text-sm"><a href="/minuto-a-minuto/" class="font-bold text-brand hover:underline">← Todas las coberturas en vivo</a></p>
	</article>
</BaseLayout>

<script is:inline>
	(function () {
		var tl = document.getElementById('timeline');
		if (!tl || !tl.dataset.activa) return;
		var id = tl.dataset.id;
		function esc(t) { var d = document.createElement('div'); d.textContent = t == null ? '' : String(t); return d.innerHTML; }
		async function cargar() {
			try {
				var r = await (await fetch('/api/en-vivo?id=' + encodeURIComponent(id), { cache: 'no-store' })).json();
				if (!r || !r.ok) return;   // si falla, se deja lo que ya se ve
				var items = r.cobertura.entradas || [];
				if (!items.length) return;
				tl.innerHTML = items.map(function (p) {
					return '<div class="relative grid grid-cols-[56px_1fr] gap-x-4 border-b border-neutral-200 py-5 pl-5">' +
						'<span class="absolute top-6 -left-[7px] h-[11px] w-[11px] rounded-full border-[3px] ' + (p.clave ? 'border-brand bg-brand' : 'border-neutral-900 bg-white') + '"></span>' +
						'<span class="font-display text-lg font-extrabold">' + esc(p.hora) + '</span><div>' +
						(p.clave ? '<span class="mb-2 inline-block rounded-full border border-brand px-3 py-0.5 text-[10px] font-extrabold tracking-wider text-brand uppercase">Momento clave</span>' : '') +
						'<p class="font-display text-[17px] leading-snug font-extrabold text-ink">' + esc(p.titulo) + '</p>' +
						'<p class="mt-1 text-[15px] leading-relaxed whitespace-pre-line text-neutral-800">' + esc(p.texto) + '</p>' +
						'<p class="mt-2 text-xs font-semibold text-neutral-500">' + esc(p.fuente) + ' <span class="font-normal text-neutral-400">· ' + esc(p.fecha) + '</span></p></div></div>';
				}).join('');
			} catch (e) {}
		}
		var b = document.getElementById('actualizar');
		if (b) b.addEventListener('click', cargar);
		setInterval(cargar, 60000);
	})();
</script>
