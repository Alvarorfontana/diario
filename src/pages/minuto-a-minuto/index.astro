---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE, nombreSeccion } from '../../consts';
import { getRuntimeEnv } from '../../lib/runtimeEnv';
import { ghConfig } from '../../lib/github';
import { leer, resumen } from '../../lib/envivo';

// Todas las coberturas en vivo: las activas arriba, las terminadas como archivo.
const env = getRuntimeEnv(Astro.locals);
const cfg = ghConfig(env);
let lista: ReturnType<typeof resumen>[] = [];
try {
	if (cfg) lista = (await leer(cfg.token, env)).coberturas.map(resumen);
} catch {}
const orden = (x: ReturnType<typeof resumen>) => x.ultima?.createdAt || x.creada;
lista.sort((a, b) => orden(b).localeCompare(orden(a)));
const activas = lista.filter((c) => c.estado === 'activa');
const cerradas = lista.filter((c) => c.estado === 'cerrada');
const fecha = (iso: string) => new Date(iso).toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'America/Argentina/Buenos_Aires' });

Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate');
Astro.response.headers.set('CDN-Cache-Control', 'public, s-maxage=30, stale-while-revalidate=120');
---

<BaseLayout title={`Minuto a minuto | ${SITE_TITLE}`} description="Coberturas en vivo de EL DIARIO.">
	<div class="mx-auto max-w-3xl">
		<p class="mt-4 text-xs font-bold tracking-[0.12em] text-brand uppercase">Coberturas en vivo</p>
		<h1 class="mt-2 font-serif text-4xl leading-[1.08] font-black tracking-tight">Minuto a minuto</h1>

		{activas.length === 0 && (
			<p class="mt-6 rounded-2xl bg-[#f0f0ec] p-5 text-neutral-700">No hay ninguna cobertura en vivo en este momento. Cuando haya una, la vas a ver acá y destacada en la portada.</p>
		)}

		{activas.map((c) => (
			<a href={`/en-vivo/${c.id}/`} class="mt-6 block rounded-2xl bg-brand p-5 text-white hover:opacity-95">
				<span class="flex items-center gap-2 text-xs font-extrabold tracking-[0.1em] uppercase">
					<span class="titila inline-block h-2 w-2 rounded-full bg-white" aria-hidden="true"></span>
					En vivo · {nombreSeccion(c.seccion)}
				</span>
				<span class="mt-1.5 block font-display text-2xl leading-snug font-extrabold">{c.titulo}</span>
				{c.ultima && <span class="mt-1 block text-sm text-white/90">Última actualización {c.ultima.hora}: {c.ultima.titulo}</span>}
			</a>
		))}

		<a href="/brasil-2026/minuto-a-minuto/" class="mt-4 block rounded-2xl border border-neutral-300 p-5 hover:bg-neutral-50">
			<span class="text-xs font-bold tracking-[0.1em] text-neutral-500 uppercase">Especial</span>
			<span class="mt-1 block font-display text-xl font-extrabold text-ink">Brasil 2026, minuto a minuto</span>
		</a>

		{cerradas.length > 0 && (
			<section class="mt-10">
				<h2 class="border-b-2 border-neutral-900 pb-2 font-display text-lg font-extrabold">Coberturas anteriores</h2>
				<ul>
					{cerradas.map((c) => (
						<li class="border-b border-neutral-200 py-4">
							<a href={`/en-vivo/${c.id}/`} class="font-display text-lg font-extrabold text-ink hover:text-brand">{c.titulo}</a>
							<p class="mt-1 text-xs text-neutral-500">{nombreSeccion(c.seccion)} · {fecha(c.creada)} · {c.cantidad} {c.cantidad === 1 ? 'actualización' : 'actualizaciones'}</p>
						</li>
					))}
				</ul>
			</section>
		)}
	</div>
</BaseLayout>
