---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';

// Esta página tenía datos de ejemplo de la plantilla (un escrutinio inventado).
// Hasta que haya una cobertura en vivo real, muestra a dónde seguir las coberturas activas.
---

<BaseLayout title={`Minuto a minuto | ${SITE_TITLE}`} description="Coberturas en vivo de EL DIARIO.">
	<div class="tarjeta mx-auto max-w-2xl p-7 text-center sm:p-10">
		<p class="text-xs font-bold tracking-[0.12em] text-brand uppercase">Coberturas en vivo</p>
		<h1 class="mt-3 font-display text-3xl font-extrabold text-ink">No hay ninguna cobertura en vivo en este momento</h1>
		<p class="mt-3 text-neutral-600">Cuando haya una, la vas a ver destacada en la portada.</p>
		<div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
			<a href="/brasil-2026/minuto-a-minuto/" class="rounded-xl bg-brand px-5 py-3 font-bold text-white hover:bg-brand-dark">Brasil 2026, minuto a minuto</a>
			<a href="/" class="rounded-xl bg-[#f0f0ec] px-5 py-3 font-bold text-ink hover:bg-neutral-200">Ir a la portada</a>
		</div>
	</div>
</BaseLayout>
