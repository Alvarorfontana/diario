---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout title={`Búsqueda | ${SITE_TITLE}`} description="Busca noticias en el archivo del diario.">
	<h1 class="titulo-seccion text-3xl sm:text-4xl">Búsqueda</h1>
	<div class="mt-6">
		<input
			id="q"
			type="search"
			placeholder="Buscar noticias..."
			autocomplete="off"
			class="w-full rounded-2xl border border-[#dcdcd6] bg-white px-5 py-4 text-base focus:border-brand focus:outline-none"
		/>
	</div>
	<p id="estado" class="mt-4 text-sm text-neutral-500"></p>
	<div id="resultados" class="mt-4 flex flex-col gap-3"></div>
</BaseLayout>

<script>
	const $input = document.getElementById('q') as HTMLInputElement;
	const $estado = document.getElementById('estado') as HTMLParagraphElement;
	const $resultados = document.getElementById('resultados') as HTMLDivElement;

	let articulos: any[] = [];
	let temporizador: ReturnType<typeof setTimeout> | undefined;

	function escapar(texto: string): string {
		const div = document.createElement('div');
		div.textContent = texto;
		return div.innerHTML;
	}

	// Cargar todas las notas publicadas desde el endpoint
	async function cargarArticulos() {
		try {
			const res = await fetch('/api/articulos');
			if (res.ok) {
				articulos = await res.json();
			}
		} catch {
			$estado.textContent = 'No se pudieron cargar las noticias.';
		}
	}

	function normalizar(texto: string): string {
		return (texto || '')
			.toLowerCase()
			.normalize('NFD')
			.replace(/[\u0300-\u036f]/g, '');
	}

	function buscar() {
		const consulta = normalizar($input.value.trim());

		if (consulta.length < 2) {
			$resultados.innerHTML = '';
			$estado.textContent = '';
			return;
		}

		const coincidencias = articulos.filter((a) =>
			normalizar(a.title).includes(consulta) ||
			normalizar(a.excerpt).includes(consulta)
		);

		if (coincidencias.length === 0) {
			$resultados.innerHTML = '';
			$estado.textContent = `Sin resultados para «${$input.value.trim()}».`;
			return;
		}

		$estado.textContent = `${coincidencias.length} resultado(s) para «${$input.value.trim()}»`;
		$resultados.innerHTML = coincidencias
			.map(
				(a: any) => `
				<article class="tarjeta p-5">
					<a href="/articulo/${a.slug}/" class="group block">
						<h2 class="font-display text-lg leading-snug font-extrabold text-ink transition-colors group-hover:text-brand">${escapar(a.title)}</h2>
						<p class="mt-1 text-sm leading-relaxed text-neutral-600">${escapar(a.excerpt || '')}</p>
					</a>
				</article>`
			)
			.join('');
	}

	$input.addEventListener('input', () => {
		clearTimeout(temporizador);
		temporizador = setTimeout(buscar, 250);
	});

	cargarArticulos();
</script>
