---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SECCIONES, SITE_TITLE } from '../../consts';
import { getArticulos } from '../../lib/articles';

export const prerender = false;

const { nombre } = Astro.props;
const { section } = Astro.params;

// Validar que la sección exista
const seccionValida = SECCIONES.find((s) => s.id === section);
if (!seccionValida) {
	return Astro.redirect('/404');
}

const nombreSeccion = nombre ?? seccionValida.nombre;

const articulos = (await getArticulos()).filter((a) => a.section === section);

const [primero, ...resto] = articulos;
---

<BaseLayout title={`${nombreSeccion} | ${SITE_TITLE}`} description={`Todas las noticias de ${nombreSeccion} en ${SITE_TITLE}.`} image={primero?.image_url}>
	<h1 class="border-b-2 border-neutral-900 pb-3 font-serif text-3xl font-bold sm:text-4xl">
		{nombreSeccion}
	</h1>

	{
		articulos.length === 0 ? (
			<p class="py-12 text-center text-neutral-500">Todavía no hay noticias en esta sección.</p>
		) : (
			<>
				{primero && (
					<div class="mx-auto max-w-3xl py-10">
						<ArticleCard article={primero} variant="lead" />
					</div>
				)}
				{resto.length > 0 && (
					<div class="divide-y divide-neutral-200 border-t border-neutral-200">
						{resto.map((articulo) => (
							<article class="grid gap-4 py-8 sm:grid-cols-[auto_1fr] sm:items-start">
							{articulo.image_url && (
								<a href={`/articulo/${articulo.slug}/`} class="sm:w-48 shrink-0">
									<img
										src={articulo.image_url}
										alt=""
										width={192}
										height={108}
										class="aspect-video w-full object-cover"
									/>
								</a>
							)}
								<div>
									<a href={`/articulo/${articulo.slug}/`} class="group block">
										<h2 class="font-serif text-2xl leading-snug font-bold text-neutral-900 transition-colors group-hover:text-brand">
											{articulo.title}
										</h2>
										<p class="mt-2 text-sm leading-relaxed text-neutral-600">
											{articulo.excerpt}
										</p>
										<p class="mt-2 text-xs text-neutral-400">
											<FormattedDate date={articulo.date} /> · {articulo.author}
										</p>
									</a>
								</div>
							</article>
						))}
					</div>
				)}
			</>
		)
	}
</BaseLayout>
