---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Mercados | Diario Federal" description="Cotizaciones del dólar, euro, riesgo país y ADRs argentinas en Wall Street.">
  <main class="mx-auto max-w-6xl px-4 pb-12 pt-7">
    <header class="border-b border-neutral-200 pb-6">
      <p class="text-xs font-bold uppercase tracking-[.16em] text-brand">Economía · Indicadores financieros</p>
      <div class="mt-2 flex flex-wrap items-end justify-between gap-3">
        <div>
          <h1 class="font-display text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">Mercados</h1>
          <p class="mt-2 max-w-2xl text-sm leading-relaxed text-neutral-600">Cotizaciones locales y evolución de las empresas argentinas que operan en Wall Street.</p>
        </div>
        <p id="mercados-hora" class="text-xs text-neutral-500">Consultando cotizaciones…</p>
      </div>
    </header>

    <section class="mt-7" aria-labelledby="divisas-title">
      <div class="mb-3 flex items-center justify-between">
        <h2 id="divisas-title" class="font-display text-2xl font-bold text-ink">Dólares y referencias</h2>
        <span class="text-[11px] text-neutral-500">Valores de venta</span>
      </div>
      <div id="mercados-divisas" class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        <p class="col-span-full rounded-xl bg-neutral-50 p-5 text-sm text-neutral-500">Cargando cotizaciones…</p>
      </div>
    </section>

    <section class="mt-10" aria-labelledby="adrs-title">
      <div class="mb-3 flex flex-wrap items-end justify-between gap-2">
        <div>
          <p class="text-[11px] font-bold uppercase tracking-[.14em] text-brand">Wall Street</p>
          <h2 id="adrs-title" class="font-display text-2xl font-bold text-ink">ADRs argentinas</h2>
        </div>
        <span class="text-[11px] text-neutral-500">Precio en dólares · variación diaria</span>
      </div>
      <div id="mercados-adrs" class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        <p class="col-span-full rounded-xl bg-neutral-50 p-5 text-sm text-neutral-500">Cargando ADRs…</p>
      </div>
      <p id="mercados-nota" class="mt-3 text-xs leading-relaxed text-neutral-500"></p>
    </section>
    <p class="mt-10 border-t border-neutral-200 pt-4 text-[11px] leading-relaxed text-neutral-400">Información de referencia. Las cotizaciones pueden presentar demoras según la fuente y el horario de negociación. No constituye asesoramiento de inversión.</p>
  </main>
  <script is:inline>
  (function () {
    var fx = document.getElementById('mercados-divisas');
    var adrs = document.getElementById('mercados-adrs');
    var hora = document.getElementById('mercados-hora');
    function card(title, value, detail, positive) {
      var el = document.createElement('article');
      el.className = 'rounded-xl border border-neutral-200 bg-white p-4';
      var t = document.createElement('p'); t.className = 'text-xs font-semibold text-neutral-500'; t.textContent = title;
      var v = document.createElement('p'); v.className = 'mt-2 font-display text-xl font-extrabold tabular-nums text-ink'; v.textContent = value;
      el.appendChild(t); el.appendChild(v);
      if (detail) {
        var d = document.createElement('p'); d.className = 'mt-1 text-xs font-semibold tabular-nums ' + (positive === true ? 'text-emerald-700' : positive === false ? 'text-rose-700' : 'text-neutral-500'); d.textContent = detail; el.appendChild(d);
      }
      return el;
    }
    fetch('/api/mercados').then(function (r) { return r.ok ? r.json() : null; }).then(function (data) {
      if (!data) throw new Error('Sin respuesta');
      fx.replaceChildren();
      if (data.items && data.items.length) data.items.forEach(function (it) { fx.appendChild(card(it.nombre, it.valor, it.detalle, null)); });
      else fx.textContent = 'No hay cotizaciones disponibles en este momento.';
      adrs.replaceChildren();
      if (data.adrs && data.adrs.length) data.adrs.forEach(function (it) {
        var n = typeof it.change === 'number' ? it.change : null;
        adrs.appendChild(card(it.nombre + ' · ' + it.ticker, it.valor, n === null ? 'Variación no disponible' : it.changeLabel, n === null ? null : n >= 0));
      });
      else adrs.textContent = 'No hay cotizaciones de ADRs disponibles en este momento.';
      if (hora) hora.textContent = 'Actualizado ' + new Date(data.updatedAt || Date.now()).toLocaleString('es-AR', { dateStyle: 'short', timeStyle: 'short' });
      var note = document.getElementById('mercados-nota'); if (note) note.textContent = data.marketNote || '';
    }).catch(function () {
      fx.textContent = 'No se pudieron cargar las cotizaciones. Intentá nuevamente más tarde.';
      adrs.textContent = 'No se pudieron cargar las ADRs.';
      if (hora) hora.textContent = 'Datos temporalmente no disponibles';
    });
  })();
  </script>
</BaseLayout>
