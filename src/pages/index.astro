---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import NewsletterBox from '../components/NewsletterBox.astro';
import AdBanner from '../components/AdBanner.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION, nombreSeccion } from '../consts';

const articulos = (await getCollection('articulos')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const alerta = articulos.find((a) => a.data.ultimoMomento) ?? null;
const restoAlerta = alerta ? articulos.filter((a) => a.id !== alerta.id) : articulos;

const [principal, ...resto] = restoAlerta;
const ultimos = resto.slice(0, 6);
const destacados = resto.slice(6, 12);

const seccionesPortada = ['internacional', 'argentina', 'economia', 'deportes', 'cultura', 'tecnologia']
	.map((sec) => articulos.find((a) => a.data.section === sec))
	.filter(Boolean);

const liveStreamUrl = import.meta.env.LIVE_STREAM_URL;
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<!-- TICKER ÚLTIMO MOMENTO -->
	<div class="ticker mb-6 -mx-4 flex items-stretch overflow-hidden bg-neutral-950 sm:-mx-6 lg:-mx-8">
		<span class="flex flex-shrink-0 items-center gap-2 bg-neutral-900 px-4 py-2 text-[11px] font-extrabold tracking-[0.15em] text-white uppercase">
			<span class="luz-parpadeante inline-block h-2 w-2 rounded-full bg-white"></span>
			Último momento
		</span>
		<div class="ticker-scroll flex flex-1 items-center overflow-hidden pl-4 text-[13px] font-medium text-neutral-200">
			<span class="whitespace-nowrap">
				{alerta ? `${alerta.data.title}  •  ` : ''}
				{ultimos.slice(0, 3).map((a) => `${a.data.title}  •  `).join('')}
			</span>
		</div>
	</div>

	<!-- ÚLTIMO MOMENTO (The Guardian: kicker roja + titular gigante + foto) -->
	{
		alerta && (
			<article class="border-t-4 border-neutral-900">
				<a href={`/articulo/${alerta.id}/`} class="group block">
					<p class="um-banner mt-4"><span class="um-luz"></span>Último momento</p>
					<p class="mt-3 flex flex-wrap items-center gap-2 text-sm font-bold tracking-wider text-brand uppercase">
						{alerta.data.volanta && (
							<span class="font-semibold tracking-normal text-neutral-500 normal-case">· {alerta.data.volanta}</span>
						)}
					</p>
					<h1 class="mt-3 font-serif text-4xl leading-[1.05] font-black tracking-tight text-neutral-900 transition-colors group-hover:text-brand sm:text-5xl lg:text-6xl">
						{alerta.data.title}
					</h1>
					<p class="mt-5 max-w-3xl text-lg leading-relaxed text-neutral-600 sm:text-xl">
						{alerta.data.description}
					</p>
				</a>
				{alerta.data.heroImage && (
					<a href={`/articulo/${alerta.id}/`} class="mt-6 block overflow-hidden">
						<img
							src={typeof alerta.data.heroImage === 'string' ? alerta.data.heroImage : alerta.data.heroImage.src}
							alt=""
							class="w-full object-cover"
						/>
					</a>
				)}
				<p class="mt-3 mb-8 text-xs tracking-wide text-neutral-400 uppercase">
					<FormattedDate date={alerta.data.pubDate} />
				</p>
			</article>
		)
	}


	<!-- EN VIVO (se muestra solo si hay señal configurada) -->
	{
		liveStreamUrl && (
			<section class="mb-8 border border-neutral-300">
				<div class="flex items-center justify-between bg-neutral-950 px-4 py-2 text-neutral-100">
					<h2 class="flex items-center gap-2 font-serif text-[15px] font-extrabold tracking-[0.1em] uppercase">
						<span class="luz-parpadeante inline-block h-2.5 w-2.5 rounded-full bg-brand"></span>
						En vivo
					</h2>
					<span class="text-[11px] font-bold tracking-[0.2em] text-neutral-400">EL DIARIO TV</span>
				</div>
				<div class="grid lg:grid-cols-5">
					<div class="relative bg-neutral-950 lg:col-span-3" style="min-height:260px;">
						<iframe
							src={liveStreamUrl}
							class="absolute inset-0 h-full w-full"
							allowfullscreen
							loading="lazy"
						></iframe>
					</div>
					<div class="flex flex-col justify-center bg-neutral-50 p-5 lg:col-span-2">
						<p class="font-serif text-lg leading-snug font-extrabold">Señal en vivo de EL DIARIO</p>
						<p class="mt-2 text-xs text-neutral-500">Transmisión continua · Cobertura especial</p>
					</div>
				</div>
			</section>
		)
	}

	<!-- LEAD STORY (El País: titular a la izquierda, foto a la derecha) -->
	{
		principal && (
			<div class="grid items-start gap-8 border-t border-neutral-200 pt-8 pb-10 lg:grid-cols-2">
				<a href={`/articulo/${principal.id}/`} class="group block">
					<p class="text-xs font-bold tracking-[0.2em] text-brand uppercase">
						{nombreSeccion(principal.data.section)}
					</p>
					{principal.data.volanta && (
						<p class="mt-2 text-sm font-bold tracking-wide text-neutral-800 uppercase">{principal.data.volanta}</p>
					)}
					<h2 class="titular-link mt-3 font-serif text-3xl leading-[1.08] font-black tracking-tight text-neutral-900 transition-colors group-hover:text-brand sm:text-4xl lg:text-5xl">
						{principal.data.title}
					</h2>
					<p class="mt-4 text-lg leading-relaxed text-neutral-600">{principal.data.description}</p>
					<p class="mt-4 text-xs font-medium tracking-wide text-neutral-400 uppercase">
						<FormattedDate date={principal.data.pubDate} />
					</p>
				</a>
				<a href={`/articulo/${principal.id}/`} class="block overflow-hidden">
					{principal.data.heroImage ? (
						<img
							src={typeof principal.data.heroImage === 'string' ? principal.data.heroImage : principal.data.heroImage.src}
							alt=""
							class="w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
						/>
					) : (
						<div class="flex aspect-[4/3] w-full items-center justify-center bg-neutral-100 font-serif text-6xl font-bold text-neutral-300">
							EL DIARIO<span class="text-brand">.</span>
						</div>
					)}
				</a>
			</div>
		)
	}

	<!-- SECUNDARIAS + LO ÚLTIMO (retícula The Guardian) -->
	<div class="grid gap-10 border-t border-neutral-200 pt-8 lg:grid-cols-3">
		<div class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:col-span-2">
			{destacados.map((articulo) => <ArticleCard article={articulo} />)}
		</div>

		<aside class="lg:border-l lg:border-neutral-200 lg:pl-8">
			<h2 class="border-b-2 border-neutral-900 pb-2 font-serif text-lg font-bold">Lo último</h2>
			<div class="divide-y divide-neutral-200">
				{
					ultimos.map((articulo) => (
						<a href={`/articulo/${articulo.id}/`} class="group block py-3.5">
							<p class="text-[11px] font-bold tracking-[0.2em] text-brand uppercase">
								{nombreSeccion(articulo.data.section)}
							</p>
							<h3 class="mt-1 font-serif text-base leading-snug font-bold text-neutral-900 transition-colors group-hover:text-brand">
								{articulo.data.title}
							</h3>
							<p class="mt-1 text-xs text-neutral-400">
								<FormattedDate date={articulo.data.pubDate} />
							</p>
						</a>
					))
				}
			</div>

			<!-- ESPACIO PUBLICITARIO — sidebar derecho -->
			<div class="mt-8">
				<AdBanner position="sidebar" maxAds={1} />
			</div>

			<!-- SUSCRIPCIÓN — visible en el lateral -->
			<div class="mt-8">
				<NewsletterBox />
			</div>
		</aside>
	</div>

	<!-- POR SECCIÓN (reglas finas, sin fotos — estilo Guardian) -->
	{
		seccionesPortada.length > 0 && (
			<section class="mt-14 border-t-2 border-neutral-900 pt-6">
				<h2 class="sr-only">Por sección</h2>
				<div class="grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
					{seccionesPortada.map((articulo) => (
						<a href={`/articulo/${articulo.id}/`} class="group block border-t border-neutral-300 pt-4">
							<p class="text-[11px] font-bold tracking-[0.25em] text-brand uppercase">
								{nombreSeccion(articulo.data.section)}
							</p>
							<h3 class="mt-2 font-serif text-xl leading-tight font-bold text-neutral-900 transition-colors group-hover:text-brand">
								{articulo.data.title}
							</h3>
							<p class="mt-2 line-clamp-3 text-sm leading-relaxed text-neutral-600">
								{articulo.data.description}
							</p>
						</a>
					))}
				</div>
			</section>
		)
	}

</BaseLayout>
