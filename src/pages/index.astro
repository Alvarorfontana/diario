---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import NewsletterBox from '../components/NewsletterBox.astro';
import AdBanner from '../components/AdBanner.astro';
import FormattedDate from '../components/FormattedDate.astro';
import FranjaMercados from '../components/FranjaMercados.astro';
import BloqueEnVivo from '../components/BloqueEnVivo.astro';
import TemasDelDia from '../components/TemasDelDia.astro';
import PortadaRegional from '../components/PortadaRegional.astro';
import { SITE_TITLE, SITE_DESCRIPTION, nombreSeccion, FOTOS_COLUMNISTAS, volantaFuerte } from '../consts';
import BloqueEncuestas from '../components/BloqueEncuestas.astro';
import BloqueFlash from '../components/BloqueFlash.astro';
import { getArticulos } from '../lib/articles';
import { masLeidas } from '../lib/visitas';
import { seleccionarTapa } from '../lib/portada';
import { imagenNotaPath } from '../lib/og';

const articulos = await getArticulos();

// Fecha de hoy en Argentina: el cartel de WhatsApp de la portada cambia una vez por día.
const hoyAR = new Date(Date.now() - 3 * 60 * 60 * 1000).toISOString().slice(0, 10);

// Nota de tapa: la de riesgo país (fijada a mano) o la marcada como "último momento" en el panel.
const notaRiesgoPais = articulos.find((a) => a.slug === 'riesgo-pais-700-puntos-deuda-2027') ?? null;
const tapa = seleccionarTapa(articulos);
const resto = articulos.filter((a) => a.id !== tapa?.id);

// Cada nota aparece una sola vez en la portada.
const laterales = resto.slice(0, 2);
const ultimos = resto.slice(2, 8);
const destacados = resto.slice(8, 14);
const yaMostradas = new Set([tapa?.id, ...laterales.map((a) => a.id), ...ultimos.map((a) => a.id), ...destacados.map((a) => a.id)]);
const seccionesPortada = ['internacional', 'argentina', 'economia', 'deportes', 'cultura', 'tecnologia']
	.map((sec) => articulos.find((a) => a.section === sec && !yaMostradas.has(a.id)))
	.filter((a): a is NonNullable<typeof a> => Boolean(a));
seccionesPortada.forEach((a) => yaMostradas.add(a.id));

// Opinión con caras: las últimas columnas que no aparecieron más arriba.
const opinion = articulos.filter((a) => a.section === 'opinion' && !yaMostradas.has(a.id)).slice(0, 3);
// Lo más leído: ranking real de visitas (si la base de visitas está conectada en Vercel).
const slugsMasLeidas = await masLeidas(8, Astro.locals);
const masLeidasNotas = slugsMasLeidas
	.map((s) => articulos.find((a) => a.slug === s))
	.filter((a): a is NonNullable<typeof a> => Boolean(a))
	.slice(0, 5);

const fotoPortada = (a: (typeof articulos)[number], ancho = 1200) => a.image_url && /^https?:\/\//i.test(a.image_url) ? imagenNotaPath(a.slug, a.image_url, ancho) : a.image_url;

const iniciales = (nombre: string) => (nombre || 'R').split(' ').filter(Boolean).map((w) => w[0]).join('').toUpperCase().slice(0, 2);

// Último momento: las notas marcadas en el panel, y si no hay, las más recientes.
const marcadas = articulos.filter((a) => a.breaking);
const ticker = (marcadas.length > 0 ? marcadas : [tapa, ...resto.slice(0, 4)].filter(Boolean)).slice(0, 6);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} ogImage={`/api/og-portada.jpg?d=${hoyAR}`}>

	<!-- MERCADOS -->
	<FranjaMercados />

	<!-- ÚLTIMO MOMENTO -->
	{ticker.length > 0 && (
		<div class="flex h-11 items-center overflow-hidden rounded-xl bg-ink text-white">
			<span class="flex shrink-0 items-center gap-2 px-4 text-[11px] font-extrabold tracking-[0.1em] uppercase">
				<span class="titila inline-block h-2 w-2 rounded-full bg-[#ff3b3b]" aria-hidden="true"></span>
				Último momento
			</span>
			<div class="min-w-0 flex-1 overflow-hidden">
				<div class="marquesina">
					{[...ticker, ...ticker].map((a, i) => (
						<a href={`/articulo/${a!.slug}/`} class="flex items-center gap-2 text-[13.5px] font-medium whitespace-nowrap text-white hover:underline" aria-hidden={i >= ticker.length ? 'true' : undefined} tabindex={i >= ticker.length ? -1 : undefined}>
							<span class="inline-block h-1.5 w-1.5 rounded-full bg-[#ff3b3b]" aria-hidden="true"></span>{a!.title}
						</a>
					))}
				</div>
			</div>
		</div>
	)}

	<!-- TEMAS DEL DÍA (se arma solo con las etiquetas más usadas) -->
	<TemasDelDia articulos={articulos} />

	<!-- EN VIVO (solo cuando hay cobertura activa) -->
	<BloqueEnVivo />

	<!-- TAPA: foto grande con el título encima, y dos destacadas al costado -->
	{tapa && (
		<section class="mt-5 grid gap-4 lg:grid-cols-3">
			<a href={`/articulo/${tapa.slug}/`} class="group relative block min-h-[360px] overflow-hidden rounded-2xl bg-ink text-white lg:col-span-2 lg:min-h-[500px]">
				{tapa.image_url && <img src={fotoPortada(tapa)} data-fallback-src={/^https?:\/\//i.test(tapa.image_url) ? tapa.image_url : undefined} alt="" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.02]" />}
				<div class="absolute inset-0 bg-gradient-to-b from-black/0 via-black/20 to-black/85"></div>
				<div class="absolute inset-x-5 bottom-5 sm:inset-x-8 sm:bottom-7">
					<span class="inline-flex items-center gap-2 rounded-full bg-brand px-3 py-1.5 text-xs font-bold">
						{tapa.breaking || tapa === notaRiesgoPais ? <><span class="titila inline-block h-1.5 w-1.5 rounded-full bg-white"></span>Último momento</> : nombreSeccion(tapa.section)}
					</span>
					{tapa.volanta && <p class="mt-3 text-xs font-extrabold tracking-[0.1em] text-white/90 uppercase">{tapa.volanta}</p>}
					<h1 class="mt-3 font-display text-[1.75rem] leading-[1.12] font-extrabold tracking-[-0.015em] text-white sm:text-4xl lg:text-[2.6rem]">{tapa.title}</h1>
					<p class="mt-3 hidden max-w-2xl text-base leading-relaxed text-white/85 sm:block">{tapa.excerpt}</p>
					<p class="mt-3 text-xs text-white/80">{tapa.author} · <FormattedDate date={tapa.date} /></p>
				</div>
			</a>
			<div class="grid gap-4">
				{laterales.map((a) => (
					<a href={`/articulo/${a.slug}/`} class="group relative block min-h-[220px] overflow-hidden rounded-2xl bg-ink text-white">
						{a.image_url && <img src={fotoPortada(a, 640)} data-fallback-src={/^https?:\/\//i.test(a.image_url) ? a.image_url : undefined} alt="" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" loading="lazy" />}
						<div class="absolute inset-0 bg-gradient-to-b from-black/0 via-black/10 to-black/85"></div>
						<div class="absolute inset-x-5 bottom-4">
							<span class="inline-block rounded-full bg-white px-2.5 py-1 text-[11px] font-bold text-ink">{nombreSeccion(a.section)}</span>
							<h2 class="mt-2 font-display text-lg leading-snug font-extrabold text-white sm:text-xl">{a.title}</h2>
						</div>
					</a>
				))}
			</div>
		</section>
	)}

	<!-- ÚLTIMAS NOTICIAS + LO ÚLTIMO -->
	<div class="mt-8 grid gap-6 lg:grid-cols-3">
		<section class="tarjeta p-4 sm:p-6 lg:col-span-2">
			<h2 class="titulo-seccion mb-5">Últimas noticias</h2>
			<div class="grid gap-5 sm:grid-cols-2">
				{destacados.map((articulo) => <ArticleCard article={articulo} />)}
			</div>
		</section>

		<aside class="flex flex-col gap-6">
			{masLeidasNotas.length >= 3 && (
				<section class="tarjeta p-5">
					<h2 class="titulo-seccion mb-2 text-xl">Lo más leído</h2>
					<ol>
						{masLeidasNotas.map((a, i) => (
							<li class="border-b border-[#eeeeea] last:border-0">
								<a href={`/articulo/${a.slug}/`} class="group flex items-start gap-3 py-3">
									<span class="w-7 shrink-0 font-display text-[28px] leading-none font-extrabold text-brand">{i + 1}</span>
									<span class="font-display text-[15px] leading-snug font-bold text-ink group-hover:text-brand">{a.title}</span>
								</a>
							</li>
						))}
					</ol>
				</section>
			)}
			<section class="tarjeta p-5">
				<h2 class="titulo-seccion mb-2 text-xl">Lo último</h2>
				<ol>
					{ultimos.map((a, i) => (
						<li class="border-b border-[#eeeeea] last:border-0">
							<a href={`/articulo/${a.slug}/`} class="group flex items-start gap-3 py-3">
								<span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand/10 font-display text-sm font-extrabold text-brand">{i + 1}</span>
								<span>
									{volantaFuerte(a.volanta)
										? <span class="inline-block rounded bg-brand px-1.5 py-0.5 text-[10px] font-extrabold tracking-[0.08em] text-white uppercase">{a.volanta}</span>
										: <span class="block text-[10.5px] font-bold tracking-[0.08em] text-brand uppercase">{a.volanta || nombreSeccion(a.section)}</span>}
									<span class="mt-0.5 block font-display text-[15px] leading-snug font-bold text-ink group-hover:text-brand">{a.title}</span>
								</span>
							</a>
						</li>
					))}
				</ol>
			</section>
			<!-- FLASH: último video de la semana (solo si hay uno publicado) -->
			<BloqueFlash />
			<BloqueEncuestas articulos={articulos} />
			<AdBanner position="sidebar" maxAds={1} />
		</aside>
	</div>

	<!-- TU REGIÓN (pestañas por región, recuerda la elección del lector) -->
	<PortadaRegional articulos={articulos} />

	<!-- POR SECCIÓN -->
	{seccionesPortada.length > 0 && (
		<section class="mt-8">
			<h2 class="titulo-seccion mb-5">Por sección</h2>
			<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
				{seccionesPortada.map((articulo) => <ArticleCard article={articulo} />)}
			</div>
		</section>
	)}

	<!-- OPINIÓN -->
	{opinion.length > 0 && (
		<section class="mt-8">
			<div class="mb-5 flex items-baseline justify-between">
				<h2 class="titulo-seccion">Opinión</h2>
				<a href="/seccion/opinion/" class="text-sm font-semibold text-brand hover:underline">Ver todas</a>
			</div>
			<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
				{opinion.map((a) => (
					<a href={`/articulo/${a.slug}/`} class="tarjeta group flex items-start gap-4 p-5">
						{FOTOS_COLUMNISTAS[a.author] ? (
							<img src={FOTOS_COLUMNISTAS[a.author]} alt="" class="h-16 w-16 shrink-0 rounded-full object-cover" loading="lazy" />
						) : (
							<span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-ink font-display text-lg font-extrabold text-white" aria-hidden="true">{iniciales(a.author)}</span>
						)}
						<span class="min-w-0">
							<span class="block text-sm font-bold text-brand">{a.author}</span>
							<span class="mt-1 block font-display text-[17px] leading-snug font-bold text-ink group-hover:text-brand">{a.title}</span>
						</span>
					</a>
				))}
			</div>
		</section>
	)}

	<!-- CONTEXTO POLÍTICO -->
	<section class="mt-8 grid items-center gap-5 rounded-2xl bg-ink p-6 text-white sm:p-8 md:grid-cols-3">
		<div class="md:col-span-2">
			<p class="text-xs font-bold tracking-[0.15em] text-[#ff6b6b] uppercase">Especial · Archivo editorial</p>
			<h2 class="mt-2 font-display text-3xl font-extrabold text-white">Contexto Político</h2>
			<p class="mt-2 text-white/75">Artículos de análisis, historia, geopolítica y pensamiento, organizados en un archivo de lectura.</p>
		</div>
		<a href="/contexto-politico/" class="inline-flex items-center justify-center rounded-xl bg-brand px-5 py-4 text-center text-sm font-bold text-white hover:bg-brand-dark">Explorar los artículos →</a>
	</section>

	<!-- BOLETÍN -->
	<NewsletterBox />
</BaseLayout>
