---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Comentarios from '../../components/Comentarios.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import EscucharNota from '../../components/EscucharNota.astro';
import ImprimirNota from '../../components/ImprimirNota.astro';
import AdBanner from '../../components/AdBanner.astro';
import NewsletterBox from '../../components/NewsletterBox.astro';
import CompartirFinal from '../../components/CompartirFinal.astro';
import TePuedeInteresar from '../../components/TePuedeInteresar.astro';
import SeguiLeyendoFlotante from '../../components/SeguiLeyendoFlotante.astro';
import SobreLaFirma from '../../components/SobreLaFirma.astro';
import { nombreSeccion, SITE_TITLE, slugify, fotoAutor } from '../../consts';
import { getArticulos } from '../../lib/articles';
import { ogImagePath, imagenNotaPath } from '../../lib/og';
import { render } from 'astro:content';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) {
	return Astro.redirect('/404');
}

const todos = await getArticulos();
const articulo = todos.find((a) => a.slug === slug);

if (!articulo) {
	return Astro.redirect('/404');
}

const { title, volanta, excerpt, section, author, ciudad, region, date, image_url, imageCaption, tags, puntosClave, resumenCompartir, correccion } = articulo;
const { Content } = await render(articulo.entry);

// Portada propia de 1200x630 para las vistas previas (WhatsApp, Facebook, X).
// La genera src/pages/api/og/[slug].ts a partir de la foto de la nota.
const ogImage = ogImagePath(slug, image_url);

// La foto que se ve dentro de la nota también se sirve desde nuestro dominio
// (ver src/pages/api/img/[slug].ts). Si ya es propia, se usa tal cual.
const fotoVisible = /^https?:\/\//i.test(image_url) ? imagenNotaPath(slug, image_url) : image_url;

const fecha = new Date(date);
// Fecha de la firma, como El País: 17 NOV 2026 - 14:09 ART (hora argentina)
const fechaFirma = (() => {
	const p = new Intl.DateTimeFormat('es-AR', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', hourCycle: 'h23', timeZone: 'America/Argentina/Buenos_Aires' }).formatToParts(fecha);
	const v = (t: string) => p.find((x) => x.type === t)?.value ?? '';
	return `${v('day')} ${v('month').replace('.', '').toUpperCase()} ${v('year')} - ${v('hour')}:${v('minute')} ART`;
})();

// Hora de publicación para la lista de "Últimas noticias" (05:45, hora argentina).
// La página se arma en cada visita, así que la lista siempre está al día sin despliegues extra.
const diaAR = (d: Date) => new Intl.DateTimeFormat('es-AR', { dateStyle: 'short', timeZone: 'America/Argentina/Buenos_Aires' }).format(d);
const horaNota = (d: string | Date) => {
	const f = new Date(d);
	if (diaAR(f) === diaAR(new Date())) return new Intl.DateTimeFormat('es-AR', { hour: '2-digit', minute: '2-digit', hourCycle: 'h23', timeZone: 'America/Argentina/Buenos_Aires' }).format(f);
	return new Intl.DateTimeFormat('es-AR', { day: 'numeric', month: 'short', timeZone: 'America/Argentina/Buenos_Aires' }).format(f).replace('.', '');
};

// Foto del autor. Mientras no haya foto cargada en consts.ts, se usa una ilustración provisoria.
const fotoFirma = fotoAutor(author || '') ?? '/autores/foto-provisoria.svg';

// Tiempo estimado de lectura (≈200 palabras por minuto)
const textoPlano = (articulo.entry.body ?? '').replace(/<[^>]*>/g, ' ').trim();
const palabras = textoPlano.split(/\s+/).filter(Boolean).length;
const minutosLectura = Math.max(1, Math.round(palabras / 200));

// Artículos relacionados de la misma sección (máximo 3)
const relacionados = todos.filter((a) => a.section === section && a.slug !== slug).slice(0, 3);
// Noticias recientes para la columna lateral, excluyendo la nota que se está leyendo.
const ultimasRelacionadas = todos.filter((a) => a.slug !== slug).slice(0, 5);
// Próxima nota para la barrita flotante "Seguí leyendo" y otra distinta para "Te puede interesar".
const proximaNota = relacionados[0] ?? ultimasRelacionadas[0];
const notaInteresar = todos.find((a) => a.slug !== slug && a.slug !== proximaNota?.slug && a.section !== section) ?? ultimasRelacionadas.find((a) => a.slug !== proximaNota?.slug);
const fotoChica = (a?: (typeof todos)[number]) => a?.image_url ? (/^https?:\/\//i.test(a.image_url) ? imagenNotaPath(a.slug, a.image_url, 320) : a.image_url) : undefined;

// Datos estructurados para Google (Schema.org NewsArticle)
const siteOrigin = Astro.site ?? Astro.url.origin;
const schema = {
	'@context': 'https://schema.org',
	'@type': 'NewsArticle',
	headline: title,
	description: excerpt ?? '',
	...(image_url ? { image: [new URL(image_url, siteOrigin).toString()] } : {}),
	datePublished: fecha.toISOString(),
	dateModified: fecha.toISOString(),
	author: { '@type': 'Person', name: author || 'Redacción' },
	publisher: {
		'@type': 'Organization',
		name: SITE_TITLE,
		logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', siteOrigin).toString() },
	},
	mainEntityOfPage: { '@type': 'WebPage', '@id': Astro.url.href },
};
import { nombreRegion } from '../../lib/regiones';
---

<BaseLayout
	title={`${title} | ${SITE_TITLE}`}
	description={resumenCompartir || excerpt}
	image={image_url}
	ogImage={ogImage}
	publishedTime={fecha}
	author={author}
	section={nombreSeccion(section || '')}
>
	<!-- Datos estructurados para buscadores -->
	<script type="application/ld+json" set:html={JSON.stringify(schema)} />

	<!-- Barra fija con el titular: aparece al scrollear (estilo El País / Washington Post) -->
	<div id="barra-fija" class="fixed inset-x-0 top-0 z-50 -translate-y-full border-b border-neutral-200 bg-white/95 shadow-sm backdrop-blur transition-transform duration-200">
		<div class="mx-auto flex max-w-[1100px] items-center gap-3 px-4 py-2">
			<button id="barra-menu" type="button" aria-label="Secciones" class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[#f0f0ec] text-ink hover:bg-neutral-200">
				<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
			</button>
			<span class="shrink-0 text-[11px] font-bold uppercase tracking-widest text-brand">{nombreSeccion(section || '')}</span>
			<span class="h-4 w-px shrink-0 bg-neutral-300"></span>
			<span class="truncate text-sm font-semibold text-neutral-900">{title}</span>
		</div>
		<div class="h-[3px] w-full bg-neutral-100"><div id="progreso-lectura" class="h-full w-0 bg-brand"></div></div>
	</div>

	<article class="nota-articulo mx-auto w-full max-w-[1100px]" data-pagefind-body>
		<!-- Solo en la versión impresa / PDF -->
		<div class="solo-impresion encabezado-impresion" aria-hidden="true">
			<span class="marca-impresion">{SITE_TITLE}</span>
			<span class="sitio-impresion">diariofederal.com.ar</span>
		</div>

		<header class="mx-auto w-full max-w-[760px] lg:max-w-none">
			<div class="flex items-center gap-3">
				<a href={`/seccion/${section}/`} class="rounded-full bg-brand px-3 py-1.5 text-xs font-bold text-white" data-pagefind-filter="Sección">{nombreSeccion(section || '')}</a>
				<span class="text-xs text-neutral-500">{minutosLectura} min de lectura</span>
			</div>
			{
				volanta && (
					<p class="mt-3 text-sm font-bold tracking-wide text-neutral-800 uppercase">{volanta}</p>
				)
			}
			<h1 class="mt-3 font-display text-[1.85rem] leading-[1.14] font-extrabold tracking-[-0.015em] text-ink sm:text-[2.6rem]">
				{title}
			</h1>
			<p class="bajada mt-4 text-[17px] leading-relaxed text-neutral-600 sm:text-[19px]">{excerpt}</p>
			<!-- Firma estilo El País: foto, nombre en versalitas con serif, lugar y fecha, una línea y abajo compartir + Google -->
			<div class="mt-7 flex items-start gap-4">
				<img src={fotoFirma} alt={`Foto de ${author || "la redacción"}`} width="64" height="64" class="h-16 w-16 shrink-0 rounded-full bg-neutral-200 object-cover grayscale" loading="eager" />
				<div class="min-w-0 flex-1">
					<a href={`/autor/${slugify(author || 'Redacción')}/`} class="font-sans text-[13px] font-bold uppercase tracking-[0.02em] text-ink hover:text-brand">{author || 'Redacción'}</a>
					<p class="mt-1 text-[12px] text-neutral-600">
						{ciudad && <>{ciudad} - </>}{!ciudad && region && <><a href={`/region/${region}/`} class="hover:text-brand">{nombreRegion(region)}</a> - </>}{fechaFirma}
					</p>
					<div class="mt-3 flex flex-wrap items-center justify-between gap-3 border-t border-[#d9d9d4] pt-3" data-no-imprimir>
						<ShareButtons url={Astro.url.href} title={title}>
							<ImprimirNota />
						</ShareButtons>
						<a href="#comentarios" aria-label="Ir a los comentarios" class="inline-flex items-center gap-1.5 rounded-full bg-[#f0f0ec] px-3.5 py-1.5 text-[14px] font-semibold text-ink hover:bg-neutral-200">
							<span data-cuenta-comentarios>0</span>
							<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 4c4.97 0 9 3.36 9 7.5S16.97 19 12 19c-1.1 0-2.15-.16-3.12-.46L4 20l1.4-3.6C4.5 15.1 3 13.4 3 11.5 3 7.36 7.03 4 12 4z"></path></svg>
						</a>
						<a href="https://www.google.com/preferences/source?q=diariofederal.com.ar" target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full border border-[#d9d9d4] bg-white px-3.5 py-1.5 text-[12.5px] font-medium text-ink hover:border-neutral-400">
							<svg width="16" height="16" viewBox="0 0 48 48" aria-hidden="true"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/></svg>
							Añadir EL DIARIO en Google
						</a>
					</div>
				</div>
			</div>

			<div data-no-imprimir>
				<EscucharNota slug={slug} title={title} />
			</div>

			{image_url && (
				<figure class="mt-6">
					<img src={fotoVisible} data-fallback-src={/^https?:\/\//i.test(image_url) ? image_url : undefined} alt={title} class={`w-full rounded-2xl ${slug === "2026-11-06-santiago-pena-detenido-fiscalia-ueno-bank" ? "aspect-[4/5] max-h-[560px] w-full object-contain object-top rounded-2xl bg-neutral-100" : "aspect-video object-cover object-center"}`} loading="eager" />
					{imageCaption && <figcaption class="epigrafe mt-2 text-sm text-neutral-500">{imageCaption}</figcaption>}
				</figure>
			)}

			{
				tags && Array.isArray(tags) && tags.length > 0 && (
					<div class="mt-4 flex flex-wrap gap-2" data-no-imprimir>
						{tags.map((etiqueta: string) => (
							<a
								href={`/tag/${slugify(etiqueta)}/`}
								class="rounded-full bg-white px-3 py-1.5 text-xs font-semibold text-neutral-700 shadow-[inset_0_0_0_1px_#dcdcd6] transition-colors hover:text-brand"
							>
								#{etiqueta}
							</a>
						))}
					</div>
				)
			}
		</header>

		<div class="mx-auto mt-8 grid w-full max-w-[760px] grid-cols-1 items-start gap-8 lg:max-w-none lg:grid-cols-[minmax(0,760px)_minmax(260px,320px)] lg:justify-between">
		<div class="min-w-0">
		{
			puntosClave && puntosClave.length > 0 && (
				<section class="tarjeta px-5 py-4 shadow-[inset_0_0_0_1px_#e6e6e2]" aria-label="Lo que tenés que saber">
					<p class="font-display text-[15px] font-extrabold text-ink">Lo que tenés que saber</p>
					<ul class="mt-3 flex flex-col gap-2.5">
						{puntosClave.map((punto: string) => (
							<li class="flex gap-2.5 text-[15px] leading-relaxed text-neutral-800">
								<span class="mt-[9px] inline-block h-[7px] w-[7px] shrink-0 rounded-full bg-brand" aria-hidden="true"></span>
								<span>{punto}</span>
							</li>
						))}
					</ul>
				</section>
			)
		}

		<div class="prose-articulo mx-auto mt-10 w-full max-w-[760px]">
			<Content />
		</div>

		{notaInteresar && <TePuedeInteresar slug={notaInteresar.slug} title={notaInteresar.title} />}

		<CompartirFinal url={new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString()} title={title} />

		{
			tags && Array.isArray(tags) && tags.length > 0 && (
				<section class="mt-8" aria-label="Temas relacionados" data-no-imprimir>
					<h2 class="flex items-center gap-2 font-display text-xl font-extrabold text-ink"><span class="text-2xl font-normal leading-none" aria-hidden="true">+</span>Temas relacionados</h2>
					<div class="mt-4 flex flex-wrap gap-2.5">
						{tags.map((etiqueta: string) => (
							<a href={`/tag/${slugify(etiqueta)}/`} class="rounded-full bg-[#f0f0ec] px-4 py-2 text-[14px] text-neutral-700 transition-colors hover:bg-neutral-200 hover:text-ink">{etiqueta}</a>
						))}
						<a href="/" class="rounded-full bg-[#f0f0ec] px-4 py-2 text-[14px] text-neutral-700 transition-colors hover:bg-neutral-200 hover:text-ink">Últimas noticias</a>
					</div>
				</section>
			)
		}

		{
			correccion && (
				<aside class="mt-10 border-l-4 border-neutral-400 bg-neutral-50 px-5 py-4" aria-label="Fe de erratas">
					<p class="text-xs font-bold uppercase tracking-widest text-neutral-600">Fe de erratas</p>
					<p class="mt-2 text-[15px] leading-relaxed text-neutral-800">{correccion}</p>
				</aside>
			)
		}

		<SobreLaFirma author={author} />

		</div>
		<aside class="min-w-0 space-y-6 lg:sticky lg:top-20" aria-label="Más noticias y publicidad" data-no-imprimir>
			<section class="tarjeta p-5">
				<h2 class="titulo-seccion mb-3 text-xl">Últimas noticias</h2>
				<ol>
					{ultimasRelacionadas.map((nota, i) => (
						<li class="border-b border-[#eeeeea] last:border-0">
							<a href={`/articulo/${nota.slug}/`} class="group flex items-start gap-3 py-3">
								<span class="w-6 shrink-0 font-display text-xl leading-none font-extrabold text-brand">{i + 1}</span>
								<span>
									<span class="block text-[10px] font-bold tracking-wider text-brand uppercase"><time datetime={new Date(nota.date).toISOString()} class="mr-1.5 text-[#c8102e]">{horaNota(nota.date)}</time><span class="mr-1.5 text-neutral-300" aria-hidden="true">|</span>{nombreSeccion(nota.section || '')}</span>
									<span class="mt-1 block font-display text-sm leading-snug font-bold text-ink group-hover:text-brand">{nota.title}</span>
								</span>
							</a>
						</li>
					))}
				</ol>
			</section>
			<AdBanner position="sidebar" maxAds={1} />
		</aside>
		</div>

		<div class="solo-impresion pie-impresion" aria-hidden="true">
			Nota publicada en {SITE_TITLE} · {new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString()}
		</div>
	</article>

	<!-- Publicidad y comentarios alineados con la columna del texto -->
	<div class="mx-auto w-full max-w-[1100px]" data-no-imprimir>
		<div class="mx-auto max-w-[760px] lg:mx-0">
			<AdBanner position="in-article" maxAds={1} />
			<Comentarios
				identifier={slug}
				url={new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString()}
				title={title}
			/>
		</div>
	</div>

	{
		relacionados.length > 0 && (
			<section class="tarjeta mx-auto mt-12 max-w-6xl p-4 sm:p-6">
				<h2 class="titulo-seccion">Seguí leyendo en {nombreSeccion(section || '')}</h2>
				<div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
					{relacionados.map((relacionado) => (
						<ArticleCard article={relacionado} />
					))}
				</div>
			</section>
		)
	}

	<div class="mx-auto max-w-6xl"><NewsletterBox /></div>

	{proximaNota && <SeguiLeyendoFlotante slug={proximaNota.slug} title={proximaNota.title} foto={fotoChica(proximaNota)} />}
</BaseLayout>

<script is:inline define:vars={{ slugVisita: slug }}>
	// Cuenta una visita por nota y por sesión para "Lo más leído".
	try {
		var k = 'visto:' + slugVisita;
		if (!sessionStorage.getItem(k)) {
			sessionStorage.setItem(k, '1');
			fetch('/api/visita', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ slug: slugVisita }), keepalive: true }).catch(function () {});
		}
	} catch (e) {}
</script>

<script is:inline>
	(function () {
		var barraFija = document.getElementById('barra-fija');
		var progreso = document.getElementById('progreso-lectura');
		var articulo = document.querySelector('[data-pagefind-body]');
		if (!articulo) return;

		// El ☰ de la barra abre el mismo menú de secciones de la cabecera (como El País).
		var botonMenu = document.getElementById('barra-menu');
		var menuCab = document.querySelector('details.menu-secciones');
		if (botonMenu && menuCab) {
			botonMenu.addEventListener('click', function (ev) {
				ev.stopPropagation();
				menuCab.open = true;
				actualizar();
			});
			menuCab.addEventListener('toggle', function () { actualizar(); });
		}

		function actualizar() {
			var y = window.scrollY || window.pageYOffset;
			if (barraFija) {
				var menu = document.querySelector('details.menu-secciones');
				var mostrar = y > 420 && !(menu && menu.open);
				barraFija.classList.toggle('mostrar', mostrar);
				// Estilo directo: no depende de clases CSS externas
				barraFija.style.transform = mostrar ? 'translateY(0)' : '';
				barraFija.style.translate = mostrar ? '0 0' : '';
			}
			if (!progreso) return;
			var rect = articulo.getBoundingClientRect();
			var alturaTotal = rect.height - window.innerHeight;
			if (alturaTotal <= 0) {
				progreso.style.width = '100%';
				return;
			}
			var recorrido = Math.min(Math.max(-rect.top, 0), alturaTotal);
			progreso.style.width = ((recorrido / alturaTotal) * 100) + '%';
		}

		document.addEventListener('scroll', actualizar, { passive: true });
		window.addEventListener('resize', actualizar);
		actualizar();
	})();
</script>

