---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Comentarios from '../../components/Comentarios.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import AdBanner from '../../components/AdBanner.astro';
import { nombreSeccion, SITE_TITLE, slugify } from '../../consts';
import { getArticulos } from '../../lib/articles';
import { render } from 'astro:content';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) {
	return Astro.redirect('/404');
}

const todos = await getArticulos();
const articulo = todos.find((a) => a.slug === slug);

if (!articulo) {
	return Astro.redirect('/404');
}

const { title, volanta, excerpt, section, author, date, image_url, imageCaption, tags } = articulo;
const { Content } = await render(articulo.entry);

const fecha = new Date(date);

// Tiempo estimado de lectura (≈200 palabras por minuto)
const textoPlano = (articulo.entry.body ?? '').replace(/<[^>]*>/g, ' ').trim();
const palabras = textoPlano.split(/\s+/).filter(Boolean).length;
const minutosLectura = Math.max(1, Math.round(palabras / 200));

// Artículos relacionados de la misma sección (máximo 3)
const relacionados = todos.filter((a) => a.section === section && a.slug !== slug).slice(0, 3);

// Datos estructurados para Google (Schema.org NewsArticle)
const siteOrigin = Astro.site ?? Astro.url.origin;
const schema = {
	'@context': 'https://schema.org',
	'@type': 'NewsArticle',
	headline: title,
	description: excerpt ?? '',
	...(image_url ? { image: [new URL(image_url, siteOrigin).toString()] } : {}),
	datePublished: fecha.toISOString(),
	dateModified: fecha.toISOString(),
	author: { '@type': 'Person', name: author || 'Redacción' },
	publisher: {
		'@type': 'Organization',
		name: SITE_TITLE,
		logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', siteOrigin).toString() },
	},
	mainEntityOfPage: { '@type': 'WebPage', '@id': Astro.url.href },
};
---

<BaseLayout
	title={`${title} | ${SITE_TITLE}`}
	description={excerpt}
	image={image_url}
	publishedTime={fecha}
	author={author}
	section={nombreSeccion(section || '')}
>
	<!-- Datos estructurados para buscadores -->
	<script type="application/ld+json" set:html={JSON.stringify(schema)} />

	<!-- Barra fija con el titular: aparece al scrollear (estilo El País / Washington Post) -->
	<div id="barra-fija" class="fixed inset-x-0 top-0 z-50 -translate-y-full border-b border-neutral-200 bg-white/95 shadow-sm backdrop-blur transition-transform duration-200">
		<div class="mx-auto flex max-w-[680px] items-center gap-3 px-4 py-2.5">
			<span class="shrink-0 text-[11px] font-bold uppercase tracking-widest text-brand">{nombreSeccion(section || '')}</span>
			<span class="h-4 w-px shrink-0 bg-neutral-300"></span>
			<span class="truncate text-sm font-semibold text-neutral-900">{title}</span>
		</div>
		<div class="h-[3px] w-full bg-neutral-100"><div id="progreso-lectura" class="h-full w-0 bg-brand"></div></div>
	</div>

	<article class="mx-auto max-w-[680px]" data-pagefind-body>
		<header>
			<p class="text-xs font-semibold tracking-widest text-brand uppercase" data-pagefind-filter="Sección">
				{nombreSeccion(section || '')}
			</p>
			{
				volanta && (
					<p class="mt-3 text-sm font-bold tracking-wide text-neutral-800 uppercase">{volanta}</p>
				)
			}
			<h1 class="mt-2 font-serif text-3xl leading-[1.12] font-bold sm:text-[2.75rem]">
				{title}
			</h1>
			<p class="mt-4 text-lg leading-relaxed text-neutral-600 sm:text-xl">{excerpt}</p>

			<div class="mt-6 flex items-center gap-3 border-y border-neutral-200 py-4">
				<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-neutral-900 text-sm font-bold text-white">
					{(author || 'R').split(' ').map((w: string) => w[0]).join('').toUpperCase().slice(0, 2)}
				</div>
				<div>
					<p class="text-sm font-semibold text-neutral-900">{author || 'Redacción'}</p>
					<p class="text-xs text-neutral-500">
						<FormattedDate date={fecha} />
						<span class="mx-1.5">·</span>
						{minutosLectura} min de lectura
					</p>
				</div>
				<div class="ml-auto">
					<ShareButtons url={Astro.url.href} title={title} />
				</div>
			</div>

			{
				tags && Array.isArray(tags) && tags.length > 0 && (
					<div class="mt-4 flex flex-wrap gap-2">
						{tags.map((etiqueta: string) => (
							<a
								href={`/tag/${slugify(etiqueta)}/`}
								class="rounded-full border border-neutral-300 bg-paper px-3 py-1 text-xs text-neutral-600 transition-colors hover:border-brand hover:text-brand"
							>
								#{etiqueta}
							</a>
						))}
					</div>
				)
			}
		</header>

		{
			image_url && (
				<figure class="mt-8 overflow-hidden rounded-lg">
					<img src={image_url} alt={title} class="w-full h-auto object-cover object-center" loading="eager" />
					{imageCaption && <figcaption class="mt-2 text-sm text-neutral-500">{imageCaption}</figcaption>}
				</figure>
			)
		}

		<div class="prose-articulo mt-10">
			<Content />
		</div>
	</article>

	<AdBanner position="in-article" maxAds={1} />

	<Comentarios
		identifier={slug}
		url={new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString()}
		title={title}
	/>

	{
		relacionados.length > 0 && (
			<section class="mx-auto mt-16 max-w-6xl border-t-2 border-neutral-900 pt-8">
				<h2 class="font-serif text-2xl font-bold">Más en {nombreSeccion(section || '')}</h2>
				<div class="mt-6 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
					{relacionados.map((relacionado) => (
						<ArticleCard article={relacionado} />
					))}
				</div>
			</section>
		)
	}
</BaseLayout>

<script is:inline>
	(function () {
		var barraFija = document.getElementById('barra-fija');
		var progreso = document.getElementById('progreso-lectura');
		var articulo = document.querySelector('[data-pagefind-body]');
		if (!articulo) return;

		function actualizar() {
			var y = window.scrollY || window.pageYOffset;
			if (barraFija) {
				var mostrar = y > 420;
				barraFija.classList.toggle('mostrar', mostrar);
				// Estilo directo: no depende de clases CSS externas
				barraFija.style.transform = mostrar ? 'translateY(0)' : '';
				barraFija.style.translate = mostrar ? '0 0' : '';
			}
			if (!progreso) return;
			var rect = articulo.getBoundingClientRect();
			var alturaTotal = rect.height - window.innerHeight;
			if (alturaTotal <= 0) {
				progreso.style.width = '100%';
				return;
			}
			var recorrido = Math.min(Math.max(-rect.top, 0), alturaTotal);
			progreso.style.width = ((recorrido / alturaTotal) * 100) + '%';
		}

		document.addEventListener('scroll', actualizar, { passive: true });
		window.addEventListener('resize', actualizar);
		actualizar();
	})();
</script>

