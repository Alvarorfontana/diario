---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Comentarios from '../../components/Comentarios.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import EscucharNota from '../../components/EscucharNota.astro';
import AdBanner from '../../components/AdBanner.astro';
import NewsletterBox from '../../components/NewsletterBox.astro';
import { nombreSeccion, SITE_TITLE, slugify } from '../../consts';
import { getArticulos } from '../../lib/articles';
import { ogImagePath, imagenNotaPath } from '../../lib/og';
import { render } from 'astro:content';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) {
	return Astro.redirect('/404');
}

const todos = await getArticulos();
const articulo = todos.find((a) => a.slug === slug);

if (!articulo) {
	return Astro.redirect('/404');
}

const { title, volanta, excerpt, section, author, ciudad, region, date, image_url, imageCaption, tags, puntosClave, resumenCompartir, correccion } = articulo;
const { Content } = await render(articulo.entry);

// Portada propia de 1200x630 para las vistas previas (WhatsApp, Facebook, X).
// La genera src/pages/api/og/[slug].ts a partir de la foto de la nota.
const ogImage = image_url?.startsWith('/images/') ? image_url : ogImagePath(slug, image_url);

// La foto que se ve dentro de la nota también se sirve desde nuestro dominio
// (ver src/pages/api/img/[slug].ts). Si ya es propia, se usa tal cual.
const fotoVisible = /^https?:\/\//i.test(image_url) ? imagenNotaPath(slug, image_url) : image_url;

const fecha = new Date(date);

// Tiempo estimado de lectura (≈200 palabras por minuto)
const textoPlano = (articulo.entry.body ?? '').replace(/<[^>]*>/g, ' ').trim();
const palabras = textoPlano.split(/\s+/).filter(Boolean).length;
const minutosLectura = Math.max(1, Math.round(palabras / 200));

// Artículos relacionados de la misma sección (máximo 3)
const relacionados = todos.filter((a) => a.section === section && a.slug !== slug).slice(0, 3);

// Datos estructurados para Google (Schema.org NewsArticle)
const siteOrigin = Astro.site ?? Astro.url.origin;
const schema = {
	'@context': 'https://schema.org',
	'@type': 'NewsArticle',
	headline: title,
	description: excerpt ?? '',
	...(image_url ? { image: [new URL(image_url, siteOrigin).toString()] } : {}),
	datePublished: fecha.toISOString(),
	dateModified: fecha.toISOString(),
	author: { '@type': 'Person', name: author || 'Redacción' },
	publisher: {
		'@type': 'Organization',
		name: SITE_TITLE,
		logo: { '@type': 'ImageObject', url: new URL('/favicon.svg', siteOrigin).toString() },
	},
	mainEntityOfPage: { '@type': 'WebPage', '@id': Astro.url.href },
};
import { nombreRegion } from '../../lib/regiones';
---

<BaseLayout
	title={`${title} | ${SITE_TITLE}`}
	description={resumenCompartir || excerpt}
	image={image_url}
	ogImage={ogImage}
	publishedTime={fecha}
	author={author}
	section={nombreSeccion(section || '')}
>
	<!-- Datos estructurados para buscadores -->
	<script type="application/ld+json" set:html={JSON.stringify(schema)} />

	<!-- Barra fija con el titular: aparece al scrollear (estilo El País / Washington Post) -->
	<div id="barra-fija" class="fixed inset-x-0 top-0 z-50 -translate-y-full border-b border-neutral-200 bg-white/95 shadow-sm backdrop-blur transition-transform duration-200">
		<div class="mx-auto flex max-w-[680px] items-center gap-3 px-4 py-2.5">
			<span class="shrink-0 text-[11px] font-bold uppercase tracking-widest text-brand">{nombreSeccion(section || '')}</span>
			<span class="h-4 w-px shrink-0 bg-neutral-300"></span>
			<span class="truncate text-sm font-semibold text-neutral-900">{title}</span>
		</div>
		<div class="h-[3px] w-full bg-neutral-100"><div id="progreso-lectura" class="h-full w-0 bg-brand"></div></div>
	</div>

	<article class="mx-auto max-w-[680px]" data-pagefind-body>
		<header>
			<div class="flex items-center gap-3">
				<a href={`/seccion/${section}/`} class="rounded-full bg-brand px-3 py-1.5 text-xs font-bold text-white" data-pagefind-filter="Sección">{nombreSeccion(section || '')}</a>
				<span class="text-xs text-neutral-500">{minutosLectura} min de lectura</span>
			</div>
			{
				volanta && (
					<p class="mt-3 text-sm font-bold tracking-wide text-neutral-800 uppercase">{volanta}</p>
				)
			}
			<h1 class="mt-3 font-display text-[1.85rem] leading-[1.14] font-extrabold tracking-[-0.015em] text-ink sm:text-[2.6rem]">
				{title}
			</h1>
			<p class="mt-4 text-[17px] leading-relaxed text-neutral-600 sm:text-xl">{excerpt}</p>

			<div class="mt-6 flex items-center gap-3">
				<div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-ink font-display text-sm font-extrabold text-white">
					{(author || 'R').split(' ').map((w: string) => w[0]).join('').toUpperCase().slice(0, 2)}
				</div>
				<div>
					<a href={`/autor/${slugify(author || 'Redacción')}/`} class="text-sm font-semibold text-neutral-900 hover:text-brand">{author || 'Redacción'}</a>{ciudad && <span class="text-sm text-neutral-600"> ({ciudad})</span>}
					<p class="text-xs text-neutral-500">
						<FormattedDate date={fecha} />{region && <> · <a href={`/region/${region}/`} class="hover:text-brand">{nombreRegion(region)}</a></>}
					</p>
				</div>
			</div>
			<div class="mt-4">
				<ShareButtons url={Astro.url.href} title={title} />
			</div>

			<EscucharNota slug={slug} title={title} />

			{
				tags && Array.isArray(tags) && tags.length > 0 && (
					<div class="mt-4 flex flex-wrap gap-2">
						{tags.map((etiqueta: string) => (
							<a
								href={`/tag/${slugify(etiqueta)}/`}
								class="rounded-full bg-white px-3 py-1.5 text-xs font-semibold text-neutral-700 shadow-[inset_0_0_0_1px_#dcdcd6] transition-colors hover:text-brand"
							>
								#{etiqueta}
							</a>
						))}
					</div>
				)
			}
		</header>

		{
			image_url && (
				<figure class="mt-8">
					<img src={fotoVisible} alt={title} class="w-full h-auto rounded-2xl object-cover object-center" loading="eager" />
					{imageCaption && <figcaption class="mt-2 text-sm text-neutral-500">{imageCaption}</figcaption>}
				</figure>
			)
		}

		{
			puntosClave && puntosClave.length > 0 && (
				<section class="tarjeta mt-8 px-5 py-4 shadow-[inset_0_0_0_1px_#e6e6e2]" aria-label="Lo que tenés que saber">
					<p class="font-display text-[15px] font-extrabold text-ink">Lo que tenés que saber</p>
					<ul class="mt-3 flex flex-col gap-2.5">
						{puntosClave.map((punto: string) => (
							<li class="flex gap-2.5 text-[15px] leading-relaxed text-neutral-800">
								<span class="mt-[9px] inline-block h-[7px] w-[7px] shrink-0 rounded-full bg-brand" aria-hidden="true"></span>
								<span>{punto}</span>
							</li>
						))}
					</ul>
				</section>
			)
		}

		<div class="prose-articulo mt-10">
			<Content />
		</div>

		{
			correccion && (
				<aside class="mt-10 border-l-4 border-neutral-400 bg-neutral-50 px-5 py-4" aria-label="Fe de erratas">
					<p class="text-xs font-bold uppercase tracking-widest text-neutral-600">Fe de erratas</p>
					<p class="mt-2 text-[15px] leading-relaxed text-neutral-800">{correccion}</p>
				</aside>
			)
		}
	</article>

	<AdBanner position="in-article" maxAds={1} />

	<Comentarios
		identifier={slug}
		url={new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString()}
		title={title}
	/>

	{
		relacionados.length > 0 && (
			<section class="tarjeta mx-auto mt-12 max-w-6xl p-4 sm:p-6">
				<h2 class="titulo-seccion">Seguí leyendo en {nombreSeccion(section || '')}</h2>
				<div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
					{relacionados.map((relacionado) => (
						<ArticleCard article={relacionado} />
					))}
				</div>
			</section>
		)
	}

	<div class="mx-auto max-w-6xl"><NewsletterBox /></div>
</BaseLayout>

<script is:inline define:vars={{ slugVisita: slug }}>
	// Cuenta una visita por nota y por sesión para "Lo más leído".
	try {
		var k = 'visto:' + slugVisita;
		if (!sessionStorage.getItem(k)) {
			sessionStorage.setItem(k, '1');
			fetch('/api/visita', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ slug: slugVisita }), keepalive: true }).catch(function () {});
		}
	} catch (e) {}
</script>

<script is:inline>
	(function () {
		var barraFija = document.getElementById('barra-fija');
		var progreso = document.getElementById('progreso-lectura');
		var articulo = document.querySelector('[data-pagefind-body]');
		if (!articulo) return;

		function actualizar() {
			var y = window.scrollY || window.pageYOffset;
			if (barraFija) {
				var mostrar = y > 420;
				barraFija.classList.toggle('mostrar', mostrar);
				// Estilo directo: no depende de clases CSS externas
				barraFija.style.transform = mostrar ? 'translateY(0)' : '';
				barraFija.style.translate = mostrar ? '0 0' : '';
			}
			if (!progreso) return;
			var rect = articulo.getBoundingClientRect();
			var alturaTotal = rect.height - window.innerHeight;
			if (alturaTotal <= 0) {
				progreso.style.width = '100%';
				return;
			}
			var recorrido = Math.min(Math.max(-rect.top, 0), alturaTotal);
			progreso.style.width = ((recorrido / alturaTotal) * 100) + '%';
		}

		document.addEventListener('scroll', actualizar, { passive: true });
		window.addEventListener('resize', actualizar);
		actualizar();
	})();
</script>

