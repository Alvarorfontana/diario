---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';

const feedUrl = 'https://alvarofontanal.substack.com/feed';
const sourceUrl = 'https://alvarofontanal.substack.com/';
const fallback = [{ title: 'Balcanización: de la fractura de Yugoslavia a la atomización global', url: 'https://alvarofontanal.substack.com/p/balcanizacion-de-la-fractura-de-yugoslavia', date: '', excerpt: 'Historia y geopolítica: la fragmentación de Yugoslavia y sus consecuencias.', image: '' }];
const decode = (s: string) => s.replace(/<!\[CDATA\[([\s\S]*?)\]\]>/g, '$1').replace(/&amp;/g, '&').replace(/&quot;/g, '"').replace(/&#39;|&apos;/g, "'").replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/<[^>]+>/g, '').trim();
const field = (xml: string, tag: string) => decode(xml.match(new RegExp('<' + tag + '(?:\\s[^>]*)?>([\\s\\S]*?)<\\/' + tag + '>', 'i'))?.[1] || '');
let posts = fallback;
let unavailable = false;
try {
  const response = await fetch(feedUrl, { signal: AbortSignal.timeout(6500), headers: { 'User-Agent': 'DiarioFederal/1.0' } });
  if (!response.ok) throw new Error('Feed unavailable');
  const xml = await response.text();
  const items = [...xml.matchAll(/<item(?:\s[^>]*)?>([\s\S]*?)<\/item>/gi)].map(m => {
    const item = m[1];
    const description = field(item, 'description');
    const image = item.match(/<enclosure\b[^>]*url=["']([^"']+)["'][^>]*>/i)?.[1] || '';
    return { title: field(item, 'title'), url: field(item, 'link'), date: field(item, 'pubDate'), excerpt: description.slice(0, 220), image };
  }).filter(p => p.title && /^https:\/\/alvarofontanal\.substack\.com\//.test(p.url));
  if (!items.length) throw new Error('Empty feed');
  posts = items;
} catch { unavailable = true; }
const classify = (title: string) => /psicoan[aá]lisis|freud|lacan|subjetividad|psicolog/i.test(title) ? 'Pensamiento y sociedad' : /guerra|ir[aá]n|israel|yugoslavia|balcan|ee\.?uu\.?|oriente|geopol|golfo|conflicto|trump/i.test(title) ? 'Guerra y geopolítica' : 'Historia, política y sociedad';
const ordered = [...posts].sort((a,b) => (Date.parse(a.date)||0)-(Date.parse(b.date)||0));
---
<BaseLayout title="Contexto Político | Diario Federal" description="Artículos de análisis, historia y geopolítica de Álvaro Fontana publicados en Substack.">
  <section class="border-t-4 border-red-700 pt-8 pb-10">
    <p class="text-xs font-bold uppercase tracking-[.2em] text-red-700">Diario Federal · Publicaciones de Álvaro Fontana</p>
    <h1 class="mt-3 font-serif text-4xl font-black text-neutral-900 sm:text-6xl">Contexto Político</h1>
    <p class="mt-5 max-w-3xl text-lg leading-relaxed text-neutral-600">Crónicas y análisis para comprender los acontecimientos internacionales, su historia y sus consecuencias. Los textos completos se leen en Substack.</p>
    <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class="mt-5 inline-block text-sm font-bold text-red-700 underline">Visitar Contexto Político en Substack ↗</a>
  </section>
  {unavailable && <p class="mb-6 border-l-4 border-amber-600 bg-amber-50 p-4 text-sm text-neutral-700">La actualización automática no está disponible temporalmente. Podés consultar el archivo completo en Substack.</p>}
  <section class="border-t-2 border-neutral-900 pt-6">
    <h2 class="mb-6 font-serif text-2xl font-bold">Archivo de publicaciones</h2>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {ordered.map(post => <article class="border-t border-neutral-300 pt-4">
        {post.image && <a href={post.url} target="_blank" rel="noopener noreferrer"><img src={post.image} alt="" loading="lazy" class="mb-4 aspect-video w-full object-cover" /></a>}
        <p class="text-[11px] font-bold uppercase tracking-wider text-red-700">{classify(post.title)}</p>
        <h3 class="mt-2 font-serif text-xl font-bold leading-tight"><a href={post.url} target="_blank" rel="noopener noreferrer" class="hover:text-red-700">{post.title} ↗</a></h3>
        {post.date && <time class="mt-2 block text-xs text-neutral-500" datetime={new Date(post.date).toISOString()}>{new Date(post.date).toLocaleDateString('es-AR', { day:'numeric',month:'long',year:'numeric' })}</time>}
        {post.excerpt && <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-neutral-600">{post.excerpt}</p>}
        <a href={post.url} target="_blank" rel="noopener noreferrer" class="mt-3 inline-block text-sm font-semibold text-red-700">Leer en Substack →</a>
      </article>)}
    </div>
  </section>
</BaseLayout>
