---
export const prerender = false;
import { getRuntimeEnv } from '../../lib/runtimeEnv';
import { isAdmin } from '../../lib/auth';

const env = getRuntimeEnv(Astro.locals);
const authenticated = await isAdmin(Astro.request, env);
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Radar internacional · Diario Federal</title>
  <style>
    :root{color-scheme:light;--ink:#18212b;--muted:#64748b;--line:#e2e8f0;--paper:#f5f6f8;--red:#b42318}
    *{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
    .wrap{max-width:1240px;margin:auto;padding:24px}.top{background:#171a1f;color:#fff;padding:22px 26px;border-radius:12px;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}
    .eyebrow{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#cbd5e1}.top h1{font:700 27px Georgia,serif;margin:6px 0}.top p{margin:0;color:#cbd5e1;font-size:13px}
    a{color:inherit}.back{color:#fff;text-decoration:none;border:1px solid #59616d;padding:9px 13px;border-radius:7px;font-size:13px}
    .toolbar{display:flex;gap:10px;flex-wrap:wrap;margin:18px 0}.toolbar input{flex:1;min-width:220px;padding:13px 14px;border:1px solid var(--line);border-radius:8px;font-size:15px}
    button{border:0;border-radius:8px;padding:12px 16px;background:var(--red);color:#fff;font-weight:650;cursor:pointer}button.secondary{background:#fff;color:var(--ink);border:1px solid var(--line)}button:disabled{opacity:.5;cursor:wait}
    .meta{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;color:var(--muted);font-size:12px;margin:12px 2px}
    .sources{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:9px;margin:14px 0 20px}.source{background:#fff;border:1px solid var(--line);border-radius:9px;padding:11px 12px;font-size:12px}.source strong{display:block;font-size:13px;margin-bottom:4px}.ok{color:#16804a}.bad{color:#b42318}
    .list{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr));gap:12px}.story{background:#fff;border:1px solid var(--line);border-radius:10px;padding:16px;display:flex;flex-direction:column;gap:9px;min-height:170px}.story h2{font:700 18px/1.3 Georgia,serif;margin:0}.story p{font-size:13px;line-height:1.5;color:#475569;margin:0}.story a{font-size:12px;color:#a32119;font-weight:700;text-decoration:none;margin-top:auto}.tags{display:flex;gap:7px;flex-wrap:wrap;color:var(--muted);font-size:11px}.tag{background:#f1f5f9;padding:4px 7px;border-radius:4px}
    .notice{background:#fff8e8;border:1px solid #f1d7a3;color:#76521b;padding:13px 15px;border-radius:9px;font-size:12px;line-height:1.5;margin:14px 0}.empty{padding:35px;text-align:center;color:var(--muted);background:#fff;border:1px dashed var(--line);border-radius:10px}
    .login{max-width:460px;margin:12vh auto;background:white;padding:30px;border-radius:12px}.login a{color:#a32119}
    @media(max-width:600px){.wrap{padding:12px}.top{padding:18px}.top h1{font-size:23px}}
  </style>
</head>
<body>
{authenticated ? (
  <main class="wrap">
    <header class="top">
      <div><div class="eyebrow">Diario Federal · Redacción digital</div><h1>Radar internacional</h1><p>Fuentes abiertas, agencias y medios del mundo en un solo lugar.</p></div>
      <a class="back" href="/admin/">← Volver al panel</a>
    </header>
    <div class="notice"><strong>Herramienta de investigación:</strong> este radar reúne titulares y enlaces públicos. No verifica automáticamente la veracidad de una noticia ni concede derechos para reproducir artículos o fotografías. Contrastar antes de publicar.</div>
    <form class="toolbar" id="search-form">
      <input id="query" name="q" value="world" placeholder="Buscar tema, país, persona o acontecimiento…" aria-label="Buscar noticias" />
      <button id="search" type="submit">Buscar noticias</button>
      <button class="secondary" id="refresh" type="button">Actualizar fuentes</button>
    </form>
    <div class="meta"><span id="status">Preparando fuentes…</span><span id="updated"></span></div>
    <section class="sources" id="sources" aria-live="polite"></section>
    <section class="list" id="stories" aria-live="polite"><div class="empty">Consultando fuentes abiertas…</div></section>
  </main>
  <script>
    const form=document.getElementById('search-form');
    const query=document.getElementById('query');
    const statusEl=document.getElementById('status');
    const updated=document.getElementById('updated');
    const sources=document.getElementById('sources');
    const stories=document.getElementById('stories');
    const searchBtn=document.getElementById('search');
    function safe(value){return String(value??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
    function date(value){if(!value)return 'Fecha no informada';const d=new Date(value);return Number.isNaN(d.getTime())?safe(value):d.toLocaleString('es-AR',{dateStyle:'medium',timeStyle:'short'});}
    async function load(){
      searchBtn.disabled=true;statusEl.textContent='Consultando medios y GDELT…';stories.innerHTML='<div class="empty">Buscando información…</div>';
      try{
        const response=await fetch('/api/admin/radar?q='+encodeURIComponent(query.value.trim()||'world'));
        if(response.status===401){throw new Error('La sesión del panel venció. Volvé a ingresar a /admin.');}
        if(!response.ok)throw new Error('No se pudieron consultar las fuentes (HTTP '+response.status+').');
        const data=await response.json();
        sources.innerHTML=data.sources.map(s=>'<div class="source"><strong>'+safe(s.source)+'</strong><span class="'+(s.ok?'ok':'bad')+'">'+(s.ok?'Conectada · '+s.count+' noticias': 'Sin respuesta'+(s.error?' · '+safe(s.error):''))+'</span></div>').join('');
        const items=data.items||[];
        stories.innerHTML=items.length?items.map(item=>'<article class="story"><div class="tags"><span class="tag">'+safe(item.source)+'</span><span class="tag">'+safe(item.region)+'</span><span>'+date(item.publishedAt)+'</span></div><h2>'+safe(item.title)+'</h2>'+(item.summary?'<p>'+safe(item.summary).slice(0,260)+'</p>':'')+'<a href="'+safe(item.url)+'" target="_blank" rel="noopener noreferrer">Abrir publicación original ↗</a></article>').join(''):'<div class="empty">No encontramos resultados. Probá con otro término o revisá el estado de las fuentes.</div>';
        statusEl.textContent=items.length+' publicaciones encontradas · '+data.sources.filter(s=>s.ok).length+' fuentes respondieron';
        updated.textContent='Actualizado: '+new Date(data.generatedAt).toLocaleString('es-AR');
      }catch(error){statusEl.textContent=error.message;stories.innerHTML='<div class="empty">'+safe(error.message)+'</div>';}
      finally{searchBtn.disabled=false;}
    }
    form.addEventListener('submit',e=>{e.preventDefault();load();});
    document.getElementById('refresh').addEventListener('click',load);
    load();
  </script>
) : (
  <main class="login"><h1>Acceso restringido</h1><p>Para consultar el radar internacional necesitás iniciar sesión en el panel editorial.</p><a href="/admin/">Ir al ingreso de administración</a></main>
)}
</body>
</html>
