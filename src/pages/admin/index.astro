	<script>
		async function editArticle(id) {
			const res = await fetch('/api/admin/articles?action=get&slug=' + id);
			const data = await res.json();
			if (data.ok) {
				document.getElementById('form-nuevo').classList.remove('hidden');
				document.getElementById('title').value = data.data.title || '';
				document.getElementById('slug').value = data.data.slug || id;
				document.getElementById('description').value = data.data.description || '';
				document.getElementById('section').value = data.data.section || 'internacional';
				document.getElementById('pubDate').value = data.data.pubDate || new Date().toISOString().split('T')[0];
				document.getElementById('ultimoMomento').checked = data.data.ultimoMomento === 'true' || data.data.ultimoMomento === true;
				document.getElementById('heroImage').value = data.data.heroImage || '';
				document.getElementById('tags').value = Array.isArray(data.data.tags) ? data.data.tags.join(', ') : (data.data.tags || '');
				document.getElementById('content').value = data.body || '';
				window.scrollTo(0, 0);
			}
		}

		async function deleteArticle(id) {
			if (!confirm('¿Eliminar esta noticia?')) return;
			const res = await fetch('/api/admin/articles?action=delete&slug=' + id, { method: 'DELETE' });
			if (res.ok) location.reload();
		}

		document.getElementById('create-form').addEventListener('submit', async (e) => {
			e.preventDefault();
			const formData = new FormData(e.target);
			const data = {
				title: formData.get('title'),
				slug: formData.get('slug'),
				description: formData.get('description'),
				section: formData.get('section'),
				pubDate: formData.get('pubDate'),
				ultimoMomento: formData.get('ultimoMomento') === 'on',
				heroImage: formData.get('heroImage'),
				tags: formData.get('tags'),
				content: formData.get('content'),
			};
			const res = await fetch('/api/admin/articles', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(data),
			});
			if (res.ok) {
				alert('Noticia guardada');
				location.reload();
			} else {
				alert('Error al guardar');
			}
		});
	</script>
</body>
</html>
