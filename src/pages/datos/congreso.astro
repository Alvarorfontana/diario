  <script is:inline>
{
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmt=n=>n==null?'—':Number(n).toLocaleString('es-AR');
const dec=n=>n==null?'—':Number(n).toLocaleString('es-AR',{maximumFractionDigits:1});
const pct=x=>x==null?'—':Math.round(x*100)+'%';
const SIG=new Set(['UCR','PRO','PTS','PJ','FIT','CC','ARI']);
const tc=s=>String(s||'').toLowerCase().split(' ').map((w,i)=>SIG.has(w.toUpperCase())?w.toUpperCase():(i&&['de','del','la','las','los','por','y','e','a','en','el'].includes(w))?w:w.charAt(0).toUpperCase()+w.slice(1)).join(' ');
const fecha=iso=>{if(!iso)return '';const [y,m,d]=iso.split('-');return `${+d}/${+m}/${y}`};
const W_=el=>el.clientWidth;
const draws=new Map;const onSize=(el,fn)=>{draws.set(el,fn);const ro=new ResizeObserver(()=>{if(W_(el)>0)fn()});ro.observe(el)};

const TABS=[['resumen','Resumen'],['historia','Historia'],['diputados','Diputados'],['senado','Senado'],['explorar','Explorador'],['variables','Qué medimos']];
$('#tabs').innerHTML=TABS.map(([k,t])=>`<button type="button" data-t="${k}" aria-selected="${k==='resumen'}">${t}</button>`).join('');

(async()=>{
let D;try{D=JSON.parse(document.getElementById('mc-datos').textContent)}catch(e){return}
$('#fecha').textContent='Datos al '+fecha(D.fecha);
const dip=D.filas.filter(f=>f.c==='D'),sen=D.filas.filter(f=>f.c==='S');
const P=`del ${fecha(D.periodo.desde)} al ${fecha(D.periodo.hasta)}`;
const FUENTE='Fuente: Monitor del Congreso · Diario Federal. Elaborado con datos oficiales de la Cámara de Diputados y del Senado de la Nación.';

/* Navegación */
function area(){}
function tab(k,keep){$$('#tabs button').forEach(b=>b.setAttribute('aria-selected',b.dataset.t===k));
 $$('section.tab').forEach(s=>s.hidden=s.dataset.tab!==k);area('congreso');
 if(!keep)try{history.replaceState(null,'','#'+k)}catch(e){}
 requestAnimationFrame(()=>draws.forEach((fn,el)=>{if(W_(el)>0)fn()}))}
$('#tabs').addEventListener('click',e=>{const b=e.target.closest('button');if(b){tab(b.dataset.t);$('#tabs').scrollIntoView({block:'start'})}});
document.addEventListener('click',e=>{const g=e.target.closest('[data-go]');if(g){tab(g.dataset.go);scrollTo({top:0})}});

/* Resumen */
const tot=dip.reduce((a,f)=>(a.t+=f.t,a.l+=f.l,a),{t:0,l:0});
const sinLey=dip.filter(f=>f.l===0).length;
const H=D.historia,ult=H.anios[H.anios.length-1];
