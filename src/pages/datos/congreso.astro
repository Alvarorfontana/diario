].map(([b,s,g,l])=>`<div class="key"><b>${esc(b)}</b><span>${esc(s)}</span><button type="button" class="link" data-go="${g}">${l} →</button></div>`).join('');
$('#tarjetas').innerHTML=[['historia','Historia','Leyes sancionadas por año y promedio por gobierno desde 1983.'],['diputados','Diputados','El hemiciclo banca por banca, proyectos de ley y qué presenta cada bloque.'],['senado','Senado','El hemiciclo del Senado y la asistencia a las votaciones.'],['explorar','Explorador','Elegí cualquier variable y armá tu gráfico. Ficha completa de cada legislador.'],['variables','Qué medimos','Todas las variables, las disponibles y las que vienen.']].map(([k,t,s])=>`<button type="button" class="card" data-go="${k}"><b>${t}</b><span>${s}</span></button>`).join('');

/* ---------- Historia ---------- */
const gobDe=y=>H.gobiernos.find(g=>g.anios.includes(y));
const ordG=[...H.gobiernos].sort((a,b)=>b.promedio-a.promedio);
$('#hbaj').textContent=`Cada barra es un año. El promedio anual más alto fue con ${ordG[0].gobierno} (${dec(ordG[0].promedio)}, un solo año) y ${ordG[1].gobierno} (${dec(ordG[1].promedio)}); en los diez años completos de Menem fueron ${dec(H.gobiernos.find(g=>g.gobierno==='Menem').promedio)} por año. Con Alberto Fernández bajó a ${dec(H.gobiernos.find(g=>g.gobierno==='A. Fernández').promedio)} y en los dos primeros años de Milei, a ${dec(H.gobiernos.find(g=>g.gobierno==='Milei').promedio)}. Influye mucho cuántos bloques hay y si el oficialismo tiene mayoría propia. La franja rayada marca los años de la pandemia de COVID-19.`;
