---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LabAreas from '../../components/LabAreas.astro';
import { SITE_TITLE } from '../../consts';

// Monitor del Congreso (Laboratorio de datos). Se arma en cada visita, como /datos: los datos se leen de
// data/laboratorio/congreso.json en GitHub, así una actualización de datos no necesita deploy.
export const prerender = false;
const incluido = import.meta.glob('../../../data/laboratorio/congreso.json', { eager: true, import: 'default' }) as Record<string, any>;
const RAW = 'https://raw.githubusercontent.com/Alvarorfontana/diario/main/data/laboratorio/congreso.json';
let datos: any = null;
try {
  const r = await fetch(RAW, { signal: AbortSignal.timeout(4000) });
  if (r.ok) datos = await r.json();
} catch {}
if (!datos) datos = Object.values(incluido)[0] ?? null;
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=3600, stale-while-revalidate=86400');
---

<BaseLayout
  title={`Monitor del Congreso | Laboratorio de datos | ${SITE_TITLE}`}
  description="Qué hacen los diputados y senadores, con datos: leyes por año desde 1983, el recinto banca por banca, asistencia y la ficha de cada legislador."
  section="Datos"
>
  <div class="mx-auto max-w-6xl">
    <header class="border-b border-neutral-200 pb-5">
      <p class="text-xs font-extrabold tracking-[0.16em] text-brand uppercase"><a href="/datos/" class="hover:underline">Laboratorio de datos</a> · Congreso</p>
      <p class="mt-1 font-sans text-xs text-neutral-500" id="fecha"></p>
      <LabAreas activa="congreso" />
    </header>
    <div class="mc" id="congreso">


<nav class="tabs" aria-label="Secciones del Monitor del Congreso" id="tabs"></nav>

<!-- RESUMEN -->
<section class="tab" data-tab="resumen">
  <div class="kick">Monitor del Congreso</div>
  <h1>Qué hacen los diputados y senadores, con datos</h1>
  <p class="lead">Proyectos que presentan, leyes que se aprueban, asistencia a las votaciones y recursos de cada despacho. Los mismos datos y las mismas reglas para todos los bloques.</p>
  <div class="keys" id="claves"></div>
  <div class="note">
    <h2>Contar no es evaluar</h2>
    <ul>
      <li>Un número alto no es un buen legislador ni uno bajo es uno malo. Una declaración de beneplácito y una reforma del Código Penal cuentan como un proyecto cada una.</li>
      <li>Quien acompaña con su voto los proyectos de su bloque o del Gobierno trabaja aunque no figure como autor.</li>
      <li>Hay trabajo que no se ve en estos datos: comisiones, negociaciones, atención a su provincia, control al Ejecutivo.</li>
      <li>No hay puntaje final ni lista de mejores y peores.</li>
    </ul>
  </div>
  <div class="band"><h2>Qué vas a encontrar</h2><div class="cards" id="tarjetas"></div></div>
</section>

<!-- HISTORIA -->
<section class="tab" data-tab="historia" hidden>
  <figure class="cf">
    <div class="kick">Historia</div>
    <h2>Cuántas leyes sancionó el Congreso cada año desde 1983</h2>
    <p class="bj" id="hbaj"></p>
    <div class="aviso" id="hctx"></div>
    <div class="controls"><div class="seg" role="group" aria-label="Ver por"><button type="button" data-hv="anio" aria-pressed="true">Por año</button><button type="button" data-hv="gob" aria-pressed="false">Por gobierno</button></div></div>
    <p class="kick hint" id="hhint" hidden>Deslizá el gráfico para ver toda la serie.</p><div class="fig hs" id="hfig"></div>
    <div class="det" id="hdet" role="status"></div>
    <p class="src" id="hsrc"></p>
  </figure>
</section>

<!-- DIPUTADOS -->
<section class="tab" data-tab="diputados" hidden>
  <figure class="cf">
    <div class="kick">Cámara de Diputados · 257 bancas</div>
    <h2>La Cámara, banca por banca</h2>
    <p class="bj" id="dbaj"></p>
    <div class="controls"><span class="ctl">Pintar las bancas según<div class="seg" role="group" id="dmodo"><button type="button" data-m="bloque" aria-pressed="true">Bloque</button><button type="button" data-m="ley" aria-pressed="false">Proyectos de ley</button></div></span></div>
    <div class="legend" id="dley"></div>
    <div class="fig" id="dhemi"></div>
    <div class="det" id="ddet" role="status">Tocá una banca para ver quién la ocupa.</div>
    <p class="src" id="dsrc1"></p>
  </figure>

  <figure class="cf band">
    <h2>¿Cuántos proyectos de ley presentó cada diputado?</h2>
    <p class="bj">Diputados agrupados según la cantidad de proyectos de ley que firmaron como autores principales. Tocá una columna para ver los nombres.</p>
    <div class="controls"><label class="ctl">Diputados<select id="dcoh"><option value="">Todos (257)</option><option value="2023-2027">Desde diciembre de 2023</option><option value="2025-2029">Desde diciembre de 2025</option></select></label></div>
    <div class="fig" id="dcol"></div>
    <div class="det" id="dcdet" role="status">Tocá una columna.</div>
    <p class="src" id="dsrc2"></p>
  </figure>

  <figure class="cf band">
    <h2>Qué tipo de proyectos presenta cada bloque</h2>
    <p class="bj">De cada 100 proyectos que firman como autores principales, cuántos son de ley, de resolución (pedidos de informes, pronunciamientos) o de declaración (beneplácitos, homenajes, repudios). Bloques con 3 diputados o más.</p>
    <div class="legend"><span><i class="sq" style="background:var(--ley)"></i>Ley</span><span><i class="sq" style="background:var(--res)"></i>Resolución</span><span><i class="sq" style="background:var(--dec)"></i>Declaración</span></div>
    <div class="rows" id="dblo"></div>
    <div class="det" id="dbdet" role="status">Tocá un bloque para ver los números.</div>
  </figure>
</section>

<!-- SENADO -->
<section class="tab" data-tab="senado" hidden>
  <figure class="cf">
    <div class="kick">Senado de la Nación · 72 bancas</div>
    <h2>El Senado, banca por banca</h2>
    <p class="bj" id="sbaj"></p>
    <div class="controls"><span class="ctl">Pintar las bancas según<div class="seg" role="group" id="smodo"><button type="button" data-m="bloque" aria-pressed="true">Bloque</button><button type="button" data-m="asis" aria-pressed="false">Asistencia</button></div></span></div>
    <div class="legend" id="sley"></div>
    <div class="fig" id="shemi"></div>
    <div class="det" id="sdet" role="status">Tocá una banca para ver quién la ocupa.</div>
  </figure>
  <figure class="cf band">
    <h2>Asistencia a las votaciones, senador por senador</h2>
    <p class="bj" id="sabaj"></p>
    <div class="fig" id="sdot"></div>
    <div class="det" id="sadet" role="status">Tocá un punto.</div>
    <p class="src" id="ssrc"></p>
  </figure>
</section>

<!-- EXPLORADOR -->
<section class="tab" data-tab="explorar" hidden>
  <div class="kick">Explorador</div>
  <h2>Armá tu propio gráfico</h2>
  <p>Elegí una variable y cómo verla. Tocá un legislador para abrir su ficha completa o un bloque para ver a sus integrantes.</p>
  <div class="controls">
    <label class="ctl">Variable<select id="xv"></select></label>
    <label class="ctl">Ver por<select id="xg"><option value="leg">Legislador</option><option value="b">Bloque</option><option value="p">Provincia</option><option value="c">Cámara</option></select></label>
    <label class="ctl">Tipo de gráfico<select id="xt"><option value="rank">Ranking</option><option value="dist">Distribución</option><option value="cruce">Cruzar dos variables</option></select></label>
    <label class="ctl" id="xv2w" hidden>Cruzar con<select id="xv2"></select></label>
  </div>
  <div class="controls">
    <select id="fc" aria-label="Cámara"><option value="">Las dos cámaras</option><option value="D">Diputados</option><option value="S">Senado</option></select>
    <select id="fb" aria-label="Bloque"><option value="">Todos los bloques</option></select>
    <select id="fp" aria-label="Provincia"><option value="">Todas las provincias</option></select>
    <input id="q" type="search" placeholder="Buscar por nombre" aria-label="Buscar por nombre">
  </div>
  <figure class="cf" style="border-top:2px solid var(--ink);padding-top:14px">
    <h3 id="xtit"></h3>
    <p class="bj" id="xsub" style="font-size:15px"></p>
    <div id="xout"></div>
    <div class="det" id="xdet" role="status" hidden></div>
    <div class="controls"><button class="btn" id="xmas" type="button" hidden>Ver todos</button><button class="btn" id="xcsv" type="button">Copiar datos (CSV)</button><span class="kick" id="xmsg" role="status"></span></div>
  </figure>

  <div class="band" id="ficha" hidden>
    <div class="fhead"><div><div class="kick" id="fsub"></div><h2 id="fnom"></h2><p class="kick" id="fmeta"></p></div><button class="btn" id="fcer" type="button">Cerrar ficha</button></div>
    <div id="fvars" class="fgrid"></div>
    <div class="fcols"><div><h4>Últimos proyectos como autor principal</h4><ul id="frec" class="plain"></ul></div><div><h4>Comisiones</h4><ul id="fcom" class="plain"></ul></div></div>
  </div>
</section>

<!-- VARIABLES -->
<section class="tab" data-tab="variables" hidden>
  <div class="kick">Qué medimos</div>
  <h2>Las variables del monitor</h2>
  <p id="vlead"></p>
  <div class="vars" id="vars"></div>
</section>



    </div>
    <p class="mt-6 border-t border-neutral-200 pt-4 font-sans text-xs text-neutral-500" id="pie"></p>
  </div>
  <script type="application/json" id="mc-datos" set:html={JSON.stringify(datos)}></script>
