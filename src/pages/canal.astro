---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
import { VIDEOS, CLIPS, VIVO_ID, SENALES, REGIONES, listaUltimos } from '../lib/canal';

const principalId = VIVO_ID || VIDEOS[0]?.id || '';
const principal = VIVO_ID ? { id: VIVO_ID, titulo: 'Transmisión en vivo', volanta: 'En vivo' } : VIDEOS[0];
const siguientes = VIVO_ID ? VIDEOS.slice(0, 6) : VIDEOS.slice(1, 7);
const hayVideos = Boolean(principalId);
const muestra = [1, 2, 3];
const regiones = REGIONES.filter((r) => SENALES.some((s) => s.region === r));
const primera = SENALES[0];
const regionInicial = primera?.region;
---

<BaseLayout title={`Canal | ${SITE_TITLE}`} description="Videos, análisis y clips de EL DIARIO.">
	<div class="-mx-4 bg-[#111111] px-4 pt-6 pb-10 text-[#f2f2f0] sm:rounded-[4px]">
		<div class="flex flex-wrap items-baseline justify-between gap-2">
			<h1 class="font-display text-3xl font-bold text-white">{SITE_TITLE} <span class="font-normal italic">Canal</span></h1>
			{VIVO_ID && (
				<span class="inline-flex items-center gap-2 text-[11px] font-bold tracking-[0.08em] text-[#ff5a6e]">
					<span class="titila inline-block h-2 w-2 rounded-full bg-[#ff5a6e]" aria-hidden="true"></span>EN VIVO AHORA
				</span>
			)}
		</div>

		{(hayVideos || CLIPS.length > 0) && (
			<Fragment>
		<div class="mt-5 grid gap-7 lg:grid-cols-3">
			<div class="min-w-0 lg:col-span-2">
				<div class="relative aspect-video w-full overflow-hidden bg-[#2a2a2a]">
					{hayVideos ? (
						<iframe
							src={`https://www.youtube-nocookie.com/embed/${principalId}`}
							title={principal?.titulo ?? 'Video'}
							class="absolute inset-0 h-full w-full border-0"
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
							allowfullscreen
						></iframe>
					) : (
						<div class="absolute inset-0 flex flex-col items-center justify-center gap-3 text-center text-sm text-[#b8b8b4]">
							<span class="flex h-16 w-16 items-center justify-center rounded-full bg-white" aria-hidden="true">
								<svg width="24" height="24" viewBox="0 0 24 24" fill="#111111"><path d="M7 4l13 8-13 8z"></path></svg>
							</span>
							Acá va el video principal
						</div>
					)}
				</div>
				<p class="mt-4 text-[11px] font-bold tracking-[0.1em] text-[#b8b8b4] uppercase">{principal?.volanta ?? 'Análisis en video'}</p>
				<h2 class="mt-1 font-display text-2xl leading-tight font-bold text-white sm:text-[1.7rem]">{principal?.titulo ?? 'Título del video principal'}</h2>
				{principal && 'nota' in principal && principal.nota && (
					<a href={`/articulo/${principal.nota}/`} class="mt-3 inline-flex min-h-11 items-center border border-[#6a6a66] px-4 text-sm font-semibold text-white hover:bg-white hover:text-ink">Leer la nota</a>
				)}
			</div>

			<aside class="min-w-0">
				<h2 class="border-b-2 border-white pb-2 text-xs font-extrabold tracking-[0.14em] text-white uppercase">Siguientes</h2>
				{siguientes.length > 0 ? siguientes.map((v) => (
					<a href={`https://www.youtube.com/watch?v=${v.id}`} target="_blank" rel="noopener" class="flex gap-3 border-b border-[#333333] py-3 text-[#f2f2f0] last:border-0">
						<img src={`https://i.ytimg.com/vi/${v.id}/mqdefault.jpg`} alt={`Video: ${v.titulo}`} class="aspect-video w-28 shrink-0 object-cover" loading="lazy" />
						<span>
							<span class="block font-display text-base leading-snug font-bold text-white">{v.titulo}</span>
							{v.duracion && <span class="mt-1 block text-xs text-[#b8b8b4]">{v.duracion}</span>}
						</span>
					</a>
				)) : muestra.map(() => (
					<div class="flex gap-3 border-b border-[#333333] py-3 last:border-0">
						<span class="aspect-video w-28 shrink-0 bg-[#2a2a2a]"></span>
						<span class="text-sm text-[#b8b8b4]">Próximo video</span>
					</div>
				))}
			</aside>
		</div>

		<h2 class="mt-10 text-xs font-extrabold tracking-[0.14em] text-white uppercase">Clips cortos</h2>
		<div class="no-scrollbar mt-3 flex gap-3 overflow-x-auto pb-1">
			{CLIPS.length > 0 ? CLIPS.map((c) => (
				<a href={`https://www.youtube.com/shorts/${c.id}`} target="_blank" rel="noopener" class="w-36 shrink-0 text-[#f2f2f0]">
					<img src={`https://i.ytimg.com/vi/${c.id}/hqdefault.jpg`} alt={`Clip: ${c.titulo}`} class="aspect-[9/16] w-full object-cover" loading="lazy" />
					<span class="mt-1.5 block text-sm leading-snug">{c.titulo}</span>
				</a>
			)) : [1, 2, 3, 4].map(() => (
				<div class="w-36 shrink-0">
					<div class="aspect-[9/16] w-full bg-[#2a2a2a]"></div>
					<span class="mt-1.5 block text-sm text-[#b8b8b4]">Clip vertical</span>
				</div>
			))}
		</div>
			</Fragment>
		)}

		{SENALES.length > 0 && (
			<section class={hayVideos || CLIPS.length > 0 ? 'mt-12' : 'mt-5'} aria-labelledby="senales-titulo">
				<div class="flex flex-wrap items-end justify-between gap-3 border-b-2 border-white pb-2">
					<h2 id="senales-titulo" class="text-xs font-extrabold tracking-[0.14em] text-white uppercase">Señales de noticias</h2>
					<p class="text-xs text-[#b8b8b4]">{SENALES.length} canales · elegí la región y la señal</p>
				</div>

				<div class="no-scrollbar mt-3 flex gap-5 overflow-x-auto border-b border-[#333333]" role="tablist" aria-label="Regiones">
					{regiones.map((r) => (
						<button
							type="button"
							role="tab"
							class="region-tab -mb-px min-h-11 shrink-0 border-b-2 border-transparent text-[12px] font-bold tracking-[0.08em] whitespace-nowrap text-[#b8b8b4] uppercase transition-colors hover:text-white aria-selected:border-[#e0243a] aria-selected:text-white"
							aria-selected={r === regionInicial ? 'true' : 'false'}
							data-region={r}
						>{r}</button>
					))}
				</div>

				<div class="no-scrollbar mt-4 flex gap-2 overflow-x-auto pb-1" role="tablist" aria-label="Canales de noticias">
					{SENALES.map((s, i) => (
						<button
							type="button"
							role="tab"
							class:list={['senal-tab min-h-11 shrink-0 items-center gap-2 rounded-[2px] border border-[#6a6a66] px-4 text-sm font-semibold whitespace-nowrap text-white transition-colors hover:border-white aria-selected:border-white aria-selected:bg-white aria-selected:text-[#111111]', s.region === regionInicial ? 'inline-flex' : 'hidden']}
							aria-selected={i === 0 ? 'true' : 'false'}
							data-region={s.region}
							data-canal={s.canal ?? ''}
							data-nombre={s.nombre}
							data-desc={s.descripcion}
							data-origen={s.origen}
							data-usuario={s.usuario}
						>
							<span class="punto-vivo hidden h-2 w-2 rounded-full bg-[#e0243a]" aria-hidden="true"></span>
							{s.nombre}
							<span class="sr-only estado-sr"></span>
						</button>
					))}
				</div>

				<div class="mt-4 grid gap-6 lg:grid-cols-3">
					<div class="relative aspect-video w-full overflow-hidden bg-[#2a2a2a] lg:col-span-2">
						<iframe
							id="senal-player"
							src={primera.canal ? `https://www.youtube-nocookie.com/embed/videoseries?list=${listaUltimos(primera.canal)}` : 'about:blank'}
							title={primera.nombre}
							class="absolute inset-0 h-full w-full border-0"
							loading="lazy"
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
							allowfullscreen
						></iframe>
						<div id="senal-cargando" class="absolute inset-0 hidden items-center justify-center bg-[#1a1a1a] text-sm text-[#b8b8b4]">
							<span class="titila mr-2 inline-block h-2 w-2 rounded-full bg-[#b8b8b4]" aria-hidden="true"></span>Buscando la señal…
						</div>
						<div id="senal-afuera" class="absolute inset-0 hidden flex-col items-center justify-center gap-4 bg-[#1a1a1a] px-6 text-center">
							<p class="font-display text-xl font-bold text-white">Esta señal se ve en YouTube</p>
							<p class="max-w-sm text-sm text-[#b8b8b4]">El canal no deja ver su transmisión desde otras páginas en este momento.</p>
							<a id="senal-afuera-link" href="#" target="_blank" rel="noopener" class="inline-flex min-h-11 items-center gap-2 rounded-[2px] bg-white px-4 text-sm font-semibold text-[#111111] hover:bg-[#e6e6e2]">Abrir en YouTube</a>
						</div>
					</div>
					<div class="min-w-0">
						<p class="text-[11px] font-bold tracking-[0.1em] text-[#b8b8b4] uppercase">Ahora en pantalla</p>
						<p id="senal-nombre" class="mt-1 font-display text-2xl font-bold text-white">{primera.nombre}</p>
						<p id="senal-origen" class="mt-2 inline-block rounded-[2px] border border-[#4a4a47] px-2 py-0.5 text-[11px] font-semibold tracking-[0.06em] text-[#d6d6d2] uppercase">{primera.origen}</p>
						<p id="senal-desc" class="mt-2 text-sm text-[#b8b8b4]">{primera.descripcion}</p>
						<p id="senal-estado" class="mt-3 flex items-center gap-2 text-xs font-bold tracking-[0.08em] text-[#b8b8b4] uppercase">Últimos videos del canal</p>
						<a id="senal-vivo" href={`https://www.youtube.com/@${primera.usuario}/live`} target="_blank" rel="noopener" class="mt-4 inline-flex min-h-11 items-center gap-2 rounded-[2px] bg-white px-4 text-sm font-semibold text-[#111111] hover:bg-[#e6e6e2]">
							<span class="inline-block h-2 w-2 rounded-full bg-[#e0243a]" aria-hidden="true"></span>Ver en vivo en YouTube
						</a>
						<p class="mt-4 text-xs leading-relaxed text-[#8f8f8b]">Contenido de cada medio, con su reproductor oficial. {SITE_TITLE} no produce estos videos. El punto rojo indica que el canal está transmitiendo en vivo; si no, se ven sus últimos videos.</p>
					</div>
				</div>
			</section>
		)}
	</div>
</BaseLayout>

<script>
	type Estado = { vivo: string | null; canal: string | null };
	const NOCOOKIE = 'https://www.youtube-nocookie.com/embed/';
	const regionTabs = document.querySelectorAll<HTMLButtonElement>('.region-tab');
	const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.senal-tab'));
	const player = document.getElementById('senal-player') as HTMLIFrameElement | null;
	const nombre = document.getElementById('senal-nombre');
	const origen = document.getElementById('senal-origen');
	const desc = document.getElementById('senal-desc');
	const estadoTxt = document.getElementById('senal-estado');
	const vivo = document.getElementById('senal-vivo') as HTMLAnchorElement | null;
	const cargando = document.getElementById('senal-cargando');
	const afuera = document.getElementById('senal-afuera');
	const afueraLink = document.getElementById('senal-afuera-link') as HTMLAnchorElement | null;

	const cache = new Map<string, Promise<Estado>>();
	function estado(usuario: string): Promise<Estado> {
		let p = cache.get(usuario);
		if (!p) {
			p = fetch(`/api/senal-vivo?u=${encodeURIComponent(usuario)}`)
				.then((r) => (r.ok ? r.json() : { vivo: null, canal: null }))
				.catch(() => ({ vivo: null, canal: null }));
			cache.set(usuario, p);
		}
		return p;
	}

	function marcarPunto(tab: HTMLButtonElement, e: Estado) {
		tab.querySelector('.punto-vivo')?.classList.toggle('hidden', !e.vivo);
		tab.querySelector('.punto-vivo')?.classList.toggle('inline-block', Boolean(e.vivo));
		const sr = tab.querySelector('.estado-sr');
		if (sr) sr.textContent = e.vivo ? ' (en vivo)' : '';
	}

	function capa(cual: 'cargando' | 'afuera' | null) {
		cargando?.classList.toggle('hidden', cual !== 'cargando');
		cargando?.classList.toggle('flex', cual === 'cargando');
		afuera?.classList.toggle('hidden', cual !== 'afuera');
		afuera?.classList.toggle('flex', cual === 'afuera');
	}

	function ponerEstado(enVivo: boolean) {
		if (!estadoTxt) return;
		estadoTxt.innerHTML = enVivo
			? '<span class="titila inline-block h-2 w-2 rounded-full bg-[#ff5a6e]" aria-hidden="true"></span><span class="text-[#ff5a6e]">En vivo ahora</span>'
			: 'Últimos videos del canal';
	}

	let turno = 0;
	async function seleccionar(tab: HTMLButtonElement, reproducir: boolean) {
		const mio = ++turno;
		tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
		const { nombre: n = '', desc: d = '', origen: o = '', usuario = '', canal = '' } = tab.dataset;
		if (nombre) nombre.textContent = n;
		if (desc) desc.textContent = d;
		if (origen) origen.textContent = o;
		const enYoutube = `https://www.youtube.com/@${usuario}/live`;
		if (vivo) vivo.href = enYoutube;
		if (afueraLink) afueraLink.href = enYoutube;
		if (player) player.title = n;
		ponerEstado(false);
		if (player && canal) { player.src = `${NOCOOKIE}videoseries?list=UU${canal.slice(2)}`; capa(null); }
		else capa('cargando');

		const e = await estado(usuario);
		if (mio !== turno || !player) return;
		marcarPunto(tab, e);
		if (e.vivo) {
			player.src = `${NOCOOKIE}${e.vivo}${reproducir ? '?autoplay=1' : ''}`;
			ponerEstado(true);
			capa(null);
		} else if (!canal && e.canal) {
			tab.dataset.canal = e.canal;
			player.src = `${NOCOOKIE}videoseries?list=UU${e.canal.slice(2)}`;
			capa(null);
		} else if (!canal) {
			player.src = 'about:blank';
			capa('afuera');
		}
	}

	// Corre la fila para que se vea la solapa elegida (en el celular no entran todas), sin mover la página.
	function centrar(el: HTMLElement | undefined) {
		const fila = el?.parentElement;
		if (!el || !fila) return;
		fila.scrollLeft = Math.max(0, el.offsetLeft - fila.offsetLeft - 16);
	}

	function mostrarRegion(region: string) {
		regionTabs.forEach((r) => r.setAttribute('aria-selected', String(r.dataset.region === region)));
		centrar(Array.from(regionTabs).find((r) => r.dataset.region === region));
		tabs.forEach((t) => {
			const ver = t.dataset.region === region;
			t.classList.toggle('hidden', !ver);
			t.classList.toggle('inline-flex', ver);
			// Averigua quién está en vivo en esta región para prender los puntos rojos.
			if (ver && t.dataset.usuario) estado(t.dataset.usuario).then((e) => marcarPunto(t, e));
		});
	}

	regionTabs.forEach((r) => r.addEventListener('click', () => {
		const region = r.dataset.region ?? '';
		mostrarRegion(region);
		const primera = tabs.find((t) => t.dataset.region === region);
		if (primera) seleccionar(primera, true);
	}));
	tabs.forEach((tab) => tab.addEventListener('click', () => seleccionar(tab, true)));

	const inicial = tabs[0];
	if (inicial) {
		mostrarRegion(inicial.dataset.region ?? '');
		seleccionar(inicial, false);
	}
</script>
