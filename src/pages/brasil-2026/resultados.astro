---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';
---

<BaseLayout title={`Resultados en vivo · Brasil 2026 | ${SITE_TITLE}`} description="Resultados del escrutinio en Brasil 2026, en vivo.">
	<div class="mx-auto max-w-3xl" id="app">
		<p class="um-banner mt-4"><span class="um-luz"></span>Resultados en vivo · Brasil 2026</p>
		<h1 class="mt-4 font-serif text-4xl leading-[1.08] font-black tracking-tight sm:text-5xl">
			Elecciones en Brasil: seguí el escrutinio en vivo
		</h1>
		<p class="mt-3 text-sm text-neutral-500">
			Actualizado: <span id="updated">—</span> · Fuente: Tribunal Superior Electoral (TSE)
		</p>

		<!-- Tarjetas principales -->
		<div class="mt-6 grid grid-cols-2 gap-4 border-y-2 border-neutral-900 py-5">
			<div class="text-center">
				<span class="block font-serif text-3xl font-black" id="urnas">—</span>
				<span class="text-[11px] tracking-wide text-neutral-500 uppercase">urnas escrutadas</span>
			</div>
			<div class="text-center">
				<span class="block font-serif text-3xl font-black" id="participacion">—</span>
				<span class="text-[11px] tracking-wide text-neutral-500 uppercase">participación</span>
			</div>
		</div>

		<!-- Barras de candidatos -->
		<div id="candidatos" class="mt-6 space-y-5"></div>

		<!-- Minuto a minuto -->
		<div class="mt-10 flex items-center justify-between">
			<h2 class="font-serif text-2xl font-extrabold">Minuto a minuto</h2>
			<span class="inline-flex items-center gap-2 rounded-full bg-brand px-3 py-1.5 text-[11px] font-bold text-white">
				<span class="luz-parpadeante inline-block h-1.5 w-1.5 rounded-full bg-white"></span>
				Auto-actualización
			</span>
		</div>
		<div id="timeline" class="mt-4 ml-1.5 border-l-[3px] border-neutral-900"></div>

		<div class="mt-8 border border-neutral-300 bg-neutral-50 p-5 text-sm text-neutral-600">
			<strong>Nota metodológica:</strong> los datos provienen del escrutinio provisorio del TSE. Los resultados definitivos se publican tras la jornada de totalización.
		</div>
	</div>
</BaseLayout>

<script>
	async function cargar() {
		try {
			const r = await fetch('/api/brasil2026', { cache: 'no-store' });
			const d = await r.json();

			document.getElementById('updated').textContent = new Date(d.updatedAt).toLocaleString('es-AR', { dateStyle: 'short', timeStyle: 'short' });
			document.getElementById('urnas').textContent = d.urnas;
			document.getElementById('participacion').textContent = d.participacion;

			const cont = document.getElementById('candidatos');
			cont.innerHTML = d.candidatos.map((c) => `
				<div>
					<div class="flex items-baseline justify-between">
						<p class="font-serif text-lg font-extrabold">${c.nombre} <span class="text-sm font-semibold text-neutral-500">${c.partido}</span></p>
						<p class="font-serif text-xl font-black">${c.pct}%</p>
					</div>
					<div class="mt-1.5 h-3.5 w-full bg-neutral-200">
						<div class="h-3.5" style="width:${c.pct}%; background:${c.color}"></div>
					</div>
					<p class="mt-1 text-xs text-neutral-500">${c.votos} votos</p>
				</div>
			`).join('');

			document.getElementById('timeline').innerHTML = d.posts.map((p) => `
				<div class="relative border-b border-neutral-200 py-5 pl-6">
					<span class="absolute top-6 -left-[7px] h-[11px] w-[11px] rounded-full border-[3px] ${p.clave ? 'border-brand bg-brand' : 'border-neutral-900'} bg-[#f6efdf]"></span>
					<p class="font-serif text-lg font-black">${p.hora}</p>
					${p.clave ? '<span class="mt-1 inline-block rounded-full border border-brand px-3 py-0.5 text-[10px] font-extrabold tracking-wider uppercase text-brand">Evento clave</span>' : ''}
					<p class="mt-2 text-[15px] leading-relaxed text-neutral-800">${p.texto}</p>
					<p class="mt-2 text-xs font-semibold text-neutral-500">${p.autor} <span class="font-normal text-neutral-400">· ${p.lugar}</span></p>
				</div>
			`).join('');
		} catch (e) {
			console.error('Error cargando resultados', e);
		}
	}
	cargar();
	setInterval(cargar, 60000);
</script>
