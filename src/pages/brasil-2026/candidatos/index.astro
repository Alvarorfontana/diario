---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../../consts';

const candidatos = [
	{ nombre: 'Luiz Inácio Lula da Silva', urna: 'Lula', partido: 'PT', vice: 'Geraldo Alckmin', vicePartido: 'PSB' },
	{ nombre: 'Flávio Bolsonaro', urna: 'Flávio Bolsonaro', partido: 'PL', vice: 'Alfredo Gaspar', vicePartido: 'PL' },
	{ nombre: 'Ronaldo Caiado', urna: 'Ronaldo Caiado', partido: 'PSD', vice: 'Gilberto Kassab', vicePartido: 'PSD' },
	{ nombre: 'Rui Costa Pimenta', urna: 'Rui Costa Pimenta', partido: 'PCO', vice: 'Antônio Carlos', vicePartido: 'PCO' },
	{ nombre: 'Samara Martins', urna: 'Samara', partido: 'UP', vice: 'Raquel Brício', vicePartido: 'UP' },
	{ nombre: 'Romeu Zema', urna: 'Zema', partido: 'NOVO', vice: 'Eduardo Girão', vicePartido: 'NOVO' },
	{ nombre: 'Hertz Dias', urna: 'Hertz Dias', partido: 'PSTU', vice: 'Vanessa Portugal', vicePartido: 'PSTU' },
	{ nombre: 'Edmilson Costa', urna: 'Edmilson Costa', partido: 'PCB', vice: 'Cleusa Santos', vicePartido: 'PCB' },
	{ nombre: 'Renan Santos', urna: 'Renan Santos', partido: 'MISSÃO', vice: 'Aroldo Medina', vicePartido: 'MISSÃO' },
	{ nombre: 'Wilson Grassi', urna: 'Veterinário Wilson Grassi', partido: 'DEMOCRATA', vice: 'Suêd Haidar', vicePartido: 'DEMOCRATA' },
	{ nombre: 'Clariana Barão', urna: 'Clariana Barão', partido: 'DC', vice: 'Fabiana Torquato', vicePartido: 'DC' },
	{ nombre: 'Augusto Cury', urna: 'Escritor Augusto Cury', partido: 'AVANTE', vice: 'Júlio Delgado', vicePartido: 'AVANTE' },
];

const tseCandidaturas =
	'https://www.tse.jus.br/comunicacao/noticias/2026/Setembro/eleicoes-2026-tem-12-candidaturas-na-disputa-pela-presidencia-da-republica';

const tsePropostas =
	'https://www.tse.jus.br/eleicoes/eleicoes-2026-content/propostas-de-governo-dos-candidatos-ao-cargo-de-presidente-da-republica-eleicoes-2026/planos-de-governo-dos-candidatos-ao-cargo-de-presidente-da-republica-eleicoes-2026';
---

<BaseLayout
	title={`Candidatos a presidente · Brasil 2026 | ${SITE_TITLE}`}
	description="Lista de candidaturas registradas para la Presidencia de Brasil en las elecciones de 2026, basada en información oficial del Tribunal Superior Eleitoral."
>
	<div class="mx-auto max-w-5xl">
		<nav class="mt-4 text-xs font-semibold text-neutral-500" aria-label="Migas de pan">
			<a href="/brasil-2026/" class="hover:text-brand">Brasil 2026</a>
			<span class="mx-2">/</span>
			<span class="text-neutral-900">Candidatos</span>
		</nav>

		<div class="mt-5 border-b-2 border-neutral-900 pb-7">
			<p class="text-[11px] font-extrabold tracking-[0.2em] text-brand uppercase">Elecciones Brasil 2026</p>
			<h1 class="mt-3 max-w-4xl font-serif text-4xl leading-[1.06] font-black tracking-tight sm:text-5xl">
				Los candidatos a la Presidencia de Brasil
			</h1>
			<p class="mt-4 max-w-3xl text-lg leading-relaxed text-neutral-600">
				Las candidaturas presidenciales registradas para las elecciones de 2026. Esta página no muestra encuestas,
				porcentajes ni posiciones: presenta la nómina electoral y la fórmula de cada candidatura.
			</p>
		</div>

		<div class="mt-6 flex flex-col gap-3 border border-neutral-300 bg-neutral-50 p-5 sm:flex-row sm:items-center sm:justify-between">
			<div>
				<p class="text-xs font-extrabold tracking-[0.14em] text-neutral-900 uppercase">Fuente institucional</p>
				<p class="mt-1 text-sm leading-relaxed text-neutral-600">
					Tribunal Superior Eleitoral (TSE) · candidaturas presidenciales 2026.
				</p>
			</div>
			<div class="flex flex-wrap gap-2">
				<a href={tseCandidaturas} target="_blank" rel="noopener noreferrer"
					class="border border-neutral-900 px-3 py-2 text-xs font-bold transition hover:bg-neutral-900 hover:text-white">
					Ver candidaturas en TSE ↗
				</a>
				<a href={tsePropostas} target="_blank" rel="noopener noreferrer"
					class="border border-neutral-300 bg-white px-3 py-2 text-xs font-bold transition hover:border-brand hover:text-brand">
					Ver propuestas oficiales ↗
				</a>
			</div>
		</div>

		<section class="mt-8" aria-labelledby="lista-candidatos">
			<div class="flex items-end justify-between gap-4 border-b border-neutral-300 pb-3">
				<div>
					<p class="text-[11px] font-bold tracking-[0.16em] text-brand uppercase">Primera vuelta</p>
					<h2 id="lista-candidatos" class="mt-1 font-serif text-2xl font-extrabold">Candidaturas presidenciales</h2>
				</div>
				<p class="text-sm font-semibold text-neutral-500">{candidatos.length} candidaturas</p>
			</div>

			<div class="mt-5 grid gap-4 md:grid-cols-2">
				{candidatos.map((candidato) => (
					<article class="group border border-neutral-300 bg-white p-5 transition hover:border-neutral-900">
						<div class="flex items-start gap-4">
							<div
								class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-neutral-900 font-serif text-xl font-black text-white"
								aria-hidden="true"
							>
								{candidato.urna.charAt(0)}
							</div>
							<div class="min-w-0 flex-1">
								<div class="flex flex-wrap items-start justify-between gap-2">
									<div>
										<p class="text-[10px] font-extrabold tracking-[0.16em] text-brand uppercase">{candidato.partido}</p>
										<h3 class="mt-1 font-serif text-xl leading-tight font-black">{candidato.nombre}</h3>
										{candidato.urna !== candidato.nombre && (
											<p class="mt-1 text-xs text-neutral-500">Nombre en urna: {candidato.urna}</p>
										)}
									</div>
								</div>

								<div class="mt-4 border-t border-neutral-200 pt-3">
									<p class="text-[10px] font-bold tracking-[0.14em] text-neutral-400 uppercase">Fórmula presidencial</p>
									<p class="mt-1 text-sm font-semibold text-neutral-800">
										{candidato.nombre}
										<span class="font-normal text-neutral-400"> / </span>
										{candidato.vice}
									</p>
									<p class="mt-0.5 text-xs text-neutral-500">
										Presidencia: {candidato.partido} · Vicepresidencia: {candidato.vicePartido}
									</p>
								</div>
							</div>
						</div>
					</article>
				))}
			</div>
		</section>

		<section class="mt-10 border-t-2 border-neutral-900 pt-6">
			<h2 class="font-serif text-2xl font-extrabold">Datos y resultados</h2>
			<p class="mt-2 max-w-3xl text-sm leading-relaxed text-neutral-600">
				Esta nómina se mantiene separada del módulo de resultados. Los porcentajes y votos se muestran únicamente
				en la página de escrutinio cuando existen datos electorales para representar.
			</p>
			<a href="/brasil-2026/resultados/"
				class="mt-4 inline-flex items-center border border-neutral-900 px-4 py-2.5 text-sm font-bold transition hover:bg-neutral-900 hover:text-white">
				Ir al módulo de resultados →
			</a>
		</section>

		<div class="mt-10 border border-neutral-300 bg-neutral-50 p-5 text-xs leading-relaxed text-neutral-500">
			<strong class="text-neutral-700">Criterio editorial:</strong>
			la información de candidaturas y fórmulas se presenta con base en fuentes oficiales del TSE. La inclusión en esta
			página no implica valoración, recomendación ni orden de preferencia.
		</div>
	</div>
</BaseLayout>

