---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import AdBanner from '../components/AdBanner.astro';
import InstalarApp from '../components/InstalarApp.astro';
import BarraInferior from '../components/BarraInferior.astro';
import '../styles/global.css';
import { GA_ID } from '../consts';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
	// Imagen propia de 1200x630 para las vistas previas en redes (/api/og/<slug>.jpg).
	ogImage?: string;
	publishedTime?: Date;
	author?: string;
	section?: string;
}

const { title, description, image, ogImage, publishedTime, author, section } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<!-- Preferencias del lector (letra y modo noche): se aplican antes de dibujar la página -->
		<script is:inline>
			try {
				var r = document.documentElement;
				var l = localStorage.getItem('df-letra'); if (l) r.setAttribute('data-letra', l);
				if (localStorage.getItem('df-noche') === '1') r.classList.add('modo-noche');
			} catch (e) {}
		</script>
		<BaseHead
			title={title}
			description={description}
			image={image}
			ogImage={ogImage}
			publishedTime={publishedTime}
			author={author}
			section={section}
		/>
		<!-- Tipografías de diario: Newsreader (titulares y texto, hecha para noticias) e Inter (interfaz). Gratuitas, Google Fonts. -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Newsreader:ital,opsz,wght@0,6..72,400..800;1,6..72,400..600&family=Roboto+Condensed:wght@700&display=swap" rel="stylesheet" />
		<!-- Vercel Web Analytics (contador de visitas) — no borrar -->
		<script is:inline>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>
		<script is:inline defer src="/_vercel/insights/script.js"></script>
		<!-- Contador privado de visitas (se ve solo en /admin/visitas). No cuenta el panel ni robots sin JavaScript. -->
		<script is:inline define:vars={{ temaVisita: section ?? '' }}>
			try {
				if (location.pathname.indexOf('/admin') !== 0 && !sessionStorage.getItem('pv:' + location.pathname)) {
					sessionStorage.setItem('pv:' + location.pathname, '1');
					var nuevo = !localStorage.getItem('df-lector');
					try { localStorage.setItem('df-lector', '1'); } catch (e) {}
					var utm = (new URLSearchParams(location.search).get('utm_source') || '').slice(0, 40);
					fetch('/api/visita', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ pagina: true, ruta: location.pathname, ref: document.referrer, utm: utm, nuevo: nuevo, tema: temaVisita }), keepalive: true }).catch(function () {});
				}
			} catch (e) {}
			// Tiempo de lectura (solo con la pestaña a la vista) y hasta dónde bajó el lector.
			try {
				if (location.pathname.indexOf('/admin') !== 0) {
					var visible = 0, desde = document.visibilityState === 'visible' ? Date.now() : 0, maxScroll = 0, enviado = false;
					var medir = function () {
						var alto = document.documentElement.scrollHeight - window.innerHeight;
						var pct = alto > 0 ? Math.round((window.scrollY / alto) * 100) : 100;
						if (pct > maxScroll) maxScroll = Math.min(100, pct);
					};
					window.addEventListener('scroll', medir, { passive: true });
					var enviar = function () {
						if (desde) { visible += Date.now() - desde; desde = 0; }
						if (enviado || visible < 1000) return;
						enviado = true;
						var datos = JSON.stringify({ lectura: true, ruta: location.pathname, segundos: Math.round(visible / 1000), scroll: maxScroll });
						if (navigator.sendBeacon) navigator.sendBeacon('/api/visita', new Blob([datos], { type: 'application/json' }));
						else fetch('/api/visita', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: datos, keepalive: true }).catch(function () {});
					};
					document.addEventListener('visibilitychange', function () {
						if (document.visibilityState === 'hidden') enviar();
						else if (!enviado && !desde) desde = Date.now();
					});
					window.addEventListener('pagehide', enviar);
				}
			} catch (e) {}
		</script>
		{GA_ID && (
			<>
				<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
				<script is:inline define:vars={{ GA_ID }}>
					window.dataLayer = window.dataLayer || [];
					function gtag(){dataLayer.push(arguments);}
					gtag('js', new Date());
					gtag('config', GA_ID);
				</script>
			</>
		)}
		<!-- App instalable: registra el service worker -->
		<script is:inline>
			if ('serviceWorker' in navigator) {
				window.addEventListener('load', function () {
					navigator.serviceWorker.register('/sw.js').catch(function () {});
				});
			}
		</script>
		<!-- Fotos: si la versión optimizada falla, se prueba una vez con la original -->
		<script is:inline>
			document.addEventListener('error', function (e) {
				var img = e.target;
				if (img && img.tagName === 'IMG' && img.dataset && img.dataset.fallbackSrc && !img.dataset.fallbackTried) {
					img.dataset.fallbackTried = '1';
					img.src = img.dataset.fallbackSrc;
				}
			}, true);
		</script>
	</head>
	<body class="flex min-h-screen flex-col font-sans text-neutral-900 antialiased">
		<Header />
		<AdBanner position="header" maxAds={1} />
		<main class="mx-auto w-full min-w-0 max-w-6xl flex-1 px-4 pt-8">
			<slot />
		</main>
		<AdBanner position="footer" maxAds={2} />
		<Footer />
		<InstalarApp />
		<BarraInferior />
	</body>
</html>
