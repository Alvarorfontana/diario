{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diariofederal.com.ar/schemas/agenda-item.schema.json",
  "title": "Diario Federal Editorial Agenda Item",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "question", "status", "priority", "created_at", "signals"],
  "properties": {
    "id": {"type": "string", "minLength": 6},
    "title": {"type": "string", "minLength": 5, "maxLength": 220},
    "question": {"type": "string", "minLength": 10},
    "format": {"enum": ["news", "follow_up", "investigation", "explainer", "interview", "data", "territorial"]},
    "section": {"type": "string"},
    "territories": {"type": "array", "items": {"type": "string"}},
    "sectors": {"type": "array", "items": {"type": "string"}},
    "summary": {"type": "string"},
    "confirmed_facts": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "editorial_angle": {"type": "string"},
    "why_it_matters": {"type": "string"},
    "sources_to_contact": {"type": "array", "items": {"type": "string"}},
    "documents_needed": {"type": "array", "items": {"type": "string"}},
    "risk_notes": {"type": "array", "items": {"type": "string"}},
    "priority": {"enum": ["urgent", "high", "medium", "low"]},
    "score": {"type": "object", "properties": {"impact": {"type": "integer", "minimum": 0, "maximum": 5}, "novelty": {"type": "integer", "minimum": 0, "maximum": 5}, "reach": {"type": "integer", "minimum": 0, "maximum": 5}, "consequences": {"type": "integer", "minimum": 0, "maximum": 5}, "originality": {"type": "integer", "minimum": 0, "maximum": 5}, "urgency": {"type": "integer", "minimum": 0, "maximum": 5}}, "additionalProperties": false},
    "status": {"enum": ["proposal", "under_review", "approved_for_research", "researching", "fact_check", "writing", "editing", "pending_editor", "approved", "published", "monitoring", "discarded"]},
    "signals": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["title", "url"], "properties": {"title": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "publisher": {"type": "string"}, "published_at": {"type": "string"}, "event_at": {"type": "string"}, "source_type": {"enum": ["primary", "secondary", "social", "document", "data", "other"]}, "verification": {"enum": ["confirmed", "partial", "unverified", "contradicted"]}}, "additionalProperties": false}},
    "next_action": {"type": "string"},
    "owner": {"type": "string"},
    "deadline": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
